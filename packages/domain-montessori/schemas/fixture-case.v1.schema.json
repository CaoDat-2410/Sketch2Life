{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sketch2life.local/schemas/montessori/fixture-case.v1.schema.json",
  "title": "Montessori deterministic fixture case v1",
  "type": "object",
  "required": ["id", "description", "input", "expected", "coverage_tags"],
  "properties": {
    "id": {"type": "string", "pattern": "^CASE_[A-Z0-9_]+$"},
    "description": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "required": ["age_months", "readiness_tags", "completed_activity_ids", "available_material_ids", "supervision_level", "policy_flags", "candidate_activity_ids"],
      "properties": {
        "age_months": {"type": "integer", "minimum": 0, "maximum": 155},
        "readiness_tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "completed_activity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "available_material_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "supervision_level": {"enum": ["NONE", "NEARBY", "DIRECT"]},
        "policy_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "candidate_activity_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "expected": {
      "type": "object",
      "required": ["status", "allowed_activity_ids", "blocked"],
      "properties": {
        "status": {"enum": ["VALID_CANDIDATES", "NO_VALID_ACTIVITY"]},
        "allowed_activity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blocked": {"type": "object"}
      },
      "additionalProperties": false
    },
    "coverage_tags": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  },
  "additionalProperties": false
}
