FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODAL_ENVIRONMENT=dev

RUN pip install --no-cache-dir "modal==1.6.3"
WORKDIR /opt/sketch2life-modal-health
COPY deployment/modal/srs_v23/docker_health_lifecycle.py ./docker_health_lifecycle.py
COPY deployment/modal/srs_v23/workloads.json ./workloads.json
COPY deployment/modal/srs_v23/contracts.py ./contracts.py

CMD ["python", "docker_health_lifecycle.py"]
