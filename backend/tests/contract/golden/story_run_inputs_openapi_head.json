         {
          "$ref": "#/components/schemas/ParentStoryRunLifecycleEnvelopeV1"
         }
        ],
        "title": "Response Attach Parent Run Asset V1 Story Runs  Run Id  Assets Post"
       }
      }
     },
     "description": "Drawing attached and queued for analysis, or the lifecycle projection on a replay of a purged run"
    },
    "400": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The request or the idempotency key is invalid (`INVALID_REQUEST`, `INVALID_IDEMPOTENCY_KEY`)"
    },
    "401": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "Authentication is required"
    },
    "404": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The run or the asset was not found, or the caller is not its active Parent owner"
    },
    "409": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The run state or revision does not allow this drawing (`INVALID_STATE_TRANSITION`, `STALE_REVISION` with `current_version`)"
    },
    "413": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The image is too large (`MEDIA_TOO_LARGE`)"
    },
    "415": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The asset is not a drawing image (`UNSUPPORTED_MEDIA_TYPE`)"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The image failed validation (`IMAGE_DIMENSIONS_EXCEEDED`, `UPLOAD_INCOMPLETE`, `UPLOAD_CHECKSUM_MISMATCH`, `UPLOAD_CONTENT_MISMATCH`)"
    },
    "500": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "An unexpected error occurred"
    },
    "503": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "A required service is unavailable (`STORAGE_UNAVAILABLE`)"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Attach a completed artwork upload to the Parent StoryRun as its drawing",
   "tags": [
    "Parent StoryRuns"
   ]
  },
