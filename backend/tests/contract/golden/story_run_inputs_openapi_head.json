{
 "operations": {
  "get /v1/story-runs/{run_id}/transcript": {
   "description": "Read the current transcript of the Parent StoryRun's voice idea; the text is returned only to the run owner and is never cached.",
   "operationId": "get_parent_run_transcript_v1_story_runs__run_id__transcript_get",
   "parameters": [
    {
     "in": "path",
     "name": "run_id",
     "required": true,
     "schema": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentRunTranscriptV1"
       }
      }
     },
     "description": "The current transcript, or state `NONE` when the run has no voice idea"
    },
    "400": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The request or the idempotency key is invalid (`INVALID_REQUEST` with `field_errors` when the text is too long, `INVALID_IDEMPOTENCY_KEY`)"
    },
    "401": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "Authentication is required"
    },
    "404": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The run was not found, or the caller is not its active Parent owner"
    },
    "409": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "The run state or the transcript revision does not allow this (`INVALID_STATE_TRANSITION`, `STALE_REVISION` with `current_version`)"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "Validation uses the standard error envelope"
    },
    "500": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "An unexpected error occurred"
    },
    "503": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryErrorEnvelopeV1"
       }
      }
     },
     "description": "A required service is unavailable"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Read the current transcript of the Parent run's voice idea",
   "tags": [
    "Parent StoryRuns"
   ]
  },
  "post /v1/story-runs/{run_id}/assets": {
   "description": "Attach a completed artwork upload to the Parent StoryRun as its drawing; the normalized copy is made here and the visual analysis runs after the response.",
