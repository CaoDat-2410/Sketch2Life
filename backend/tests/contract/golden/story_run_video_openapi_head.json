{
 "operations": {
  "get /v1/story-runs/{run_id}/playback": {
   "description": "Stream the ready video of the Parent StoryRun to the verified owner who presents a valid playback token. Ownership, run state and generation are rechecked on every request. One `Range` is honoured; there is no download, export, listing or storage location.",
   "operationId": "stream_parent_playback_v1_story_runs__run_id__playback_get",
   "parameters": [
    {
     "in": "path",
     "name": "run_id",
     "required": true,
     "schema": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
     }
    },
    {
     "in": "header",
     "name": "X-Playback-Token",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "X-Playback-Token"
     }
    },
    {
     "in": "header",
     "name": "Range",
     "required": false,
     "schema": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Range"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "video/mp4": {
       "schema": {
        "format": "binary",
        "type": "string"
       }
      }
     },
     "description": "The whole video, streamed."
    },
    "206": {
     "content": {
      "video/mp4": {
       "schema": {
        "format": "binary",
        "type": "string"
       }
      }
     },
     "description": "One byte range of the video."
    },
    "401": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Authentication is required, or the playback token is invalid (`INVALID_TOKEN`) or expired (`TOKEN_EXPIRED`)"
    },
    "404": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run was not found, or the caller is not its active Parent owner; also the answer to a token that no longer grants anything (the run was cancelled, deleted, completed, closed or the video was hidden)"
    },
    "416": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The requested byte range cannot be served (`RANGE_NOT_SATISFIABLE`)"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Validation uses the standard error envelope"
    },
    "500": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "An unexpected error occurred"
    },
    "503": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Playback or the object store is unavailable (`PROVIDER_UNAVAILABLE`, `STORAGE_UNAVAILABLE`)"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Stream the ready video of the Parent StoryRun to the playback token holder",
   "tags": [
    "Parent StoryRuns"
   ]
  },
  "post /v1/story-runs/{run_id}/complete": {
   "description": "Complete the Parent StoryRun at `VIDEO_READY`: the run ends as `COMPLETED`, the active-run lock is released and the content stays until the user deletes the run. This is not a video approval.",
   "operationId": "complete_parent_story_run_v1_story_runs__run_id__complete_post",
   "parameters": [
    {
     "in": "path",
     "name": "run_id",
     "required": true,
     "schema": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
     }
    },
    {
     "in": "header",
     "name": "Idempotency-Key",
     "required": true,
     "schema": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency-Key",
      "type": "string"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "examples": {
       "syntheticRequest": {
        "description": "Schema-shaped sample with fictional values. Replace example IDs and references with records valid in your environment; protected routes also require a real bearer token. This is not seeded test data.",
        "summary": "Request example",
        "value": {
         "expected_revision": 1
        }
       }
      },
      "schema": {
       "$ref": "#/components/schemas/ParentStoryRunCompleteRequestV1"
      }
     }
    },
    "required": true
   },
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "anyOf": [
         {
          "$ref": "#/components/schemas/ParentStoryRunEnvelopeV1"
         },
         {
          "$ref": "#/components/schemas/ParentStoryRunLifecycleEnvelopeV1"
         }
        ],
        "title": "Response Complete Parent Story Run V1 Story Runs  Run Id  Complete Post"
       }
      }
     },
     "description": "The run in `COMPLETED` (the lifecycle projection on a replay of a run that is already being deleted)"
    },
    "400": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The request or the idempotency key is invalid (`INVALID_REQUEST`, `INVALID_IDEMPOTENCY_KEY`)"
    },
    "401": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Authentication is required"
    },
    "404": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run was not found, or the caller is not its active Parent owner"
    },
    "409": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run is not at `VIDEO_READY` (`INVALID_STATE_TRANSITION`), the run revision or the generation is stale (`STALE_REVISION` with `current_version`), or, for `video-unsuitable`, the regeneration limit was reached (`VIDEO_REGENERATION_LIMIT_REACHED`; the video stays)"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Validation uses the standard error envelope"
    },
    "500": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "An unexpected error occurred"
    },
    "503": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "A required service is unavailable"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Complete the Parent StoryRun at VIDEO_READY and release the active lock",
   "tags": [
    "Parent StoryRuns"
   ]
  },
  "post /v1/story-runs/{run_id}/playback-token": {
   "description": "Issue a short-lived playback grant for the ready video of the Parent StoryRun: one video, the verified owner, a few minutes. No body and no idempotency key (a grant, not a state change). The token is sent only in the `X-Playback-Token` header of the stream route; the response carries no storage location.",
   "operationId": "issue_parent_playback_token_v1_story_runs__run_id__playback_token_post",
   "parameters": [
    {
     "in": "path",
     "name": "run_id",
     "required": true,
     "schema": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
     }
    }
   ],
   "responses": {
    "200": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentPlaybackTokenResponseV1"
       }
      }
     },
     "description": "The grant: a token, its expiry, the stream path and an opaque asset handle"
    },
    "401": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Authentication is required, or the playback token is invalid (`INVALID_TOKEN`) or expired (`TOKEN_EXPIRED`)"
    },
    "404": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run was not found, or the caller is not its active Parent owner; also the answer to a token that no longer grants anything (the run was cancelled, deleted, completed, closed or the video was hidden)"
    },
    "409": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run has no video that can be played now (`INVALID_STATE_TRANSITION`)"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Validation uses the standard error envelope"
    },
    "500": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "An unexpected error occurred"
    },
    "503": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Playback or the object store is unavailable (`PROVIDER_UNAVAILABLE`, `STORAGE_UNAVAILABLE`)"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Issue a short-lived playback grant for the ready video of the Parent StoryRun",
   "tags": [
    "Parent StoryRuns"
   ]
  },
  "post /v1/story-runs/{run_id}/video-generations": {
   "description": "Ask for a video of the confirmed script of the Parent StoryRun; the request is stored as an intent first and becomes accepted only after the compute reservation and the quota admission are both confirmed.",
   "operationId": "create_parent_video_generation_v1_story_runs__run_id__video_generations_post",
   "parameters": [
    {
     "in": "path",
     "name": "run_id",
     "required": true,
     "schema": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
     }
    },
    {
     "in": "header",
     "name": "Idempotency-Key",
     "required": true,
     "schema": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency-Key",
      "type": "string"
     }
    }
   ],
   "requestBody": {
    "content": {
     "application/json": {
      "examples": {
       "syntheticRequest": {
        "description": "Schema-shaped sample with fictional values. Replace example IDs and references with records valid in your environment; protected routes also require a real bearer token. This is not seeded test data.",
        "summary": "Request example",
        "value": {
         "expected_revision": 1,
         "story_sha256": "example-value"
        }
       }
      },
      "schema": {
       "$ref": "#/components/schemas/ParentVideoGenerationRequestV1"
      }
     }
    },
    "required": true
   },
   "responses": {
    "202": {
     "content": {
      "application/json": {
       "schema": {
        "anyOf": [
         {
          "$ref": "#/components/schemas/ParentVideoGenerationAcceptedV1"
         },
         {
          "$ref": "#/components/schemas/ParentStoryRunLifecycleEnvelopeV1"
         }
        ],
        "title": "Response Create Parent Video Generation V1 Story Runs  Run Id  Video Generations Post"
       }
      }
     },
     "description": "The intent reference and its state (`ADMISSION_PENDING` until both receipts are clear, `ACCEPTED` with a `job_id` once they are), or the lifecycle projection on a replay of a purged run"
    },
    "400": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The request or the idempotency key is invalid (`INVALID_REQUEST` with `field_errors` for the quality reason, `INVALID_IDEMPOTENCY_KEY`)"
    },
    "401": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "Authentication is required"
    },
    "404": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run was not found, or the caller is not its active Parent owner"
    },
    "409": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The run state, the revision or the script does not allow a video request (`INVALID_STATE_TRANSITION`, `STALE_REVISION` with `current_version`), the regeneration limit was reached (`VIDEO_REGENERATION_LIMIT_REACHED`), or the quota or the subscription refused it (`VIDEO_QUOTA_EXCEEDED`, `SUBSCRIPTION_RESTRICTED`)"
    },
    "422": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The subject or the context of the run was not confirmed (`SUBJECT_NOT_CONFIRMED`, `PROFILE_CONTEXT_NOT_CONFIRMED`)"
    },
    "500": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "An unexpected error occurred"
    },
    "503": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ParentStoryCancelErrorEnvelopeV1"
       }
      }
     },
     "description": "The compute budget refused the request (`AI_COST_LIMIT_REACHED`) or the admission service is not available (`PROVIDER_UNAVAILABLE`)"
    }
   },
   "security": [
    {
     "HTTPBearer": []
    }
   ],
   "summary": "Ask for a video of the confirmed script of a Parent StoryRun",
   "tags": [
    "Parent StoryRuns"
   ]
  },
  "post /v1/story-runs/{run_id}/video-unsuitable": {
   "description": "Mark the current ready video of the Parent StoryRun unsuitable with a safe reason; the rejected video is no longer playable and the run returns to the script review.",
   "operationId": "mark_parent_video_unsuitable_v1_story_runs__run_id__video_unsuitable_post",
   "parameters": [
    {
     "in": "path",
     "name": "run_id",
     "required": true,
     "schema": {
      "format": "uuid",
      "title": "Run Id",
      "type": "string"
     }
    },
    {
     "in": "header",
     "name": "Idempotency-Key",
     "required": true,
     "schema": {
      "maxLength": 128,
      "minLength": 1,
