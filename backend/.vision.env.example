# Copy to backend/.vision.env and replace placeholders locally; never commit that file.
# Set either an immutable local model snapshot or a local cache directory at runtime.
SKETCH2LIFE_VISION_MODEL_DIR=<set-locally>
SKETCH2LIFE_VISION_MODEL_CACHE_DIR=<set-locally>
SKETCH2LIFE_VISION_DEVICE=cuda
SKETCH2LIFE_VISION_DEVICE_INDEX=0
SKETCH2LIFE_VISION_ALLOW_MODEL_DOWNLOAD=false

# Optional SAM 2.1 Hiera Small worker; keep disabled until the L4 smoke benchmark passes.
SKETCH2LIFE_SAM21_CHECKPOINT=<set-locally>
SKETCH2LIFE_SAM21_MODEL_CONFIG=configs/sam2.1/sam2.1_hiera_s.yaml
SKETCH2LIFE_SAM21_DEVICE=cuda
