# Local-only standalone faster-whisper runtime. This is intentionally separate from .env:
# shared application Settings must never parse local ASR model/runtime configuration.
# Copy to ignored backend/.asr.env and fill actual paths there. Do not commit that file.
SKETCH2LIFE_ASR_MODEL_DIR=
SKETCH2LIFE_ASR_NATIVE_LIBRARY_DIR=
# Optional cache location for the approved Phase B provider/runtime execution.
SKETCH2LIFE_ASR_MODEL_CACHE_DIR=
