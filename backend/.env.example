SKETCH2LIFE_ENV=local
SKETCH2LIFE_API_HOST=127.0.0.1
SKETCH2LIFE_API_PORT=8000
SKETCH2LIFE_LOG_LEVEL=INFO
# Configure locally through an ignored .env or runtime secret manager.
SKETCH2LIFE_DATABASE_URL=
# Local host-run backend: use http://localhost:9000. Docker Compose overrides this to http://minio:9000.
SKETCH2LIFE_S3_ENDPOINT=http://localhost:9000
SKETCH2LIFE_S3_REGION=us-east-1
SKETCH2LIFE_S3_BUCKET=sketch2life-private
SKETCH2LIFE_S3_ACCESS_KEY=local-minio-user
SKETCH2LIFE_S3_SECRET_KEY=change-this-local-minio-secret
# Keep off for host-run API unless it is bound to loopback. Docker Compose has its own local override.
SKETCH2LIFE_STORAGE_EXAMPLE_ENABLED=false
SKETCH2LIFE_STORAGE_EXAMPLE_MAX_UPLOAD_BYTES=10485760
# Host-run API expects a local ClamAV daemon; Compose overrides this with the service name.
SKETCH2LIFE_CLAMAV_HOST=localhost
SKETCH2LIFE_CLAMAV_PORT=3310
# Optional comma-separated verified Firebase UIDs for Platform Admin moderation.
SKETCH2LIFE_PLATFORM_ADMIN_SUBJECTS=
# Required only to enable the shared six-digit room-code API. Supply a random secret of at least
# 32 bytes through an ignored local .env or runtime secret manager; never commit a real value.
SKETCH2LIFE_ROOM_CODE_HMAC_KEY=
# The versioned BE1 API requires Firebase Authentication at request time. Configure
# the project and runtime credentials in an ignored .env or secret manager.
SKETCH2LIFE_AUTH_PROVIDER=development
SKETCH2LIFE_FIREBASE_PROJECT_ID=
SKETCH2LIFE_FIREBASE_CREDENTIALS_FILE=
SKETCH2LIFE_BE1_ARTIFACT_ROOT=.runtime/be1-artifacts
SKETCH2LIFE_AI_PROVIDER=disabled
SKETCH2LIFE_LIGHTNING_AI_BASE_URL=https://your-lightning-endpoint.example
SKETCH2LIFE_LIGHTNING_AI_TOKEN_FILE=./.secrets/lightning.token
SKETCH2LIFE_LIGHTNING_MODEL_PROFILE=live-p2-understanding-v1
SKETCH2LIFE_LIGHTNING_ASR_PROFILE=WHISPER_TURBO_FP16_AUTO_V1
SKETCH2LIFE_LIGHTNING_ASR_PATH=/v1/asr
SKETCH2LIFE_LIGHTNING_VISION_V2_PATH=/v2/vision
SKETCH2LIFE_PIXI_SPRITE_CYCLE_DEV_PREVIEW_ENABLED=false
SKETCH2LIFE_LIGHTNING_WHITEBOARD_LOCALIZATION_PATH=/v1/whiteboard/localize
SKETCH2LIFE_LIGHTNING_WHITEBOARD_SEGMENTATION_PATH=/v1/whiteboard/segment
SKETCH2LIFE_WHITEBOARD_VIDEO_ENABLED=false
SKETCH2LIFE_WHITEBOARD_VIDEO_AUTO_RUN=false
SKETCH2LIFE_WHITEBOARD_VIDEO_ARTIFACT_ROOT=.runtime/whiteboard
SKETCH2LIFE_WHITEBOARD_VIDEO_MAX_SIZE_BYTES=12582912
SKETCH2LIFE_WHITEBOARD_LEARNING_THREAD_FIXTURE=./fixtures/whiteboard_learning_threads.json
SKETCH2LIFE_WHITEBOARD_TTS_EXECUTABLE=espeak-ng
SKETCH2LIFE_WHITEBOARD_FFMPEG_EXECUTABLE=ffmpeg
