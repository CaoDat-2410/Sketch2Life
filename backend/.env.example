SKETCH2LIFE_ENV=local
SKETCH2LIFE_API_HOST=0.0.0.0
SKETCH2LIFE_API_PORT=8000
SKETCH2LIFE_LOG_LEVEL=INFO
SKETCH2LIFE_AI_PROVIDER=disabled
SKETCH2LIFE_LIGHTNING_AI_BASE_URL=https://your-lightning-endpoint.example
SKETCH2LIFE_LIGHTNING_AI_TOKEN_FILE=./.secrets/lightning.token
SKETCH2LIFE_LIGHTNING_MODEL_PROFILE=live-p2-understanding-v1
SKETCH2LIFE_LIGHTNING_ASR_PROFILE=WHISPER_TURBO_FP16_AUTO_V1
SKETCH2LIFE_LIGHTNING_ASR_PATH=/v1/asr
SKETCH2LIFE_LIGHTNING_VISION_V2_PATH=/v2/vision
SKETCH2LIFE_LIGHTNING_WHITEBOARD_LOCALIZATION_PATH=/v1/whiteboard/localize
SKETCH2LIFE_WHITEBOARD_VIDEO_ENABLED=false
SKETCH2LIFE_WHITEBOARD_VIDEO_AUTO_RUN=false
SKETCH2LIFE_WHITEBOARD_VIDEO_ARTIFACT_ROOT=.runtime/whiteboard
SKETCH2LIFE_WHITEBOARD_VIDEO_MAX_SIZE_BYTES=12582912
