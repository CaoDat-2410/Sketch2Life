SKETCH2LIFE_ENV=local
SKETCH2LIFE_API_PORT=8000
SKETCH2LIFE_POSTGRES_DB=sketch2life
SKETCH2LIFE_POSTGRES_USER=sketch2life
SKETCH2LIFE_POSTGRES_PASSWORD=change-me
# Compose assembles the API's internal PostgreSQL URL from the values above.
# Use a URL-safe local password or URL-encode reserved characters if you change it.
SKETCH2LIFE_REDIS_URL=redis://localhost:6379/0
# Docker Compose backend-to-MinIO endpoint. For host-run backend use http://localhost:9000.
SKETCH2LIFE_S3_ENDPOINT=http://minio:9000
SKETCH2LIFE_S3_REGION=us-east-1
SKETCH2LIFE_S3_BUCKET=sketch2life-private
SKETCH2LIFE_S3_ACCESS_KEY=local-minio-user
SKETCH2LIFE_S3_SECRET_KEY=change-this-local-minio-secret
SKETCH2LIFE_STORAGE_EXAMPLE_ENABLED=true
SKETCH2LIFE_STORAGE_EXAMPLE_MAX_UPLOAD_BYTES=10485760
# Optional comma-separated verified Firebase UIDs authorized for platform moderation.
SKETCH2LIFE_PLATFORM_ADMIN_SUBJECTS=

# Firebase Authentication only. Product storage remains S3-compatible.
SKETCH2LIFE_AUTH_PROVIDER=development
SKETCH2LIFE_FIREBASE_PROJECT_ID=
SKETCH2LIFE_FIREBASE_CREDENTIALS_FILE=
SKETCH2LIFE_FIREBASE_CHECK_REVOKED_TOKENS=true

# Backend-only AI providers. Never expose these to React Native.
SKETCH2LIFE_AI_PROVIDER=disabled
SKETCH2LIFE_LIGHTNING_AI_BASE_URL=
SKETCH2LIFE_LIGHTNING_AI_TOKEN_FILE=
SKETCH2LIFE_RUNPOD_ENDPOINT_ID=
SKETCH2LIFE_RUNPOD_API_KEY_FILE=
SKETCH2LIFE_AI_CONNECT_TIMEOUT_SECONDS=5
SKETCH2LIFE_AI_REQUEST_TIMEOUT_SECONDS=120
# Optional backend-only SAM 2.1 Hiera Small worker. Keep disabled until the L4 benchmark
# and checkpoint/config paths are verified in the Lightning environment.
SKETCH2LIFE_LIGHTNING_SAM21_ENABLED=false
SKETCH2LIFE_LIGHTNING_SAM21_PATH=/v2/rig/segment
