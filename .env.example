SKETCH2LIFE_ENV=local
SKETCH2LIFE_API_PORT=8000
# Parent Android emulator reaches the host through 10.0.2.2; use the host LAN URL for a physical device.
SKETCH2LIFE_MOBILE_API_BASE_URL=http://10.0.2.2:8000
SKETCH2LIFE_POSTGRES_DB=sketch2life
SKETCH2LIFE_POSTGRES_USER=sketch2life
SKETCH2LIFE_POSTGRES_PASSWORD=change-me
# Compose assembles the API's internal PostgreSQL URL from the values above.
# Use a URL-safe local password or URL-encode reserved characters if you change it.
SKETCH2LIFE_REDIS_URL=redis://localhost:6379/0
# Docker Compose backend-to-MinIO endpoint. For host-run backend use http://localhost:9000.
SKETCH2LIFE_S3_ENDPOINT=http://minio:9000
SKETCH2LIFE_S3_REGION=us-east-1
SKETCH2LIFE_S3_BUCKET=sketch2life-private
SKETCH2LIFE_S3_ACCESS_KEY=local-minio-user
SKETCH2LIFE_S3_SECRET_KEY=change-this-local-minio-secret
SKETCH2LIFE_STORAGE_EXAMPLE_ENABLED=true
SKETCH2LIFE_STORAGE_EXAMPLE_MAX_UPLOAD_BYTES=10485760
# One-time bootstrap identity for the first Platform Admin. Set this email in the root .env,
# then run the documented backend bootstrap command; do not store a password here.
SKETCH2LIFE_PLATFORM_ADMIN_BOOTSTRAP_EMAIL=

# Firebase Authentication only. Product storage remains S3-compatible.
SKETCH2LIFE_AUTH_PROVIDER=development
SKETCH2LIFE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Base64-encoded Firebase Admin service-account JSON; backend only. Leave blank until configured.
SKETCH2LIFE_FIREBASE_ADMIN_JSON_BASE64=
SKETCH2LIFE_FIREBASE_CHECK_REVOKED_TOKENS=true

# Public Firebase Authentication client config shared by Teacher Web and Parent Android.
# These values are public client settings, not Admin credentials.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_BE1_BASE_URL=http://localhost:8000
VITE_BE1_ORGANIZATION_ID=your-school-organization-id
SKETCH2LIFE_MOBILE_API_BASE_URL=http://10.0.2.2:8000

# Backend-only AI providers. Never expose these to React Native.
SKETCH2LIFE_AI_PROVIDER=disabled
# Local/test only; use synthetic profiles and Modal dev for the silent LTX technical candidate.
SKETCH2LIFE_SYNTHETIC_PILOT_ENABLED=false
SKETCH2LIFE_PARENT_VIDEO_DEV_CANDIDATE_ENABLED=false
# Enables Qwen fallback for a Parent-entered topic/subject only when the provider is modal_dev.
SKETCH2LIFE_PARENT_TOPIC_SUBJECT_AI_ENABLED=false
# For a local Modal dev run, set SKETCH2LIFE_AI_PROVIDER=modal_dev.
# Modal credentials are backend-only; never copy them into mobile/web VITE or public bundles.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
SKETCH2LIFE_LIGHTNING_AI_BASE_URL=
SKETCH2LIFE_LIGHTNING_AI_TOKEN_FILE=
SKETCH2LIFE_RUNPOD_ENDPOINT_ID=
SKETCH2LIFE_RUNPOD_API_KEY_FILE=
SKETCH2LIFE_AI_CONNECT_TIMEOUT_SECONDS=5
SKETCH2LIFE_AI_REQUEST_TIMEOUT_SECONDS=120
# Optional backend-only SAM 2.1 Hiera Small worker. Keep disabled until the L4 benchmark
# and checkpoint/config paths are verified in the Lightning environment.
SKETCH2LIFE_LIGHTNING_SAM21_ENABLED=false
SKETCH2LIFE_LIGHTNING_SAM21_PATH=/v2/rig/segment

# Admin local acceptance only. Real payment processing is not enabled by this flag.
SKETCH2LIFE_BILLING_SANDBOX_ENABLED=false
# Provider credentials belong in the ignored root .env or secret manager, never in source control.
# Keep real checkout disabled until callback URLs and merchant sandbox credentials are validated.
SKETCH2LIFE_BILLING_REAL_PAYMENTS_ENABLED=false
SKETCH2LIFE_MOMO_PARTNER_CODE=
SKETCH2LIFE_MOMO_ACCESS_KEY=
SKETCH2LIFE_MOMO_SECRET_KEY=
SKETCH2LIFE_MOMO_PARTNER_NAME=Sketch2Life
SKETCH2LIFE_MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
SKETCH2LIFE_MOMO_RETURN_URL=
SKETCH2LIFE_MOMO_IPN_URL=
SKETCH2LIFE_VNPAY_TMN_CODE=
SKETCH2LIFE_VNPAY_HASH_SECRET=
SKETCH2LIFE_VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
SKETCH2LIFE_VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Replace with the server's public egress IP for a deployed merchant integration.
SKETCH2LIFE_VNPAY_SERVER_IP=
SKETCH2LIFE_VNPAY_RETURN_URL=
SKETCH2LIFE_VNPAY_IPN_URL=
SKETCH2LIFE_BILLING_PROVIDER_TIMEOUT_SECONDS=35
# Configure your SMTP provider, then run the Compose email profile.
SKETCH2LIFE_SMTP_HOST=
SKETCH2LIFE_SMTP_PORT=587
SKETCH2LIFE_SMTP_FROM=Sketch2Life <sender@example.com>
SKETCH2LIFE_SMTP_STARTTLS=true
SKETCH2LIFE_SMTP_USERNAME=
SKETCH2LIFE_SMTP_PASSWORD=
SKETCH2LIFE_WEB_ALLOWED_HOSTS=
