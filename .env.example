SKETCH2LIFE_ENV=local
SKETCH2LIFE_API_PORT=8000
SKETCH2LIFE_POSTGRES_DB=sketch2life
SKETCH2LIFE_POSTGRES_USER=sketch2life
SKETCH2LIFE_POSTGRES_PASSWORD=change-me
SKETCH2LIFE_REDIS_URL=redis://localhost:6379/0
SKETCH2LIFE_S3_ENDPOINT=http://localhost:9000
SKETCH2LIFE_S3_ACCESS_KEY=minioadmin
SKETCH2LIFE_S3_SECRET_KEY=change-me

# Firebase Authentication only. Product storage remains S3-compatible.
SKETCH2LIFE_AUTH_PROVIDER=development
SKETCH2LIFE_FIREBASE_PROJECT_ID=
SKETCH2LIFE_FIREBASE_CREDENTIALS_FILE=
SKETCH2LIFE_FIREBASE_CHECK_REVOKED_TOKENS=true

# Backend-only AI providers. Never expose these to React Native.
SKETCH2LIFE_AI_PROVIDER=disabled
SKETCH2LIFE_LIGHTNING_AI_BASE_URL=
SKETCH2LIFE_LIGHTNING_AI_TOKEN_FILE=
SKETCH2LIFE_RUNPOD_ENDPOINT_ID=
SKETCH2LIFE_RUNPOD_API_KEY_FILE=
SKETCH2LIFE_AI_CONNECT_TIMEOUT_SECONDS=5
SKETCH2LIFE_AI_REQUEST_TIMEOUT_SECONDS=120
