        <mxCell id="note-778" value="Trước Start: kiểm lại lớp, roster, tuổi, consent và capacity. QR không phải đăng nhập riêng của trẻ." style="html=1;whiteSpace=wrap;overflow=hidden;strokeColor=#CBA969;fillColor=#FFF3DF;fontColor=#243746;fontFamily=Arial;fontSize=12;align=center;verticalAlign=middle;spacing=4;shadow=0;shape=note;size=16;align=left;spacingLeft=14;spacingRight=12;" vertex="1" parent="1">
