    subgraph BACKEND["Sketch2Life backend · logical view · deployment TBD"]
        API["FastAPI / Python<br/>REST commands / queries<br/>confirmed"]
        APP["Application<br/>Use cases · authorization<br/>Scope / version checks"]
        DOMAIN["Domain contexts · proposed<br/>Identity / Consent · Classroom<br/>Session / Groups · Drawing / Collaboration<br/>AI Assistance · Knowledge / Media<br/>Activities · Portfolio / Assessment<br/>Governance / Audit"]
        PORTS["Application ports<br/>Repository · Artifact · Job<br/>Identity · Realtime / presence · Model"]
        ADAPTERS["Backend adapters<br/>Persistence · Artifact storage · Job / queue — candidate<br/>Adult identity — TBD<br/>Realtime / presence — proposed<br/>AI provider — proposed · backend only"]
        WORKER["Async worker<br/>Separate process · proposed<br/>Bounded jobs"]
    end

    subgraph EXTERNAL["External services"]
        POSTGRES["PostgreSQL<br/>candidate"]
        OBJECT_STORE["S3-compatible object storage<br/>candidate"]
        QUEUE["Redis / RQ queue<br/>candidate"]
        AUTH["Firebase Authentication<br/>Adults only · integration TBD"]
        AI_PROVIDER["AI provider<br/>Provider / payload TBD"]
    end

    CHILD_APP -->|REST| API
    TEACHER_UI -->|REST| API
    ADMIN_UI -->|REST| API
    API -->|request| APP
    APP -->|rules| DOMAIN
