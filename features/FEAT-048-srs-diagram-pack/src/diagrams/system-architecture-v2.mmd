%% Sketch2Life Master SRS v3.1 — System Architecture v2, Draw.io page 4.
%% This is a logical architecture with candidate deployment components, not an AWS deployment decision.
%% Confirmed: Android / React Native / TypeScript; FastAPI / Python; Child, Teacher, Super Admin surfaces.
%% Candidate: PostgreSQL, Redis/RQ, S3-compatible object storage. Proposed: WebSocket and server-authoritative ordered canvas operations/checkpoints.
%% Firebase Authentication is the only permitted Firebase boundary; the adult-identity adapter is not implemented. AI provider and payload remain TBD.
%% Drawing rules and status/connector semantics: ../../ARCHITECTURE_DRAWING_RULES.md
%% Draw.io page 4 embeds Lucide 1.61.0 SVGs; icon names map to major roles only and do not encode status.
%% Mapping: user-round=actors; smartphone=Android client; monitor=Teacher/Super Admin surfaces; server=FastAPI; list-checks=Application; layers=Domain groupings; plug=outbound ports.
%% database=PostgreSQL; hard-drive=object storage; list-ordered=Redis/RQ; cpu=worker; shield-check=adult identity; sparkles=AI provider; radio-tower=WebSocket; package=artifact adapter; workflow=async flow.

flowchart LR
    subgraph CLIENTS["People and client surfaces"]
        CHILD((Child)) --> CHILD_APP["Android app<br/>React Native / TypeScript — CONFIRMED"]
        TEACHER((Teacher)) --> TEACHER_UI["Teacher Desktop surface — CONFIRMED<br/>UI framework — TBD"]
        ADMIN((Super Admin)) --> ADMIN_UI["Super Admin surface — CONFIRMED<br/>UI framework — TBD"]
    end

    subgraph BACKEND["Sketch2Life backend — logical boundary; deployment topology TBD"]
        API["FastAPI / Python<br/>CONFIRMED"]
        APP["Application services<br/>authorization and use cases"]

        subgraph DOMAIN["Framework-independent domain — B8 context groupings proposed"]
            IDENTITY["Identity / Consent"]
            CLASSROOM["Classroom"]
            SESSION["Session / Groups"]
            DRAWING["Drawing / Collaboration<br/>ordered operations + checkpoints proposed; CRDT not selected"]
            AI["AI Assistance"]
            KNOWLEDGE["Knowledge / Media"]
            ACTIVITIES["Activities"]
            PORTFOLIO["Portfolio / Assessment"]
            GOVERNANCE["Governance / Audit"]
        end

        subgraph PORTS["Application-owned outbound port contracts"]
            REPO_PORT["Repository"]
            ARTIFACT_PORT["Artifact"]
            JOB_PORT["Job"]
            IDENTITY_PORT["Identity"]
            MODEL_PORT["Model"]
            REALTIME_PORT["Realtime / presence"]
        end

        subgraph ADAPTERS["Backend adapter implementations — candidate / proposed"]
            REPO_ADAPTER["Persistence adapter"]
            ARTIFACT_ADAPTER["Artifact adapter"]
            JOB_ADAPTER["Job / queue adapter"]
            IDENTITY_ADAPTER["Adult identity adapter"]
            AI_ADAPTER["AI provider adapter<br/>backend only"]
            REALTIME_ADAPTER["Realtime adapter"]
            WORKER["Async worker process<br/>separate from request path"]
        end
    end

    subgraph EXTERNAL["Persistence and external service boundaries"]
        POSTGRES[("PostgreSQL<br/>candidate — not selected")]
        OBJECT_STORE[("S3-compatible object storage<br/>candidate — not selected")]
        REDIS_RQ["Redis / RQ queue<br/>candidate — not selected"]
        FIREBASE_AUTH["Firebase Authentication<br/>adult identity only; adapter TBD"]
        AI_PROVIDER["AI provider API<br/>provider and payload TBD"]
        WS_TRANSPORT["WebSocket transport<br/>PROPOSED"]
    end

    CHILD_APP -->|REST commands / canvas operations| API
    TEACHER_UI -->|REST controls / reviews / queries| API
    ADMIN_UI -->|scoped administration requests| API
    CHILD_APP -.->|canvas / presence stream — proposed| API
    TEACHER_UI -.->|live session projection — proposed| API

    API -->|validated and authorized request| APP
    APP -->|domain rules| DOMAIN
    APP -->|uses contracts| PORTS

    REPO_PORT -->|runtime invocation| REPO_ADAPTER
    ARTIFACT_PORT -->|runtime invocation| ARTIFACT_ADAPTER
    JOB_PORT -->|runtime invocation| JOB_ADAPTER
    IDENTITY_PORT -->|runtime invocation| IDENTITY_ADAPTER
    MODEL_PORT -->|runtime invocation| AI_ADAPTER
    REALTIME_PORT -->|runtime invocation| REALTIME_ADAPTER

    REPO_ADAPTER -.->|implements| REPO_PORT
    ARTIFACT_ADAPTER -.->|implements| ARTIFACT_PORT
    JOB_ADAPTER -.->|implements| JOB_PORT
    IDENTITY_ADAPTER -.->|implements| IDENTITY_PORT
    AI_ADAPTER -.->|implements| MODEL_PORT
    REALTIME_ADAPTER -.->|implements| REALTIME_PORT

    REPO_ADAPTER -->|durable records / audit references| POSTGRES
    ARTIFACT_ADAPTER -->|snapshots / media artifacts| OBJECT_STORE
    JOB_ADAPTER -->|enqueue bounded job| REDIS_RQ
    REDIS_RQ -->|claimed job| WORKER
    WORKER -->|purpose-scoped request| AI_ADAPTER
    AI_ADAPTER <-->|provider request / candidate result| AI_PROVIDER
    WORKER -->|typed result / status; recheck scope and version| APP
    IDENTITY_ADAPTER <-->|adult identity decision; payload TBD| FIREBASE_AUTH
    REALTIME_ADAPTER <-->|session events / presence| WS_TRANSPORT

