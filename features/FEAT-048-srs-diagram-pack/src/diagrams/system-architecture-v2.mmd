flowchart LR
    subgraph CLIENTS["Clients"]
        CHILD_APP["Child app<br/>Android · React Native / TypeScript<br/>confirmed"]
        TEACHER_UI["Teacher<br/>Desktop surface · confirmed<br/>UI framework TBD"]
        ADMIN_UI["Super Admin<br/>Admin surface · confirmed<br/>UI framework TBD"]
