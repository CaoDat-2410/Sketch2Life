flowchart LR
    accTitle: Sketch2Life System Architecture — logical container overview
    accDescr: Thirteen runtime components and thirteen one-way communication edges. Replies are implied. The backend system contains Backend application, Application ports, Backend adapters, and Async worker. Candidate data services, Firebase Authentication, proposed telemetry, and an AI model endpoint group are outside the software system boundary. WebSocket is proposed; AI models and hosting remain candidate, optional, or TBD.

    subgraph CLIENTS["CLIENT APPLICATIONS"]
        direction TB
        CHILD_APP["<b>Child Android app</b><br/>Client · React Native / TypeScript<br/>Drawing · shared learning<br/><small>SURFACE / PLATFORM CONFIRMED</small>"]
        TEACHER_UI["<b>Teacher Desktop</b><br/>Client · UI framework TBD<br/>Class control · content review<br/><small>SURFACE CONFIRMED</small>"]
        ADMIN_UI["<b>Super Admin</b><br/>Client · UI framework TBD<br/>Administration · oversight<br/><small>SURFACE CONFIRMED</small>"]
    end

    subgraph SYSTEM["Sketch2Life [Software system]<br/>logical view · deployment TBD"]
        direction LR
        BACKEND["<b>Backend application</b><br/>FastAPI / Python · CONFIRMED<br/>Modular structure · ports / adapters · PROPOSED<br/>Authorization · consent · sessions<br/>Application and domain policies<br/>Scope · version · result checks"]
        PORTS["<b>Application ports</b><br/>Repository · Artifact · Job<br/>Identity · Model · Realtime<br/><small>PROPOSED</small>"]
        ADAPTERS["<b>Backend adapters</b><br/>Implement application ports<br/>backend-only provider adapters<br/><small>PROPOSED</small>"]
        WORKER["<b>Async worker</b><br/>Separate process · technology TBD<br/>bounded AI / media jobs<br/>backend-only provider adapters<br/><small>PROPOSED</small>"]
    end

    subgraph DATA_SERVICES["DATA SERVICES · CANDIDATES<br/>(outside system boundary)"]
        direction TB
        POSTGRES["<b>PostgreSQL</b><br/>Data store · relational database<br/>durable records · audit references<br/><small>CANDIDATE</small>"]
        OBJECT_STORE["<b>Object storage</b><br/>S3-compatible · snapshots<br/>media artifacts<br/><small>CANDIDATE</small>"]
        QUEUE["<b>Redis / RQ queue</b><br/>Job queue · bounded background work<br/><small>CANDIDATE</small>"]
    end

    subgraph EXTERNAL["EXTERNAL SERVICES"]
        direction TB
        AUTH["<b>Firebase Authentication</b><br/>Adult identity · authentication only<br/>(no child accounts)<br/><small>INTEGRATION TBD</small>"]
        TELEMETRY["<b>Telemetry</b><br/>Operational metrics / logs<br/>redacted · no raw child media<br/><small>PROPOSED</small>"]
        AI_ENDPOINTS["<b>AI model endpoints · hosting TBD</b><br/>Reached through backend-only adapters;<br/>clients never call providers<br/><br/><b>VL · Vision understanding</b><br/>Qwen3-VL · candidate / reuse<br/>(FEAT-039 reuse note, not selected in the Master SRS)<br/><br/><b>OPT · Optional reuse adapters</b><br/>Segmentation (SAM) · ASR (Whisper variants)<br/>optional, only when the feature is approved (B15)<br/><br/><b>SK · AI Sketch</b><br/>Model and output shape TBD (OD16)<br/><br/><b>MEDIA · Knowledge · script · video</b><br/>Generation / library strategy TBD (OD16)<br/>TTS if chosen<br/><br/>Inference hosting / provider: TBD"]
    end

    %% E1–E3: Client requests. The * qualifier applies only to WS.
    CHILD_APP -->|"draw / sync · REST + WS*"| BACKEND
    TEACHER_UI -->|"control / review · REST + WS*"| BACKEND
    ADMIN_UI -->|"administer · REST"| BACKEND

    %% E4–E5: Runtime use of application-owned ports.
    BACKEND -->|"uses ports"| PORTS
    PORTS -->|"implemented by adapters"| ADAPTERS

    %% E6–E10: Backend-owned I/O boundaries. Only telemetry communication is proposed/dashed.
    ADAPTERS -->|"records"| POSTGRES
    ADAPTERS -->|"artifacts"| OBJECT_STORE
    ADAPTERS -->|"enqueue bounded job"| QUEUE
    ADAPTERS -->|"verify adult identity · integration TBD"| AUTH
    ADAPTERS -.->|"metrics / logs · proposed"| TELEMETRY

    %% E11–E13: Bounded jobs; typed results return for application scope/version validation.
    QUEUE -->|"claimed job"| WORKER
    WORKER -->|"typed completion / status · internal contract TBD · scope / version recheck"| BACKEND
    WORKER -->|"AI request · protocol TBD"| AI_ENDPOINTS

    FOOTNOTE["* WS = WebSocket, proposed (SRS B3/B8).<br/>Arrows = initiator → target; replies implied.<br/>Legend: box = application / process / data store / external service;<br/>arrow = runtime communication; dashed = proposed;<br/>dashed boundary = software system."]

    class CHILD_APP,TEACHER_UI,ADMIN_UI,BACKEND,POSTGRES,OBJECT_STORE,QUEUE,AUTH,AI_ENDPOINTS component;
    class PORTS,ADAPTERS,WORKER,TELEMETRY proposed;
    class FOOTNOTE annotation;
