%% Sketch2Life Master SRS v3.1 — package / module dependency view.
%% Namespaces are package boundaries. Runtime client-to-backend links are labeled separately from code dependencies.
%% Domain contexts are proposed B8 groupings. Infrastructure adapters implement application-owned ports.

classDiagram
    direction LR

    namespace presentation {
        class child_android_react_native_confirmed
        class teacher_desktop_framework_TBD
        class super_admin_ui_framework_TBD
    }

    namespace inbound_adapters {
        class http_api_fastapi
        class realtime_ingress_proposed
    }

    namespace application {
        class use_cases
        class repository_port
        class artifact_port
        class job_port
        class model_port
        class identity_port
        class realtime_port
        class versioned_contracts
    }

    namespace domain {
        class identity_consent
        class classroom
        class session_groups
        class drawing_collaboration
        class ai_assistance
        class knowledge_media
        class activities
        class portfolio_assessment
        class governance_audit
    }

    namespace infrastructure_adapters_proposed {
        class relational_persistence_adapter
        class artifact_storage_adapter
        class async_job_adapter
        class identity_provider_adapter
        class ai_provider_adapter
        class realtime_transport_adapter
    }

    %% Runtime protocol edges cross the app/backend boundary; they are not compile-time package imports.
    child_android ..> http_api_fastapi : HTTPS / REST contract
    teacher_desktop ..> http_api_fastapi : HTTPS / REST contract
    super_admin_ui ..> http_api_fastapi : HTTPS / REST contract
    child_android ..> realtime_ingress_proposed : WebSocket candidate
    teacher_desktop ..> realtime_ingress_proposed : WebSocket candidate

    %% Backend package dependencies point inward.
    http_api_fastapi ..> use_cases : validates and dispatches
    realtime_ingress_proposed ..> use_cases : validates and dispatches
    use_cases ..> identity_consent : domain policy
    use_cases ..> classroom : domain policy
    use_cases ..> session_groups : domain policy
    use_cases ..> drawing_collaboration : domain policy
    use_cases ..> ai_assistance : domain policy
    use_cases ..> knowledge_media : domain policy
    use_cases ..> activities : domain policy
    use_cases ..> portfolio_assessment : domain policy
    use_cases ..> governance_audit : domain policy
    use_cases ..> versioned_contracts : cross-feature contracts

    %% Outbound ports belong to the inner application boundary; adapters realize them from outside.
    use_cases ..> repository_port : uses
    use_cases ..> artifact_port : uses
    use_cases ..> job_port : uses
    use_cases ..> model_port : uses
    use_cases ..> identity_port : uses
    use_cases ..> realtime_port : uses
    relational_persistence_adapter ..|> repository_port : implements
    artifact_storage_adapter ..|> artifact_port : implements
    async_job_adapter ..|> job_port : implements
    ai_provider_adapter ..|> model_port : implements
    identity_provider_adapter ..|> identity_port : implements
    realtime_transport_adapter ..|> realtime_port : implements
