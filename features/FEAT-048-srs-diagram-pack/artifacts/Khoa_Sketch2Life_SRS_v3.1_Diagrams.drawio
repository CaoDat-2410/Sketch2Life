t;b&gt;ICON&lt;/b&gt;  Lucide outline = role only, not status &amp;nbsp;&amp;nbsp; &lt;b&gt;ARROWS&lt;/b&gt;  solid = runtime data flow · dashed amber, adapters → ports = implementation dependency · dashed blue = proposed transport" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#C8D2DE;fontColor=#34475C;fontSize=11;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="91" width="2160" height="58" as="geometry" /></mxCell><mxCell id="8" value="Child" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#61758B;fontColor=#26384B;fontSize=12;align=center;verticalAlign=bottom;spacing=6;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="82" y="343" width="88" height="86" as="geometry" /></mxCell><mxCell id="9" value="Child Android app&lt;br/&gt;React Native / TypeScript&lt;br/&gt;&lt;b&gt;CONFIRMED&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF6F0;strokeColor=#55836A;fontColor=#24364A;fontSize=12;verticalAlign=middle;spacing=7;align=left;spacingLeft=43;" vertex="1" parent="1"><mxGeometry x="205" y="334" width="220" height="104" as="geometry" /></mxCell><mxCell id="11" value="Teacher" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#61758B;fontColor=#26384B;fontSize=12;align=center;verticalAlign=bottom;spacing=6;spacingBottom=8;" vertex="1" parent="1"><mxGeometry x="82" y="578" width="88" height="86" as="geometry" /></mxCell><mxCell id="12" value="Teacher Desktop surface — CONFIRMED&lt;br/&gt;UI framework — TBD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;fontColor=#24364A;fontSize=12;verticalAlign=middle;spacing=7;align=left;spacingLeft=43;" vertex="1" parent="1"><mxGeometry x="205" y="569" width="220" height="104" as="geometry" /></mxCell><mxCell id="14" value="Super Admin" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#61758B;fontColor=#26384B;fontSize=12;align=center;verticalAlign=bottom;spaci