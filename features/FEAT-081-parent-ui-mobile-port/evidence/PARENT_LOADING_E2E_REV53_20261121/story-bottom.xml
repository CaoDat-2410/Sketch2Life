g-clickable="false" password="false" selected="false" bounds="[77,342][145,369]" drawing-order="1" hint=""><node index="0" text="1" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[103,342][120,355]" drawing-order="1" hint="" /></node><node index="1" text="Ra sân tìm thẻ" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,342][1003,349]" drawing-order="2" hint="" /><node index="2" text="Người lớn và bé cùng bước ra sân nhà dưới ánh nắng nhẹ nhàng. Bé nhìn quanh tìm hai thẻ hình rùa mà người lớn đã chuẩn bị sẵn. Bé cầm nhẹ thẻ giấy để không làm rách bề mặt mềm mại." resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,362][1003,542]" drawing-order="3" hint="" /><node index="3" text="Bé cùng người lớn ra sân để bắt đầu hoạt động vui vẻ. Bé nhìn thấy hai thẻ hình rùa nằm trên cỏ xanh mát. Người lớn chỉ vào thẻ và nói rằng đây là những thẻ hình đặc biệt. Bé cầm卡片" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,555][1003,735]" drawing-order="4" hint="" /></node><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,766][1003,1229]" drawing-order="3" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,795][145,863]" drawing-order="1" hint=""><node index="0" text="2" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[103,809][120,849]" drawing-order="1" hint="" /></node><node index="1" text="Quan sát thẻ đầu tiên" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,795][1003,843]" drawing-order="2" hint="" /><node index="2" text="Bé cầm thẻ rùa có vỏ hình lục giác với các ô màu xanh lá. Bé nhìn kỹ cổ và chân màu xanh nhạt của con rùa trên thẻ. Bé thấy đầu tròn với hai mắt nhỏ và miệng cười rất đáng yêu. Bé指" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,856][1003,1036]" drawing-order="3" hint="" /><node index="3" text="Bé quan sát kỹ thẻ rùa đầu tiên với vỏ màu xanh lá. Bé thấy cổ và chân màu xanh nhạt rất rõ ràng. Bé nhận ra đầu tròn với hai mắt nhỏ và miệng cười. Bé cảm thấy thích thú khi nhìn见" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,1049][1003,1229]" drawing-order="4" hint="" /></node><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,1261][1003,1725]" drawing-order="4" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,1290][145,1359]" drawing-order="1" hint=""><node index="0" text="3" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[103,1304][120,1344]" drawing-order="1" hint="" /></node><node index="1" text="So sánh thẻ thứ hai" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,1290][1003,1338]" drawing-order="2" hint="" /><node index="2" text="Bé cầm thẻ rùa thứ hai và đặt cạnh thẻ đầu tiên trên cỏ. Bé so sánh vỏ hình lục giác màu xanh lá với thẻ kia. Bé nhìn đuôi ngắn màu cam nhạt trên cả hai thẻ hình. Người lớn hỏi bé" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,1351][1003,1531]" drawing-order="3" hint="" /><node index="3" text="Bé đặt thẻ thứ hai cạnh thẻ đầu tiên để so sánh. Bé thấy cả hai đều có vỏ hình lục giác màu xanh lá. Bé nhận ra đuôi ngắn màu cam nhạt giống nhau. Người lớn hỏi bé về sự khác biệt." resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,1544][1003,1724]" drawing-order="4" hint="" /></node><node index="4" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,1755][1003,2218]" drawing-order="5" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,1784][145,1852]" drawing-order="1" hint=""><node index="0" text="4" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[103,1798][120,1838]" drawing-order="1" hint="" /></node><node index="1" text="Phân loại thẻ hình" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,1784][1003,1832]" drawing-order="2" hint="" /><node index="2" text="Bé xếp thẻ rùa vào nhóm theo màu sắc mà bé yêu thích. Bé đặt thẻ có vỏ xanh lá vào một nhóm riêng. Bé cẩn thận không cầm thẻ quá mạnh để tránh rách. Người lớn khuyến khích bé tiếp" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,1845][1003,2025]" drawing-order="3" hint="" /><node index="3" text="Bé tự xếp thẻ rùa vào nhóm theo màu sắc yêu thích. Bé đặt thẻ xanh lá vào nhóm riêng của mình. Bé làm rất cẩn thận để không làm rách thẻ. Người lớn khen ngợi sự chú ý của bé. Bé" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,2038][1003,2218]" drawing-order="4" hint="" /></node><node index="5" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,2250][1003,2361]" drawing-order="6" hint=""><node index="0" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" foc