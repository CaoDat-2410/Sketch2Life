ile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[103,2159][120,2199]" drawing-order="1" hint="" /></node><node index="1" text="Ra sân tìm thẻ" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,2145][1003,2193]" drawing-order="2" hint="" /><node index="2" text="Người lớn và bé cùng bước ra sân nhà dưới ánh nắng nhẹ nhàng. Bé nhìn quanh tìm hai thẻ hình rùa mà người lớn đã chuẩn bị sẵn. Bé cầm nhẹ thẻ giấy để không làm rách bề mặt mềm mại." resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,2206][1003,2361]" drawing-order="3" hint="" /><node index="3" text="Bé cùng người lớn ra sân để bắt đầu hoạt động vui vẻ. Bé nhìn thấy hai thẻ hình rùa nằm trên cỏ xanh mát. Người lớn chỉ vào thẻ và nói rằng đây là những thẻ hình đặc biệt. Bé cầm卡片" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[172,2399][1003,2361]" drawing-order="4" hint="" /></node></node></node></node></node></node></node></node></node></node></node></node></node></hierarchy>