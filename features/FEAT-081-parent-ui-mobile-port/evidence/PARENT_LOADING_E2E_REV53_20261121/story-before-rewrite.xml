ckage="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[104,431][160,489]" drawing-order="1" hint="" /></node><node index="1" text="BẢN NHÁP · Tiếng Việt" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[214,404][1003,439]" drawing-order="2" hint="" /><node index="2" text="Khám Phá Thẻ Hình Rùa" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[214,450][1003,516]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,549][1003,1777]" drawing-order="4" hint=""><node index="0" text="Bé 60 tháng cùng người lớn ra sân để tìm hai thẻ hình rùa xinh xắn. Bé quan sát kỹ lưỡng những chi tiết màu sắc trên từng thẻ giấy mềm mại. Người lớn nhẹ nhàng hướng dẫn bé so sánh hai thẻ hình bên cạnh nhau. Bé tự mình xếp các thẻ rùa vào nhóm theo màu sắc yêu thích. Cả hai cùng cười vui vẻ khi bé完" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[111,583][969,989]" drawing-order="1" hint="" /><node index="1" text="Trẻ chọn thẻ rùa có vỏ lục giác màu xanh lá và thẻ rùa cổ xanh nhạt. Bé nhìn thấy đầu tròn với hai mắt nhỏ và miệng cười trên mỗi thẻ. Người lớn hỏi bé về sự khác biệt giữa hai con rùa trên thẻ. Bé chỉ vào đuôi ngắn màu cam nhạt và nói rằng chúng giống nhau. Bé cẩn thận đặt thẻ xuống đất để không bị" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[111,1018][969,1366]" drawing-order="2" hint="" /><node index="2" text="Hoạt động so sánh thẻ hình giúp bé phân loại theo màu sắc dễ dàng. Bé tự tin xếp nhóm thẻ rùa mà không cần người lớn làm thay. Người lớn khen ngợi sự chú ý của bé khi quan sát chi tiết. Cả hai cùng chuẩn bị cho hoạt động ngoài trời tiếp theo. Bé cảm thấy vui vẻ khi khám phá thế giới xung quanh." resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[111,1395][969,1743]" drawing-order="3" hint="" /></node><node index="4" text="" resource-id="" class="android.widget.Button" package="com.sketch2life.mobile" content-desc="Xem thông tin phiên bản" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[77,1812][1003,1927]" drawing-order="5" hint=""><node index="0" text="Thông tin bản nội dung" resource-id="" class="android.widget.TextView" package="com.sketch2life.mobile" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickabl