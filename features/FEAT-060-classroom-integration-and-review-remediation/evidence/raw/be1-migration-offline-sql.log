CREATE TABLE be1_session_room_codes (
    session_id VARCHAR(128) NOT NULL, 
    organization_id VARCHAR(128) NOT NULL, 
    room_code_hmac VARCHAR(64) NOT NULL, 
    key_version VARCHAR(32) NOT NULL, 
    rotated_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (session_id), 
    CONSTRAINT uq_be1_room_code_hmac UNIQUE (room_code_hmac)
);

CREATE TABLE be1_room_code_rate_limits (
    source_hmac VARCHAR(64) NOT NULL, 
    attempts JSONB NOT NULL, 
    PRIMARY KEY (source_hmac)
);

CREATE TABLE be1_session_learning_stages (
    session_id VARCHAR(128) NOT NULL, 
    organization_id VARCHAR(128) NOT NULL, 
    stage VARCHAR(32) NOT NULL, 
    stage_revision INTEGER NOT NULL, 
    entered_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
    last_command_id VARCHAR(128), 
    PRIMARY KEY (session_id), 
    CONSTRAINT ck_be1_learning_stage CHECK (stage IN ('preparation','join','explore_draw','assistance','sharing','knowledge','off_screen','reflection','completion')), 
    CONSTRAINT ck_be1_learning_stage_revision CHECK (stage_revision > 0)
);

CREATE TABLE be1_session_learning_stage_events (
    event_id VARCHAR(36) NOT NULL, 
    organization_id VARCHAR(128) NOT NULL, 
    session_id VARCHAR(128) NOT NULL, 
    from_stage VARCHAR(32) NOT NULL, 
    to_stage VARCHAR(32) NOT NULL, 
    stage_revision INTEGER NOT NULL, 
    command_id VARCHAR(128) NOT NULL, 
    actor VARCHAR(256) NOT NULL, 
    disposition JSONB NOT NULL, 
    created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (event_id), 
    CONSTRAINT uq_be1_stage_event_revision UNIQUE (organization_id, session_id, stage_revision), 
    CONSTRAINT uq_be1_stage_event_command UNIQUE (organization_id, session_id, command_id)
);

CREATE TABLE be1_session_command_receipts (
    organization_id VARCHAR(128) NOT NULL, 
    session_id VARCHAR(128) NOT NULL, 
    command_type VARCHAR(48) NOT NULL, 
    idempotency_key VARCHAR(128) NOT NULL, 
    request_fingerprint VARCHAR(64) NOT NULL, 
    response_payload JSONB NOT NULL, 
    created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (organization_id, session_id, command_type, idempotency_key)
);

CREATE TABLE be1_group_drafts (
    draft_id VARCHAR(36) NOT NULL, 
    organization_id VARCHAR(128) NOT NULL, 
    session_id VARCHAR(128) NOT NULL, 
    group_id VARCHAR(128) NOT NULL, 
    stage_revision INTEGER NOT NULL, 
    disposition VARCHAR(24) NOT NULL, 
    durable_canvas_refs JSONB NOT NULL, 
    created_by VARCHAR(256) NOT NULL, 
    created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (draft_id), 
    CONSTRAINT uq_be1_group_draft_stage UNIQUE (organization_id, session_id, group_id, stage_revision), 
    CONSTRAINT ck_be1_group_draft_disposition CHECK (disposition = 'save_draft')
);

CREATE TABLE be1_session_outcomes (
    session_id VARCHAR(128) NOT NULL, 
    organization_id VARCHAR(128) NOT NULL, 
    outcome VARCHAR(24) NOT NULL, 
    reason_category VARCHAR(24), 
    teacher_note VARCHAR(240), 
    outcome_refs JSONB NOT NULL, 
    stage_revision INTEGER NOT NULL, 
    command_id VARCHAR(128) NOT NULL, 
    created_by VARCHAR(256) NOT NULL, 
    created_at TIMESTAMP WITH TIME ZONE DEFAULT now() NOT NULL, 
    PRIMARY KEY (session_id), 
    CONSTRAINT ck_be1_session_outcome CHECK (outcome IN ('completed','ended_early')), 
    CONSTRAINT ck_be1_session_outcome_reason CHECK ((outcome = 'completed' AND reason_category IS NULL) OR (outcome = 'ended_early' AND reason_category IS NOT NULL AND reason_category IN ('time','safety','technical','other')))
);

