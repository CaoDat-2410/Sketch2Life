meta {
  name: 517 [LOCAL / TEST ONLY] Confirm Teacher story run transcript
  type: http
  seq: 517
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/transcript-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_transcript_revision": {{transcript_revision}},
    "transcript_sha256": "{{transcript_sha256}}",
    "confirmed": true
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().state).to.equal("CONFIRMED");
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: teacher_run_id, transcript_revision and transcript_sha256 from 516 (run after 516)
  Expected: 200
  Source: backend/tests/integration/story_teacher/test_teacher_run_inputs_postgres.py
}
