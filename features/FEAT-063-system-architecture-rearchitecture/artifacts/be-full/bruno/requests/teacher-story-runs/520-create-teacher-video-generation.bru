meta {
  name: 520 [LOCAL / TEST ONLY] Create Teacher video generation
  type: http
  seq: 520
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/video-generations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{teacher_run_revision}},
    "story_sha256": "{{teacher_story_sha256}}"
  }
}

script:post-response {
  const vg = res.getBody().video_generation;
  bru.setVar("teacher_generation_id", vg.generation_id);
  bru.setVar("teacher_job_id", vg.job_id);
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const vg = res.getBody().video_generation;
    expect(vg.state).to.equal("ACCEPTED");
    expect(vg.run_state).to.equal("VIDEO_QUEUED");
    expect(String(vg.job_id).startsWith("vjob_")).to.equal(true);
    expect(String(res.getHeader("Content-Location")).endsWith(bru.getVar("teacher_run_id"))).to.equal(true);
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: teacher_run_id, teacher_run_revision, teacher_story_sha256; needs a run whose script is confirmed
  Expected: 202
  Source: backend/tests/integration/story_teacher/test_teacher_run_video_postgres.py
}
