meta {
  name: 515 [LOCAL / TEST ONLY] Confirm Teacher story run subject
  type: http
  seq: 515
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/subject-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": {{teacher_understanding_revision}},
    "confirmed_subject": "dragon"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().decision).to.equal("CONFIRMED");
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: teacher_run_id, teacher_understanding_revision (normally 1); the run context must be confirmed first (context-confirmation route)
  Expected: 202
  Source: backend/tests/integration/story_teacher/test_teacher_run_inputs_postgres.py
}
