meta {
  name: 525 [LOCAL / TEST ONLY] Mark Teacher video unsuitable
  type: http
  seq: 525
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/video-unsuitable
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{teacher_run_revision}},
    "generation_id": "{{teacher_generation_id}}",
    "reason_code": "QUALITY_LOW"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().story_run.run_state).to.equal("SCRIPT_REVIEW");
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: teacher_run_id, teacher_run_revision, teacher_generation_id; run at VIDEO_READY (this returns the run to script review, so 525 and 526 need two separate runs)
  Expected: 200
  Source: backend/tests/integration/story_teacher/test_teacher_run_video_postgres.py
}
