meta {
  name: 508 [LOCAL / TEST ONLY] Create Teacher story run
  type: http
  seq: 508
}

post {
  url: {{baseUrl}}/v1/story-runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "profile_ref": { "kind": "MANAGED_PROFILE", "id": "{{selection_child_id}}" },
    "occurrence_id": "{{occurrence_id}}",
    "plan": { "revision_no": {{plan_revision_no}}, "plan_hash": "{{plan_hash}}" },
    "activity_id": "{{plan_activity_id}}",
    "selection_id": "{{selection_id}}",
    "selection_sha256": "{{selection_sha256}}"
  }
}

script:post-response {
  const run = res.getBody().story_run;
  bru.setVar("teacher_run_id", run.run_id);
  bru.setVar("teacher_run_revision", String(run.run_revision));
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const run = res.getBody().story_run;
    expect(run.run_state).to.equal("INPUT_PROCESSING");
    expect(run.run_revision).to.equal(1);
    expect(run.occurrence_id).to.equal(bru.getVar("occurrence_id"));
    expect(String(res.getHeader("Location")).endsWith(run.run_id)).to.equal(true);
    expect(res.getHeader("ETag")).to.equal(undefined);
    expect(JSON.stringify(res.getBody())).to.not.include("display_name");
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: occurrence_id, plan_activity_id, and selection_id, selection_sha256, selection_child_id, plan_revision_no, plan_hash from 506
  Expected: 201
  Source: backend/tests/integration/story_teacher/test_teacher_run_create_postgres.py, backend/tests/contract/test_teacher_story_run_create_contract.py
}
