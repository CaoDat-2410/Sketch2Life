meta {
  name: 354 [LOCAL / TEST ONLY] Class-assigned Teacher reads session roster
  type: http
  seq: 354
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/sessions/{{pilot_session_id}}/roster
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody()).to.be.an("object");
    expect(res.getBody().contract).to.equal("Be1SessionRosterV1");
    expect(res.getBody().members).to.be.an("array");
  });
}

