meta {
  name: 356 [LOCAL / TEST ONLY] Organization-wide Teacher without class assignment gets 403 on R1
  type: http
  seq: 356
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/sessions/{{pilot_session_id}}/pilot-profiles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

