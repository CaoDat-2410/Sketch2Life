meta {
  name: 069 [MANAGER - STATE CHANGE / LOCAL TEST ONLY] Decide Access Grant
  type: http
  seq: 69
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/access-grants/{{access_grant_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  If-Match: "REPLACE_WITH_REVISION"
  Idempotency-Key: REPLACE_WITH_SYNTHETIC_VALUE
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

body:json {
  {
    "contract": "DecideLessonAccessGrantRequestV1",
    "decision": "REQUEST_CHANGES",
    "reason": "REPLACE_WITH_SYNTHETIC_REASON"
  }
}
