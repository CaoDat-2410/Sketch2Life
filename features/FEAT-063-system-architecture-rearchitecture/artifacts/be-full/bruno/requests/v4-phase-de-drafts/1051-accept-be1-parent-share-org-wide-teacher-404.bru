meta {
  name: 1051 [DRAFT-V4E] [LOCAL / TEST ONLY] Org-wide Teacher receives 404 accepting parent share
  type: http
  seq: 1051
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e3_child_id}}/parent-share/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e3-accept-org-wide-teacher-404
}

body:json {
  {
    "invitation_code": "ANY-CODE-1234567"
  }
}

tests {
  test("assert org-wide teacher uniform 404 refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

