meta {
  name: 849 [DRAFT-V4D2] [LOCAL / TEST ONLY] Create activity suggestion set rejects missing Idempotency-Key
  type: http
  seq: 849
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{phase_de_t2eb_run_id}}/activity-suggestions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "expected_understanding_revision": 1
  }
}

tests {
  test("assert missing Idempotency-Key refusal", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().detail).to.equal("request contract invalid");
  });
}

