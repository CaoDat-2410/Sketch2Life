meta {
  name: 922 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent gets 404 listing org lesson activities
  type: http
  seq: 922
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/activities?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert non-member parent refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

