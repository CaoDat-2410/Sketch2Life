post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e1-unauth-create-key
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

tests {
  test("assert unauthenticated refusal", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

