meta {
  name: 961 [DRAFT-V4E] [LOCAL / TEST ONLY] Revoke share grant rejects stale ETag
  type: http
  seq: 961
}

post {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/revoke
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "999999"
  Idempotency-Key: {{phase_de_e3_revoke_stale_key}}
}

script:pre-request {
  bru.setVar("phase_de_e3_revoke_stale_key", "e3-revoke-stale-" + Date.now());
}

tests {
  test("assert stale revision refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.match(/^"[1-9][0-9]*"$/);
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.be.a("number");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
