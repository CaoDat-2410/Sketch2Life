meta {
  name: 1043 [DRAFT-V4E] [LOCAL / TEST ONLY] Get share grant rejects malformed UUID 400
  type: http
  seq: 1043
}

get {
  url: {{baseUrl}}/v1/parent/share-grants/not-a-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert malformed UUID refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

