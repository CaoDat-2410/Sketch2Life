meta {
  name: 1034 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher filters occurrence history by state=APPROVED
  type: http
  seq: 1034
}

get {
  url: {{baseUrl}}/api/teacher/v1/organizations/{{organization_id}}/history?state=APPROVED&limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert filtered history response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonOccurrencePageV1");
    expect(body.items).to.be.an("array");
  });
}

