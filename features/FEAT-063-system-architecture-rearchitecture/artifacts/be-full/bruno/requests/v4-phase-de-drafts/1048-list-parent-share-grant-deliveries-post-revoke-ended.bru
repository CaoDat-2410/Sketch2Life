meta {
  name: 1048 [DRAFT-V4E] [LOCAL / TEST ONLY] Share grant deliveries returns ENDED and null titles after revoke
  type: http
  seq: 1048
}

get {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/deliveries?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert post-revoke neutral deliveries contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentShareDeliveryListV1");
    expect(body.share_grant_id).to.equal(bru.getVar("phase_de_e3_share_grant_id"));
    expect(body.content_access).to.equal("ENDED");
    expect(body.items).to.be.an("array");
    body.items.forEach(function (item) {
      expect(item.title).to.equal(null);
    });
  });
}

docs {
