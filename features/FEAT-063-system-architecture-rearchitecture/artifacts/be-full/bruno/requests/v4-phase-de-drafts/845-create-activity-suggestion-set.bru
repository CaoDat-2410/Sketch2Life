meta {
  name: 845 [DRAFT-V4D2] [LOCAL / TEST ONLY] Parent creates AI activity suggestion set (Hybrid B)
  type: http
  seq: 845
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{phase_de_t2eb_run_id}}/activity-suggestions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_t2eb_set_key}}
}

body:json {
  {
    "expected_understanding_revision": {{phase_de_t2eb_understanding_rev}}
  }
}

script:pre-request {
  bru.setVar("phase_de_t2eb_set_key", "t2eb-set-" + Date.now());
  if (!bru.getVar("phase_de_t2eb_understanding_rev")) {
    bru.setVar("phase_de_t2eb_understanding_rev", "1");
  }
}

script:post-response {
  const body = res.getBody();
  if (body && typeof body.suggestion_set_id === "string") {
    bru.setVar("phase_de_t2eb_suggestion_set_id", body.suggestion_set_id);
  }
  if (body && typeof body.set_revision === "number") {
    bru.setVar("phase_de_t2eb_set_revision", String(body.set_revision));
  }
  if (body && typeof body.activities_snapshot_sha256 === "string") {
    bru.setVar("phase_de_t2eb_snapshot_sha256", body.activities_snapshot_sha256);
  }
  bru.setVar("phase_de_t2eb_activity_index", "0");
}

tests {
  test("assert Hybrid B suggestion set contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Idempotency-Replayed")).to.equal("false");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentActivitySuggestionSetV1");
    expect(body.story_run_id).to.equal(bru.getVar("phase_de_t2eb_run_id"));
    expect(body.suggestion_set_id).to.be.a("string");
    expect(body.set_revision).to.be.a("number");
    expect(body.review_required).to.equal(true);
    expect(body.activities).to.be.an("array");
    expect(body.activities.length).to.be.greaterThan(0);
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Hybrid B code at 68c0fdf3; not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: disposable Parent story run phase_de_t2eb_run_id eligible for activity suggestions and its current understanding_revision in phase_de_t2eb_understanding_rev; saves phase_de_t2eb_set_key, phase_de_t2eb_suggestion_set_id, phase_de_t2eb_set_revision, phase_de_t2eb_snapshot_sha256, phase_de_t2eb_activity_index
  Expected: 200 / ParentActivitySuggestionSetV1 (Idempotency-Replayed: false)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_ai.py, backend/src/sketch2life/contracts/schemas/parent_activity_selection.py
  Catalog candidates include private shares visible through the active Parent subject/account alias; fallback quality context uses confirmed_subject when topic is absent.
}
