meta {
  name: 1046 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher gets 404 revoking Parent share grant
  type: http
  seq: 1046
}

post {
  url: {{baseUrl}}/v1/parent/share-grants/00000000-0000-4000-8000-000000000000/revoke
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "1"
  Idempotency-Key: e3-revoke-wrong-role-key
}

tests {
  test("assert non-parent role refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

