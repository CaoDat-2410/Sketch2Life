meta {
  name: 997 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent lesson feedback rejects Idempotency-Key reuse with different body
  type: http
  seq: 997
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e6_feedback_key}}
}

body:json {
  {
    "feedback_text": "Different synthetic payload reusing the same Idempotency-Key."
  }
}

tests {
  test("assert idempotency key mismatch refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

