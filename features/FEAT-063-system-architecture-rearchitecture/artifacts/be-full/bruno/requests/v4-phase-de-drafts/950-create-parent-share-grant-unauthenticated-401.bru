meta {
  name: 950 [DRAFT-V4E] [LOCAL / TEST ONLY] Create share grant requires authentication
  type: http
  seq: 950
}

post {
  url: {{baseUrl}}/v1/parent/share-grants
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e3-grant-unauth-key
}

body:json {
  {
    "profile_id": "00000000-0000-4000-8000-000000000000",
    "granted_fields": [
      "DISPLAY_NAME"
    ]
  }
}

tests {
  test("assert unauthenticated refusal", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

