meta {
  name: 1058 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent lesson feedback replies rejects invalid cursor 400
  type: http
  seq: 1058
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback/replies?cursor=not-a-valid-cursor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert invalid cursor refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

