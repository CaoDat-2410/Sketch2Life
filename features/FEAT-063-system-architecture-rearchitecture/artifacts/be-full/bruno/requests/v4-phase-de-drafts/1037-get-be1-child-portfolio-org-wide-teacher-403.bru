meta {
  name: 1037 [DRAFT-V4E] [LOCAL / TEST ONLY] Org-wide Teacher gets 403 reading BE1 child portfolio
  type: http
  seq: 1037
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e2_child_id}}/portfolio?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert org-wide teacher refusal", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

