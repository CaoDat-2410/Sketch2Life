meta {
  name: 1010 [DRAFT-V4E] [LOCAL / TEST ONLY] Non-responsible class Teacher gets 403 initializing presentation
  type: http
  seq: 1010
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e1-create-non-resp-teacher-403
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

tests {
  test("assert non-responsible class Teacher refusal", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

docs {
