meta {
  name: 1012 [DRAFT-V4E] [LOCAL / TEST ONLY] Init lesson presentation rejects unapproved plan 409
  type: http
  seq: 1012
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_unapproved_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_unapproved_key}}
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_unapproved_key", "e1-unapproved-" + Date.now());
}

tests {
  test("assert unapproved lesson plan refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("LESSON_PLAN_NOT_APPROVED");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Responsible Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: occurrence phase_de_e1_unapproved_occurrence_id owned by Teacher without an APPROVED lesson plan
  Expected: 409 / LESSON_PLAN_NOT_APPROVED
