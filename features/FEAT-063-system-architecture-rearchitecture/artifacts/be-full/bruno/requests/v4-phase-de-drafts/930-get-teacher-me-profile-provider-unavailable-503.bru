meta {
  name: 930 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher profile fails closed without identity provisioner (503)
  type: http
  seq: 930
}

get {
  url: {{baseUrl}}/api/teacher/v1/me/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert identity provider unavailable refusal", function () {
    expect(res.getStatus()).to.equal(503);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("IDENTITY_PROVIDER_UNAVAILABLE");
  });
}

