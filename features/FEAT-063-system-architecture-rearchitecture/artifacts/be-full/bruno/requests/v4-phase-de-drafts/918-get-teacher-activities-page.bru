meta {
  name: 918 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher lists org lesson activities (page 1)
  type: http
  seq: 918
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/activities?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (body && typeof body.next_cursor === "string") {
    bru.setVar("phase_de_e2_activities_cursor", body.next_cursor);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("TeacherActivityPageV1");
    expect(body.items).to.be.an("array");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: organization_id=seed-org-a; saves phase_de_e2_activities_cursor when next_cursor is present
  Expected: 200 / TeacherActivityPageV1 (Cache-Control: private, no-cache, Vary: Authorization)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:264-290, backend/src/sketch2life/application/services/lesson_library.py
}
