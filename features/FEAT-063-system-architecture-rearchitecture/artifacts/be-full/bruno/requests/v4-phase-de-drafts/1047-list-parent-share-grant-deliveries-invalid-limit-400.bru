meta {
  name: 1047 [DRAFT-V4E] [LOCAL / TEST ONLY] Share grant deliveries rejects limit above 100 400
  type: http
  seq: 1047
}

get {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/deliveries?limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert limit out of range refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("limit");
    expect(body.field_errors[0].code).to.equal("OUT_OF_RANGE");
  });
}

