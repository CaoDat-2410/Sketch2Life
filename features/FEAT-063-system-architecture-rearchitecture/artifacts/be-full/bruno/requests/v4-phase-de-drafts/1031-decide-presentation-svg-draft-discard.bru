meta {
  name: 1031 [DRAFT-V4E] [LOCAL / TEST ONLY] Responsible Teacher discards presentation SVG draft
  type: http
  seq: 1031
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts/{{phase_de_e1_discard_svg_draft_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{phase_de_e1_svg_discard_key}}
}

body:json {
  {
    "decision": "DISCARD"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_svg_discard_key", "e1-svg-discard-" + Date.now());
}

tests {
  test("assert SVG draft discard contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.equal('"2"');
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("PresentationSvgDraftV1");
    expect(body.state).to.equal("DISCARDED");
    expect(body.revision).to.equal(2);
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Responsible Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: pending SVG draft phase_de_e1_discard_svg_draft_id on phase_de_e1_occurrence_id
  Expected: 200 / PresentationSvgDraftV1 (state: DISCARDED, revision: 2, ETag: "2")
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py
}
