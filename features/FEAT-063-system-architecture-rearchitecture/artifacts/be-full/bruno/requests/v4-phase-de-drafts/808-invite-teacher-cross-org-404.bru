meta {
  name: 808 [DRAFT-V4D] [LOCAL / TEST ONLY] Return uniform 404 for cross-org Manager on Teacher invitation
  type: http
  seq: 808
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/seed-org-a/teacher-invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "email": "{{phase_de_invite_email}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

