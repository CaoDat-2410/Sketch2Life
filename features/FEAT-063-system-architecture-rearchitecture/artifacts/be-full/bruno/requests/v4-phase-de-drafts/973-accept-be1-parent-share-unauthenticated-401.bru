meta {
  name: 973 [DRAFT-V4E] [LOCAL / TEST ONLY] Accept parent-share requires authentication
  type: http
  seq: 973
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/any-child/parent-share/accept
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e3-accept-unauth-key
}

body:json {
  {
    "invitation_code": "ANY-CODE-1234567"
  }
}

tests {
  test("assert unauthenticated refusal", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

