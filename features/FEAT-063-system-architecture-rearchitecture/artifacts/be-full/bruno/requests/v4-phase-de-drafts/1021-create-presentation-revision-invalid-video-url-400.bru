meta {
  name: 1021 [DRAFT-V4E] [LOCAL / TEST ONLY] Create presentation revision rejects disallowed video embed URL 400
  type: http
  seq: 1021
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: {{phase_de_e1_etag}}
  Idempotency-Key: {{phase_de_e1_bad_video_key}}
}

body:json {
  {
    "repin_to_current_plan": false,
    "operations": [
      {
        "op": "SET_MEDIA",
        "slide_id": "{{phase_de_e1_slide_id}}",
        "placement": "FULL",
        "media": {
          "kind": "VIDEO_EMBED",
          "url": "http://example.com/not-youtube-or-vimeo"
        }
      }
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_bad_video_key", "e1-bad-video-" + Date.now());
  if (!bru.getVar("phase_de_e1_etag")) {
    bru.setVar("phase_de_e1_etag", '"1"');
  }
}

tests {
  test("assert disallowed video embed URL refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("operations[0].media.url");
    expect(body.field_errors[0].code).to.equal("INVALID_FORMAT");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Responsible Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: run after 870 using phase_de_e1_occurrence_id and phase_de_e1_slide_id
  Expected: 400 / INVALID_REQUEST (field_errors operations[0].media.url INVALID_FORMAT)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py, backend/src/sketch2life/domain/lesson_occurrences/presentation.py
}
