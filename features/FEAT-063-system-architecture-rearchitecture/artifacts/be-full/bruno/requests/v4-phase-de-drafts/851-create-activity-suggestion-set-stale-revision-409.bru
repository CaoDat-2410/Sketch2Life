meta {
  name: 851 [DRAFT-V4D2] [LOCAL / TEST ONLY] Create activity suggestion set rejects stale understanding revision
  type: http
  seq: 851
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{phase_de_t2eb_run_id}}/activity-suggestions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_t2eb_stale_key}}
}

body:json {
  {
    "expected_understanding_revision": 999999
  }
}

script:pre-request {
  bru.setVar("phase_de_t2eb_stale_key", "t2eb-stale-" + Date.now());
}

tests {
  test("assert stale revision conflict", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.detail.code).to.equal("STALE_REVISION");
    expect(body.detail.current_version).to.be.a("number");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Hybrid B code at 68c0fdf3; not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: owned Parent story run phase_de_t2eb_run_id
  Expected: 409 / STALE_REVISION (detail.current_version)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_ai.py, backend/src/sketch2life/infrastructure/persistence/parent_activity_suggestion_set_repository.py
}
