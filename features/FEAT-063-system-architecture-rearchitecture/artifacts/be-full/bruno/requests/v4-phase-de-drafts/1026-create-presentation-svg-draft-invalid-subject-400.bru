meta {
  name: 1026 [DRAFT-V4E] [LOCAL / TEST ONLY] Create SVG draft rejects invalid subject_text format 400
  type: http
  seq: 1026
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e1-svg-bad-subject-key
}

body:json {
  {
    "plan_activity_id": "any-activity",
    "subject_text": "bad!subject@123"
  }
}

tests {
  test("assert invalid subject_text format refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("subject_text");
    expect(body.field_errors[0].code).to.equal("INVALID_FORMAT");
  });
}

docs {
