meta {
  name: 964 [DRAFT-V4E] [LOCAL / TEST ONLY] Revoke share grant requires authentication
  type: http
  seq: 964
}

post {
  url: {{baseUrl}}/v1/parent/share-grants/00000000-0000-4000-8000-000000000000/revoke
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "1"
  Idempotency-Key: e3-revoke-unauth-key
}

tests {
  test("assert unauthenticated refusal", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

