meta {
  name: 1045 [DRAFT-V4E] [LOCAL / TEST ONLY] Revoke share grant rejects Idempotency-Key reuse across grants 400
  type: http
  seq: 1045
}

post {
  url: {{baseUrl}}/v1/parent/share-grants/00000000-0000-4000-8000-000000000001/revoke
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "1"
  Idempotency-Key: {{phase_de_e3_revoke_key}}
}

tests {
  test("assert idempotency key mismatch refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

