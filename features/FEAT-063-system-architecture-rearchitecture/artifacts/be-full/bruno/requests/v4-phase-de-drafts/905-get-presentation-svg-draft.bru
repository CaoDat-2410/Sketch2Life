meta {
  name: 905 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher gets presentation SVG draft
  type: http
  seq: 905
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts/{{phase_de_e1_svg_draft_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e1_svg_draft_etag", etag);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.be.a("string");
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("PresentationSvgDraftV1");
    expect(body.svg_draft_id).to.equal(bru.getVar("phase_de_e1_svg_draft_id"));
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: run after 901 using phase_de_e1_occurrence_id and phase_de_e1_svg_draft_id; refreshes phase_de_e1_svg_draft_etag
  Expected: 200 / PresentationSvgDraftV1 (ETag, Cache-Control: private, no-cache)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py
}
