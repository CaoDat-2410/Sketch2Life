meta {
  name: 947 [DRAFT-V4E] [LOCAL / TEST ONLY] Create share grant rejects missing Idempotency-Key
  type: http
  seq: 947
}

post {
  url: {{baseUrl}}/v1/parent/share-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "profile_id": "{{phase_de_e3_profile_id}}",
    "granted_fields": [
      "DISPLAY_NAME"
    ]
  }
}

tests {
  test("assert missing Idempotency-Key refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("Idempotency-Key");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

