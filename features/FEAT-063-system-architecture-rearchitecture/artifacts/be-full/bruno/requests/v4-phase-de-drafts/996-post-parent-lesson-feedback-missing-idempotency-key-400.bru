meta {
  name: 996 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent lesson feedback rejects missing Idempotency-Key
  type: http
  seq: 996
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "feedback_text": "Synthetic feedback missing key."
  }
}

tests {
  test("assert missing Idempotency-Key refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("Idempotency-Key");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

