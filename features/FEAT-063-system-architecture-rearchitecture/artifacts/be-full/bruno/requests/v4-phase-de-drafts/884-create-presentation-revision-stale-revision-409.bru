meta {
  name: 884 [DRAFT-V4E] [LOCAL / TEST ONLY] Create presentation revision rejects stale ETag
  type: http
  seq: 884
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "999999"
  Idempotency-Key: {{phase_de_e1_rev_stale_key}}
}

body:json {
  {
    "repin_to_current_plan": false,
    "operations": [
      {
        "op": "UPDATE_SLIDE",
        "slide_id": "{{phase_de_e1_slide_id}}",
        "title": "Stale Revision"
      }
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_rev_stale_key", "e1-rev-stale-" + Date.now());
}

tests {
  test("assert stale revision refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.match(/^"[1-9][0-9]*"$/);
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.be.a("number");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
