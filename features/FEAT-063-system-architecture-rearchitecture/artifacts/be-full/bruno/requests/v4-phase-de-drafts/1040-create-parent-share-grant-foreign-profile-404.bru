meta {
  name: 1040 [DRAFT-V4E] [LOCAL / TEST ONLY] Create share grant hides missing or foreign profile with 404
  type: http
  seq: 1040
}

post {
  url: {{baseUrl}}/v1/parent/share-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e3_foreign_grant_key}}
}

body:json {
  {
    "profile_id": "00000000-0000-4000-8000-000000000000",
    "granted_fields": [
      "DISPLAY_NAME"
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e3_foreign_grant_key", "e3-grant-404-" + Date.now());
}

tests {
  test("assert foreign or missing profile 404", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Active Parent - set bearerToken to seed-parent-p1 token
  Needs: none
  Expected: 404 / RESOURCE_NOT_FOUND
  Source: backend/src/sketch2life/interfaces/http/routers/parent_share_grants.py
}
