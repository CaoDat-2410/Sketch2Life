meta {
  name: 934 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher gets paged BE1 child portfolio
  type: http
  seq: 934
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e2_child_id}}/portfolio?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert paged portfolio response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1PortfolioPageV1");
    expect(body.items).to.be.an("array");
  });
}

