meta {
  name: 998 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent lesson feedback returns 404 for unknown lesson
  type: http
  seq: 998
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/nonexistent-lesson-id/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e6_unknown_feedback_key}}
}

body:json {
  {
    "feedback_text": "Synthetic test feedback."
  }
}

script:pre-request {
  bru.setVar("phase_de_e6_unknown_feedback_key", "e6-unknown-fb-" + Date.now());
}

tests {
  test("assert unknown lesson refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

docs {
