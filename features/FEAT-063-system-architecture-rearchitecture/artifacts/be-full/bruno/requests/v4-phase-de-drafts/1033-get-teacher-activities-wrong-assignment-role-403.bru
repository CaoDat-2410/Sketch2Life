meta {
  name: 1033 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned non-teacher org role gets 403 listing org activities
  type: http
  seq: 1033
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/activities?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert non-teacher/manager assigned role refusal", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

