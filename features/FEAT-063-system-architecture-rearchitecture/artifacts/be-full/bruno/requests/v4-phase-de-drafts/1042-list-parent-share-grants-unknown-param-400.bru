meta {
  name: 1042 [DRAFT-V4E] [LOCAL / TEST ONLY] List share grants rejects unknown query parameter 400
  type: http
  seq: 1042
}

get {
  url: {{baseUrl}}/v1/parent/share-grants?profile_id={{phase_de_e3_profile_id}}&extra=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert unknown query parameter refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("extra");
    expect(body.field_errors[0].code).to.equal("UNKNOWN_FIELD");
  });
}

