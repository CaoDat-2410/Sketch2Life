meta {
  name: 952 [DRAFT-V4E] [LOCAL / TEST ONLY] List share grants rejects missing profile_id
  type: http
  seq: 952
}

get {
  url: {{baseUrl}}/v1/parent/share-grants
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert missing profile_id refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("profile_id");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

