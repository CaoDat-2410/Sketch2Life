meta {
  name: 875 [DRAFT-V4E] [LOCAL / TEST ONLY] Foreign Teacher gets 404 initializing presentation
  type: http
  seq: 875
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e1-foreign-teacher-key
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

tests {
  test("assert foreign teacher cross-tenant 404", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

