meta {
  name: 1044 [DRAFT-V4E] [LOCAL / TEST ONLY] Revoke share grant rejects missing Idempotency-Key 400
  type: http
  seq: 1044
}

post {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/revoke
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "1"
}

tests {
  test("assert missing Idempotency-Key refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("Idempotency-Key");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

docs {
