meta {
  name: 891 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher marks presentation revision READY
  type: http
  seq: 891
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions/{{phase_de_e1_revision_no}}/ready
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: {{phase_de_e1_etag}}
  Idempotency-Key: {{phase_de_e1_ready_key}}
}

script:pre-request {
  bru.setVar("phase_de_e1_ready_key", "e1-ready-" + Date.now());
  if (!bru.getVar("phase_de_e1_etag")) {
    bru.setVar("phase_de_e1_etag", '"1"');
  }
}

script:post-response {
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e1_etag", etag);
  }
}

tests {
  test("assert ready response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.be.a("string");
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonPresentationV1");
    expect(body.revision).to.be.a("number");
    expect(body.ready_revision_no).to.equal(body.head_revision_no);
    expect(body.presentable).to.equal(true);
    expect(body.head.state).to.equal("READY");
  });
}

docs {
