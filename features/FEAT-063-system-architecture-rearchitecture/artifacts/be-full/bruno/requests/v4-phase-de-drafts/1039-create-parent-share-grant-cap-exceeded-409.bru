meta {
  name: 1039 [DRAFT-V4E] [LOCAL / TEST ONLY] Create share grant enforces 10-open-grant cap per profile 409
  type: http
  seq: 1039
}

post {
  url: {{baseUrl}}/v1/parent/share-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e3_grant_cap_key}}
}

body:json {
  {
    "profile_id": "{{phase_de_e3_capped_profile_id}}",
    "granted_fields": [
      "DISPLAY_NAME"
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e3_grant_cap_key", "e3-grant-cap-" + Date.now());
}

tests {
  test("assert open grant cap conflict", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_CONFLICT");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: owned synthetic profile phase_de_e3_capped_profile_id already at 10 open (INVITED or ACTIVE) share grants
  Expected: 409 / RESOURCE_CONFLICT
  Source: backend/src/sketch2life/interfaces/http/routers/parent_share_grants.py, backend/src/sketch2life/infrastructure/profile_sharing/service.py
}
