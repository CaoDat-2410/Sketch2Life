meta {
  name: 1036 [DRAFT-V4E] [LOCAL / TEST ONLY] BE1 child portfolio returns 409 CONSENT_NOT_EFFECTIVE for REAL profile
  type: http
  seq: 1036
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e2_real_child_id}}/portfolio?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert consent not effective refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("CONSENT_NOT_EFFECTIVE");
  });
}

