meta {
  name: 1050 [DRAFT-V4E] [LOCAL / TEST ONLY] Accept parent-share rejects malformed invitation_code 400
  type: http
  seq: 1050
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e3_child_id}}/parent-share/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e3-accept-bad-code-400
}

body:json {
  {
    "invitation_code": "short"
  }
}

tests {
  test("assert malformed invitation_code refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

