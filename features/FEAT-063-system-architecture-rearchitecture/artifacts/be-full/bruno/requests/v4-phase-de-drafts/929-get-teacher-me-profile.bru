meta {
  name: 929 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher gets own profile when provisioner configured
  type: http
  seq: 929
}

get {
  url: {{baseUrl}}/api/teacher/v1/me/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("TeacherProfileV1");
  });
}

