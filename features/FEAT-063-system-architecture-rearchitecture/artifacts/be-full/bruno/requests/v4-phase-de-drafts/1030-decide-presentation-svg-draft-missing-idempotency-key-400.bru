meta {
  name: 1030 [DRAFT-V4E] [LOCAL / TEST ONLY] Decide SVG draft rejects missing Idempotency-Key 400
  type: http
  seq: 1030
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts/{{phase_de_e1_svg_draft_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
}

body:json {
  {
    "decision": "ACCEPT"
  }
}

tests {
  test("assert missing Idempotency-Key refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("Idempotency-Key");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

