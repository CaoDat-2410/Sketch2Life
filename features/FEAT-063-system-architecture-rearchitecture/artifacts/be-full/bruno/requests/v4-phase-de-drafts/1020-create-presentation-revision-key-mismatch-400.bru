meta {
  name: 1020 [DRAFT-V4E] [LOCAL / TEST ONLY] Create presentation revision rejects Idempotency-Key mismatch 400
  type: http
  seq: 1020
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{phase_de_e1_rev_key}}
}

body:json {
  {
    "repin_to_current_plan": false,
    "operations": [
      {
        "op": "UPDATE_SLIDE",
        "slide_id": "{{phase_de_e1_slide_id}}",
        "title": "Different Payload Same Key"
      }
    ]
  }
}

tests {
  test("assert idempotency key mismatch refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

