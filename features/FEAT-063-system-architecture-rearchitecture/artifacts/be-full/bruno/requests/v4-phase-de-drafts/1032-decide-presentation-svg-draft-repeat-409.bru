meta {
  name: 1032 [DRAFT-V4E] [LOCAL / TEST ONLY] Decide SVG draft rejects repeat decision on decided draft 409
  type: http
  seq: 1032
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts/{{phase_de_e1_svg_draft_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: {{phase_de_e1_svg_draft_etag}}
  Idempotency-Key: {{phase_de_e1_svg_repeat_decide_key}}
}

body:json {
  {
    "decision": "DISCARD"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_svg_repeat_decide_key", "e1-svg-repeat-decide-" + Date.now());
  if (!bru.getVar("phase_de_e1_svg_draft_etag")) {
    bru.setVar("phase_de_e1_svg_draft_etag", '"2"');
  }
}

tests {
  test("assert repeat decision conflict", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
