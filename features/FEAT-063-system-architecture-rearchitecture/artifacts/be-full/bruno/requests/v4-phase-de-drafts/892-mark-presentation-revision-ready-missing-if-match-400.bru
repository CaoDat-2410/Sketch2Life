meta {
  name: 892 [DRAFT-V4E] [LOCAL / TEST ONLY] Mark presentation revision ready rejects missing If-Match
  type: http
  seq: 892
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions/1/ready
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: e1-ready-missing-if-match
}

tests {
  test("assert missing If-Match refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("If-Match");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

