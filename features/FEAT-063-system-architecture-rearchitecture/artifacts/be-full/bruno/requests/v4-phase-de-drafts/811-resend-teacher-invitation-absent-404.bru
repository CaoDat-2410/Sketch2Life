meta {
  name: 811 [DRAFT-V4D] [LOCAL / TEST ONLY] Return uniform 404 when resending unknown Teacher invitation
  type: http
  seq: 811
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/teacher-invitations/00000000-0000-4000-8000-000000000000/resend
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

