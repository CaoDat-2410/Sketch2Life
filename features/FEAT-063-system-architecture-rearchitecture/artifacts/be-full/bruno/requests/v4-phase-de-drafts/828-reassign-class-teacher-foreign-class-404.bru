meta {
  name: 828 [DRAFT-V4D] [LOCAL / TEST ONLY] Return uniform 404 for cross-org Manager on assignment
  type: http
  seq: 828
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/seed-org-a-class-1/assignments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "candidate_ref": "seed-tch-a3"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

