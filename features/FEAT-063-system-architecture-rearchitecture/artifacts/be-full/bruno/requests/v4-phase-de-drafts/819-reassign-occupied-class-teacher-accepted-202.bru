meta {
  name: 819 [DRAFT-V4D] [LOCAL / TEST ONLY] Manager initiates Teacher reassignment on occupied class
  type: http
  seq: 819
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_de_transfer_class_id}}/assignments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_de_transfer_expected_rev}}"
  Idempotency-Key: {{phase_de_reassign_key}}
}

body:json {
  {
    "candidate_ref": "{{phase_de_transfer_candidate_ref}}"
  }
}

script:pre-request {
  bru.setVar("phase_de_reassign_key", "t6b-reassign-" + Date.now());
  bru.setVar("phase_de_transfer_expected_rev", String(bru.getVar("phase_de_transfer_revision") || "1"));
}

script:post-response {
  const body = res.getBody();
  if (typeof body.transfer_id === "string") {
    bru.setVar("phase_de_transfer_id", body.transfer_id);
  }
  if (typeof body.assignment_revision === "number") {
    bru.setVar("phase_de_transfer_fenced_revision", String(body.assignment_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getHeader("Location")).to.include("/assignment-transfers/");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1TeacherAssignmentTransferAcceptedV1");
    expect(body.class_id).to.equal(bru.getVar("phase_de_transfer_class_id"));
    expect(body.action).to.equal("REASSIGN");
    expect(body.state).to.equal("TRANSFER_PENDING");
    expect(res.getHeader("ETag")).to.equal('"' + String(body.assignment_revision) + '"');
  });
}

docs {
  DRAFT after Phase D/E: checked against the code in .worktrees/v4d at working tree on 9e439cee; not yet run against a live backend.
  Role: Assigned School Manager - set bearerToken to seed-mgr-a token
  Needs: needs-fixture: disposable occupied class phase_de_transfer_class_id, its assignment_revision in phase_de_transfer_revision, eligible replacement candidate_ref in phase_de_transfer_candidate_ref; saves phase_de_reassign_key, phase_de_transfer_id
  Expected: 202 / Be1TeacherAssignmentTransferAcceptedV1 (REASSIGN, TRANSFER_PENDING)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:403-815, backend/src/sketch2life/infrastructure/persistence/teacher_assignment_transfer_repository.py:58-404
}
