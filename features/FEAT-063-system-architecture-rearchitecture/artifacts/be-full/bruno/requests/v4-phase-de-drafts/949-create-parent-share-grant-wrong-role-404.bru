meta {
  name: 949 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher gets 404 creating Parent share grant
  type: http
  seq: 949
}

post {
  url: {{baseUrl}}/v1/parent/share-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e3-grant-wrong-role-key
}

body:json {
  {
    "profile_id": "00000000-0000-4000-8000-000000000000",
    "granted_fields": [
      "DISPLAY_NAME"
    ]
  }
}

tests {
  test("assert non-parent role refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

