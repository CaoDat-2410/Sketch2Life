meta {
  name: 881 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher creates new presentation revision
  type: http
  seq: 881
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: {{phase_de_e1_etag}}
  Idempotency-Key: {{phase_de_e1_rev_key}}
}

body:json {
  {
    "repin_to_current_plan": false,
    "operations": [
      {
        "op": "UPDATE_SLIDE",
        "slide_id": "{{phase_de_e1_slide_id}}",
        "title": "Updated Intro Slide"
      }
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_rev_key", "e1-rev-" + Date.now());
  if (!bru.getVar("phase_de_e1_etag")) {
    bru.setVar("phase_de_e1_etag", '"1"');
  }
}

script:post-response {
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e1_etag", etag);
  }
  const body = res.getBody();
  if (body && body.head && typeof body.head.revision_no === "number") {
    bru.setVar("phase_de_e1_revision_no", String(body.head.revision_no));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Content-Location")).to.include("/presentation/revisions/");
    expect(res.getHeader("ETag")).to.be.a("string");
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonPresentationV1");
    expect(body.revision).to.be.at.least(2);
    expect(body.head_revision_no).to.be.greaterThan(1);
    expect(body.head.revision_no).to.be.greaterThan(1);
    expect(body.head.state).to.equal("DRAFT");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: run after 870 using phase_de_e1_occurrence_id, phase_de_e1_etag, phase_de_e1_slide_id; saves updated phase_de_e1_etag and phase_de_e1_revision_no
  Expected: 201 / LessonPresentationV1 (Content-Location, ETag, Cache-Control: private, no-cache)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py, backend/src/sketch2life/application/services/presentations.py:604-755
}
