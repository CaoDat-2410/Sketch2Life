meta {
  name: 803 [DRAFT-V4D] [LOCAL / TEST ONLY] Reject Teacher invitation key reused for another address
  type: http
  seq: 803
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/teacher-invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_invite_key}}
}

body:json {
  {
    "email": "{{phase_de_invite_other_email}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

