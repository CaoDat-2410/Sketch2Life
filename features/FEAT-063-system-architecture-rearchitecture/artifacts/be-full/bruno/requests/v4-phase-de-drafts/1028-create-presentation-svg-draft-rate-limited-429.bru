meta {
  name: 1028 [DRAFT-V4E] [LOCAL / TEST ONLY] Create SVG draft enforces 24h rate limit 429 (fixture)
  type: http
  seq: 1028
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_svg_capped_occurrence_id}}/presentation/svg-drafts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_svg_ratelimit_key}}
}

body:json {
  {
    "plan_activity_id": "{{phase_de_e1_plan_activity_id}}",
    "subject_text": "butterfly"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_svg_ratelimit_key", "e1-svg-429-" + Date.now());
}

tests {
  test("assert SVG draft rate limit refusal", function () {
    expect(res.getStatus()).to.equal(429);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Retry-After")).to.equal("3600");
    const body = res.getBody();
    expect(body.code).to.equal("RATE_LIMITED");
    expect(body.retryable).to.equal(true);
    expect(body.retry_after_seconds).to.equal(3600);
  });
}

docs {
