meta {
  name: 861 [DRAFT-V4D2] [LOCAL / TEST ONLY] Select AI suggestion set activity rejects invalid body
  type: http
  seq: 861
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{phase_de_t2eb_run_id}}/activity-selection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: t2eb-select-invalid-body-key
}

body:json {
  {
    "suggestion_set_id": "{{phase_de_t2eb_suggestion_set_id}}",
    "expected_understanding_revision": 1,
    "activity_index": 0,
    "unexpected": true
  }
}

tests {
  test("assert invalid selection payload refusal", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().detail).to.equal("request contract invalid");
  });
}

