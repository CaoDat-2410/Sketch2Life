meta {
  name: 1024 [DRAFT-V4E] [LOCAL / TEST ONLY] Mark presentation revision ready rejects non-DRAFT revision 409
  type: http
  seq: 1024
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions/{{phase_de_e1_revision_no}}/ready
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: {{phase_de_e1_etag}}
  Idempotency-Key: {{phase_de_e1_ready_repeat_key}}
}

script:pre-request {
  bru.setVar("phase_de_e1_ready_repeat_key", "e1-ready-repeat-" + Date.now());
}

tests {
  test("assert non-DRAFT revision refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
