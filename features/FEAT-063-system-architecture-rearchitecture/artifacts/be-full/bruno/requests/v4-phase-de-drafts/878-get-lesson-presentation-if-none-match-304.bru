meta {
  name: 878 [DRAFT-V4E] [LOCAL / TEST ONLY] Get lesson presentation supports If-None-Match 304
  type: http
  seq: 878
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-None-Match: {{phase_de_e1_get_etag}}
}

tests {
  test("assert conditional 304 response", function () {
    expect(res.getStatus()).to.equal(304);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
  });
}

