meta {
  name: 820 [DRAFT-V4D] [LOCAL / TEST ONLY] Replay occupied-class Teacher reassignment
  type: http
  seq: 820
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_de_transfer_class_id}}/assignments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_de_transfer_expected_rev}}"
  Idempotency-Key: {{phase_de_reassign_key}}
}

body:json {
  {
    "candidate_ref": "{{phase_de_transfer_candidate_ref}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getBody().transfer_id).to.equal(bru.getVar("phase_de_transfer_id"));
  });
}

docs {
