meta {
  name: 970 [DRAFT-V4E] [LOCAL / TEST ONLY] Accept parent-share rejects missing Idempotency-Key
  type: http
  seq: 970
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e3_child_id}}/parent-share/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "invitation_code": "ANY-CODE-1234567"
  }
}

tests {
  test("assert missing Idempotency-Key refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("Idempotency-Key");
    expect(body.field_errors[0].code).to.equal("REQUIRED");
  });
}

