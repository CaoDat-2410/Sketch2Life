meta {
  name: 802 [DRAFT-V4D] [LOCAL / TEST ONLY] Replay Manager Teacher invitation with same key
  type: http
  seq: 802
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/teacher-invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_invite_key}}
}

body:json {
  {
    "email": "{{phase_de_invite_email}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getBody().account_ref).to.equal(bru.getVar("phase_de_invited_account_ref"));
    expect(res.getBody().status).to.equal("PENDING_VERIFICATION");
  });
}

