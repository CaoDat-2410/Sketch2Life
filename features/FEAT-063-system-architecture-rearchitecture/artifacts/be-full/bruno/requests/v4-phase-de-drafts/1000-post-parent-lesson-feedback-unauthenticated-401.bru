meta {
  name: 1000 [DRAFT-V4E] [LOCAL / TEST ONLY] Post parent lesson feedback requires authentication
  type: http
  seq: 1000
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/any-lesson-id/feedback
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e6-fb-unauth-key
}

body:json {
  {
    "feedback_text": "Unauthenticated check."
  }
}

tests {
  test("assert unauthenticated refusal", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

