meta {
  name: 896 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher fetches referenced presentation image
  type: http
  seq: 896
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/images/{{phase_de_e1_asset_ref}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: image/jpeg, image/png, image/webp, */*
  X-Request-ID: {{request_id}}
}

tests {
  test("assert presentation image headers", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getHeader("Vary")).to.include("Authorization");
    expect(res.getHeader("X-Content-Type-Options")).to.equal("nosniff");
    expect(res.getHeader("Content-Disposition")).to.include("inline");
    expect(res.getHeader("ETag")).to.be.a("string");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: lesson occurrence phase_de_e1_occurrence_id with a referenced image asset phase_de_e1_asset_ref on its presentation
  Expected: 200 / binary image bytes (image/jpeg|png|webp; Cache-Control: private, no-store, Vary: Authorization, X-Content-Type-Options: nosniff, Content-Disposition: inline, ETag)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py, backend/src/sketch2life/application/services/presentations.py
}
