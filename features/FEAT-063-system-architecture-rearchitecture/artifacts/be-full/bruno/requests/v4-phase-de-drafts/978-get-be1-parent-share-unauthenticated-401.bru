meta {
  name: 978 [DRAFT-V4E] [LOCAL / TEST ONLY] BE1 parent shared profile requires authentication
  type: http
  seq: 978
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/any-child/parent-share
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert unauthenticated refusal", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

