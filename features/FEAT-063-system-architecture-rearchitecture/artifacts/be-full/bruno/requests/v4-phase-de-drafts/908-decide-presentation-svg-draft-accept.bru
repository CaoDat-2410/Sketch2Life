meta {
  name: 908 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher accepts presentation SVG draft
  type: http
  seq: 908
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts/{{phase_de_e1_svg_draft_id}}/decision
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: {{phase_de_e1_svg_draft_etag}}
  Idempotency-Key: {{phase_de_e1_svg_decide_key}}
}

body:json {
  {
    "decision": "ACCEPT"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_svg_decide_key", "e1-svg-decide-" + Date.now());
  if (!bru.getVar("phase_de_e1_svg_draft_etag")) {
    bru.setVar("phase_de_e1_svg_draft_etag", '"1"');
  }
}

script:post-response {
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e1_svg_draft_etag", etag);
  }
}

tests {
  test("assert SVG draft accept contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.equal('"2"');
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("PresentationSvgDraftV1");
    expect(body.state).to.equal("ACCEPTED");
    expect(body.revision).to.equal(2);
  });
}

docs {
