meta {
  name: 1017 [DRAFT-V4E] [LOCAL / TEST ONLY] Create presentation revision rejects weak If-Match 400
  type: http
  seq: 1017
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: W/"1"
  Idempotency-Key: e1-rev-weak-if-match
}

body:json {
  {
    "repin_to_current_plan": false,
    "operations": [
      {
        "op": "UPDATE_SLIDE",
        "slide_id": "{{phase_de_e1_slide_id}}",
        "title": "Weak ETag Check"
      }
    ]
  }
}

tests {
  test("assert weak If-Match refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors[0].field).to.equal("If-Match");
    expect(body.field_errors[0].code).to.equal("INVALID_FORMAT");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Responsible Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: lesson occurrence phase_de_e1_occurrence_id
  Expected: 400 / INVALID_REQUEST (field_errors If-Match INVALID_FORMAT)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py
}
