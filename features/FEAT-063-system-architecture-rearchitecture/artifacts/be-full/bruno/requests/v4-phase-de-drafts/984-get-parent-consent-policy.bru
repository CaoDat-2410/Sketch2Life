meta {
  name: 984 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent reads placeholder consent policy
  type: http
  seq: 984
}

get {
  url: {{baseUrl}}/v1/parent/consent-policy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert consent policy contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentConsentPolicyV1");
    expect(body.policy.policy_state).to.equal("PLACEHOLDER_NOT_APPROVED");
    expect(body.policy.data_origin_scope).to.equal("SYNTHETIC_TEST");
    expect(body.policy.acceptance_recording).to.equal("NOT_AVAILABLE");
  });
}

docs {
