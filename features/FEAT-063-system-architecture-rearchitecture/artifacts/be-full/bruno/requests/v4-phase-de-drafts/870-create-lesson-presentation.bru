meta {
  name: 870 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher initializes lesson presentation
  type: http
  seq: 870
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_create_key}}
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_create_key", "e1-create-" + Date.now());
}

script:post-response {
  const body = res.getBody();
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e1_etag", etag);
  }
  if (body && body.head && typeof body.head.revision_no === "number") {
    bru.setVar("phase_de_e1_revision_no", String(body.head.revision_no));
  }
  if (body && body.head && Array.isArray(body.head.slides) && body.head.slides.length > 0 && body.head.slides[0].slide_id) {
    bru.setVar("phase_de_e1_slide_id", body.head.slides[0].slide_id);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.equal('"1"');
    expect(res.getHeader("Location")).to.include("/presentation");
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonPresentationV1");
    expect(body.occurrence_id).to.equal(bru.getVar("phase_de_e1_occurrence_id"));
    expect(body.revision).to.equal(1);
    expect(body.head_revision_no).to.equal(1);
    expect(body.ready_revision_no).to.equal(null);
    expect(body.presentable).to.equal(false);
    expect(body.head.state).to.equal("DRAFT");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: disposable lesson occurrence phase_de_e1_occurrence_id owned by Teacher with no presentation yet; saves phase_de_e1_create_key, phase_de_e1_etag, phase_de_e1_revision_no, phase_de_e1_slide_id
  Expected: 201 / LessonPresentationV1 (ETag: "1", Cache-Control: private, no-cache, Vary: Authorization)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py:1-359, backend/src/sketch2life/contracts/schemas/lesson_presentations.py:1-251
}
