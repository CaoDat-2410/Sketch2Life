meta {
  name: 900 [DRAFT-V4E] [LOCAL / TEST ONLY] SVG draft request fails closed on default runtime (503)
  type: http
  seq: 900
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/svg-drafts
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_svg_unavail_key}}
}

body:json {
  {
    "plan_activity_id": "{{phase_de_e1_plan_activity_id}}",
    "subject_text": "butterfly"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_svg_unavail_key", "e1-svg-unavail-" + Date.now());
}

tests {
  test("assert fail-closed default SVG drafter refusal", function () {
    expect(res.getStatus()).to.equal(503);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("PROVIDER_UNAVAILABLE");
  });
}

