meta {
  name: 1011 [DRAFT-V4E] [LOCAL / TEST ONLY] Init lesson presentation rejects duplicate presentation 409
  type: http
  seq: 1011
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_dup_create_key}}
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_dup_create_key", "e1-dup-create-" + Date.now());
}

tests {
  test("assert duplicate presentation conflict", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_CONFLICT");
  });
}

docs {
