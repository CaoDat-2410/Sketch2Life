meta {
  name: 809 [DRAFT-V4D] [LOCAL / TEST ONLY] Reject anonymous Teacher invitation request
  type: http
  seq: 809
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/teacher-invitations
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "email": "{{phase_de_invite_email}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

