meta {
  name: 995 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent lesson feedback rejects blank text
  type: http
  seq: 995
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e6-feedback-blank-key
}

body:json {
  {
    "feedback_text": "   "
  }
}

tests {
  test("assert blank feedback validation refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

