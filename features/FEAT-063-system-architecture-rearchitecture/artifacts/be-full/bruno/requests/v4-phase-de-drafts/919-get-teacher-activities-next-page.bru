meta {
  name: 919 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher fetches next page of org lesson activities
  type: http
  seq: 919
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/activities?limit=1&cursor={{phase_de_e2_activities_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert next page contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    expect(res.getBody().contract).to.equal("TeacherActivityPageV1");
  });
}

