meta {
  name: 962 [DRAFT-V4E] [LOCAL / TEST ONLY] Revoking already revoked share grant fails 409
  type: http
  seq: 962
}

post {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/revoke
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: {{phase_de_e3_grant_etag}}
  Idempotency-Key: {{phase_de_e3_revoke_again_key}}
}

script:pre-request {
  bru.setVar("phase_de_e3_revoke_again_key", "e3-revoke-again-" + Date.now());
}

tests {
  test("assert invalid state transition refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

