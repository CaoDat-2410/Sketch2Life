meta {
  name: 1056 [DRAFT-V4E] [LOCAL / TEST ONLY] Parent submits follow-up feedback message on owned lesson
  type: http
  seq: 1056
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e6_followup_key}}
}

body:json {
  {
    "feedback_text": "Follow-up feedback message appending to existing thread."
  }
}

script:pre-request {
  bru.setVar("phase_de_e6_followup_key", "e6-followup-" + Date.now());
}

tests {
  test("assert follow-up feedback bumps revision", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentLessonFeedbackV1");
    expect(body.lesson_id).to.equal(bru.getVar("phase_de_e6_lesson_id"));
    expect(body.revision).to.be.at.least(2);
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: run after 993 on same phase_de_e6_lesson_id with a fresh Idempotency-Key
  Expected: 201 / ParentLessonFeedbackV1 (revision >= 2, Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_feedback.py, backend/src/sketch2life/infrastructure/lesson_library/feedback.py
}
