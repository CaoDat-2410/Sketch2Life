meta {
  name: 951 [DRAFT-V4E] [LOCAL / TEST ONLY] Owning Parent lists share grants for child profile
  type: http
  seq: 951
}

get {
  url: {{baseUrl}}/v1/parent/share-grants?profile_id={{phase_de_e3_profile_id}}&limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert list response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentShareGrantListV1");
    expect(body.items).to.be.an("array");
  });
}

