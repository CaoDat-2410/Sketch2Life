meta {
  name: 821 [DRAFT-V4D] [LOCAL / TEST ONLY] Reject reassignment key reused with different candidate
  type: http
  seq: 821
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_de_transfer_class_id}}/assignments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_de_transfer_expected_rev}}"
  Idempotency-Key: {{phase_de_reassign_key}}
}

body:json {
  {
    "candidate_ref": "{{phase_de_transfer_other_candidate_ref}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

