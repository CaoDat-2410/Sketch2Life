meta {
  name: 956 [DRAFT-V4E] [LOCAL / TEST ONLY] Owning Parent gets share grant detail (no code)
  type: http
  seq: 956
}

get {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e3_grant_etag", etag);
  }
}

tests {
  test("assert detail response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.be.a("string");
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentShareGrantV1");
    expect(body.share_grant_id).to.equal(bru.getVar("phase_de_e3_share_grant_id"));
    expect(body.invitation_code == null).to.equal(true);
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: run after 945 using phase_de_e3_share_grant_id; refreshes phase_de_e3_grant_etag
  Expected: 200 / ParentShareGrantV1 without invitation_code (ETag, Cache-Control: private, no-cache)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_share_grants.py
}
