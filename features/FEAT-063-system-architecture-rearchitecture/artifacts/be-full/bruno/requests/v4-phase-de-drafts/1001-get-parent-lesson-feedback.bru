meta {
  name: 1001 [DRAFT-V4E] [LOCAL / TEST ONLY] Owning Parent gets lesson feedback state
  type: http
  seq: 1001
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert feedback state contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getBody().contract).to.equal("ParentLessonFeedbackStateV1");
  });
}

docs {
