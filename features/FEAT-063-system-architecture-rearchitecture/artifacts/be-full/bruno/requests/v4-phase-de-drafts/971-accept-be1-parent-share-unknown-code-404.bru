meta {
  name: 971 [DRAFT-V4E] [LOCAL / TEST ONLY] Accept parent-share rejects unknown invitation code
  type: http
  seq: 971
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e3_child_id}}/parent-share/accept
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e3_unknown_accept_key}}
}

body:json {
  {
    "invitation_code": "INVALID-CODE-000"
  }
}

script:pre-request {
  bru.setVar("phase_de_e3_unknown_accept_key", "e3-unknown-accept-" + Date.now());
}

tests {
  test("assert unknown invitation code refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

docs {
