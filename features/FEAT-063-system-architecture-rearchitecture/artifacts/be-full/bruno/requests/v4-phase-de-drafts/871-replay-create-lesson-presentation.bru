meta {
  name: 871 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher replays lesson presentation init
  type: http
  seq: 871
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_create_key}}
}

body:json {
  {
    "seed": "PLAN_ACTIVITIES"
  }
}

tests {
  test("assert idempotent replay contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.equal('"1"');
    expect(res.getHeader("Vary")).to.include("Authorization");
    expect(res.getBody().contract).to.equal("LessonPresentationV1");
  });
}

