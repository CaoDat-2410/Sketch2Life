meta {
  name: 965 [DRAFT-V4E] [LOCAL / TEST ONLY] Owning Parent lists share grant deliveries
  type: http
  seq: 965
}

get {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/deliveries?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert deliveries list contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentShareDeliveryListV1");
    expect(body.share_grant_id).to.equal(bru.getVar("phase_de_e3_share_grant_id"));
    expect(["AVAILABLE", "ENDED"]).to.include(body.content_access);
    expect(body.items).to.be.an("array");
  });
}

