meta {
  name: 945 [DRAFT-V4E] [LOCAL / TEST ONLY] Owning Parent creates profile share grant
  type: http
  seq: 945
}

post {
  url: {{baseUrl}}/v1/parent/share-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e3_grant_key}}
}

body:json {
  {
    "profile_id": "{{phase_de_e3_profile_id}}",
    "granted_fields": [
      "DISPLAY_NAME",
      "AGE_BAND"
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e3_grant_key", "e3-grant-" + Date.now());
}

script:post-response {
  const body = res.getBody();
  if (body && typeof body.share_grant_id === "string") {
    bru.setVar("phase_de_e3_share_grant_id", body.share_grant_id);
  }
  if (body && typeof body.invitation_code === "string") {
    bru.setVar("phase_de_e3_invitation_code", body.invitation_code);
  }
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e3_grant_etag", etag);
  }
}

tests {
  test("assert share grant creation contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.equal('"1"');
    expect(res.getHeader("Location")).to.include("/share-grants/");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentShareGrantV1");
    expect(body.state).to.equal("INVITED");
    expect(body.invitation_code).to.be.a("string");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: synthetic Parent child profile phase_de_e3_profile_id; saves phase_de_e3_grant_key, phase_de_e3_share_grant_id, phase_de_e3_invitation_code, phase_de_e3_grant_etag
  Expected: 201 / ParentShareGrantV1 (ParentShareGrantCreatedV1 inherits contract="ParentShareGrantV1" in profile_sharing.py at 98aa9837; state: INVITED, invitation_code populated on first issue, ETag: "1")
  Source: backend/src/sketch2life/interfaces/http/routers/parent_share_grants.py, backend/src/sketch2life/contracts/schemas/profile_sharing.py, backend/src/sketch2life/infrastructure/profile_sharing/service.py
}
