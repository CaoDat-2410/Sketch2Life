meta {
  name: 837 [DRAFT-V4D] [LOCAL / TEST ONLY] Manager polls Teacher assignment transfer status
  type: http
  seq: 837
}

get {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_de_transfer_class_id}}/assignment-transfers/{{phase_de_transfer_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1TeacherAssignmentTransferStatusV1");
    expect(body.transfer_id).to.equal(bru.getVar("phase_de_transfer_id"));
    expect(["TRANSFER_PENDING", "RECONCILE_REQUIRED", "COMPLETED", "OFFBOARDED", "COMPENSATED_CONFLICT"]).to.include(body.state);
  });
}

