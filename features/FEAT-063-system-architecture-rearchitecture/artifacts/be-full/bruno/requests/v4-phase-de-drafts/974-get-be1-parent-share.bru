meta {
  name: 974 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher reads active Parent shared profile
  type: http
  seq: 974
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{phase_de_e3_child_id}}/parent-share
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert shared profile response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ParentSharedProfileV1");
    expect(body.granted_fields).to.be.an("array");
    expect(body.fields).to.be.an("object");
    const allowed = new Set(body.granted_fields.map(function (f) { return f.toLowerCase(); }));
    Object.keys(body.fields).forEach(function (k) {
      expect(allowed.has(k)).to.equal(true);
    });
  });
}

