meta {
  name: 1013 [DRAFT-V4E] [LOCAL / TEST ONLY] Init lesson presentation rejects Idempotency-Key payload mismatch 400
  type: http
  seq: 1013
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_e1_create_key}}
}

body:json {
  {
    "seed": "BLANK"
  }
}

tests {
  test("assert idempotency key payload mismatch refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

