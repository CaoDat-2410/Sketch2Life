meta {
  name: 801 [DRAFT-V4D] [LOCAL / TEST ONLY] Manager invites Teacher with synthetic address (fixture)
  type: http
  seq: 801
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/teacher-invitations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_invite_key}}
}

body:json {
  {
    "email": "{{phase_de_invite_email}}"
  }
}

script:pre-request {
  bru.setVar("phase_de_invite_key", "t6a-invite-" + Date.now());
}

script:post-response {
  const body = res.getBody();
  if (typeof body.account_ref === "string") {
    bru.setVar("phase_de_invited_account_ref", body.account_ref);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    expect(res.getBody().account_ref).to.be.a("string");
    expect(res.getBody().status).to.equal("PENDING_VERIFICATION");
  });
}

docs {
  DRAFT after Phase D/E: checked against the code in .worktrees/v4d at 9e439cee; not yet run against a live backend.
  Role: Assigned School Manager - set bearerToken to seed-mgr-a token
  Needs: needs-fixture: organization_id=seed-org-a, synthetic .test address in phase_de_invite_email, identity provisioner and profile_receipt_hmac_key configured; saves phase_de_invite_key, phase_de_invited_account_ref
  Expected: 202 / TeacherInvitationResponse (PENDING_VERIFICATION, Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/teacher_invitations.py:81-180, backend/src/sketch2life/application/services/teacher_invitations.py:51-344
}
