meta {
  name: 1016 [DRAFT-V4E] [LOCAL / TEST ONLY] Get presentation returns 404 when none exists yet
  type: http
  seq: 1016
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_no_pres_occurrence_id}}/presentation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert missing presentation 404", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

