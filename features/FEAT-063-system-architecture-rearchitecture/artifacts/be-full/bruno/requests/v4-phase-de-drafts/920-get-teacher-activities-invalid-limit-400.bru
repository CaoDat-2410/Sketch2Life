meta {
  name: 920 [DRAFT-V4E] [LOCAL / TEST ONLY] List org lesson activities rejects limit above 100
  type: http
  seq: 920
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/activities?limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert invalid limit refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

