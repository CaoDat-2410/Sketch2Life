meta {
  name: 1005 [DRAFT-V4E] [LOCAL / TEST ONLY] Owning Parent lists feedback replies for lesson
  type: http
  seq: 1005
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{phase_de_e6_lesson_id}}/feedback/replies?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert feedback replies page contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentLessonFeedbackReplyPageV1");
    expect(body.items).to.be.an("array");
  });
}

docs {
