meta {
  name: 850 [DRAFT-V4D2] [LOCAL / TEST ONLY] Create activity suggestion set rejects invalid body
  type: http
  seq: 850
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{phase_de_t2eb_run_id}}/activity-suggestions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: t2eb-invalid-body-key
}

body:json {
  {
    "expected_understanding_revision": 0,
    "unexpected": true
  }
}

tests {
  test("assert invalid body validation error", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().detail).to.equal("request contract invalid");
  });
}

