meta {
  name: 1019 [DRAFT-V4E] [LOCAL / TEST ONLY] Create presentation revision repins plan and attaches video embed
  type: http
  seq: 1019
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_stale_plan_occurrence_id}}/presentation/revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: {{phase_de_e1_stale_plan_etag}}
  Idempotency-Key: {{phase_de_e1_repin_key}}
}

body:json {
  {
    "repin_to_current_plan": true,
    "operations": [
      {
        "op": "ADD_SLIDE",
        "after_slide_id": null,
        "title": "New Intro Slide",
        "body_text": "Repinned to current plan."
      },
      {
        "op": "SET_MEDIA",
        "slide_id": "{{phase_de_e1_stale_plan_slide_id}}",
        "placement": "FULL",
        "media": {
          "kind": "VIDEO_EMBED",
          "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
        }
      }
    ]
  }
}

script:pre-request {
  bru.setVar("phase_de_e1_repin_key", "e1-rev-repin-" + Date.now());
  if (!bru.getVar("phase_de_e1_stale_plan_etag")) {
    bru.setVar("phase_de_e1_stale_plan_etag", '"1"');
  }
}

tests {
  test("assert repin and video embed revision contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonPresentationV1");
    expect(body.head.state).to.equal("DRAFT");
    expect(body.head.source_state).to.equal("CURRENT");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Responsible Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: presentation with superseded plan on phase_de_e1_stale_plan_occurrence_id
  Expected: 201 / LessonPresentationV1 (repin_to_current_plan=true, source_state=CURRENT)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py, backend/src/sketch2life/contracts/schemas/lesson_presentations.py
}
