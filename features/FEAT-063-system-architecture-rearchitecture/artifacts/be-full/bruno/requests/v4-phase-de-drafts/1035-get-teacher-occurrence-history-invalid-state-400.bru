meta {
  name: 1035 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher occurrence history rejects invalid state filter 400
  type: http
  seq: 1035
}

get {
  url: {{baseUrl}}/api/teacher/v1/organizations/{{organization_id}}/history?state=INVALID
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert invalid state enum refusal", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

