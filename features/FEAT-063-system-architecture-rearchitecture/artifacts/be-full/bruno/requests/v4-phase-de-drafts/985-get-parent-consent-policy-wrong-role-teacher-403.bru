meta {
  name: 985 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher forbidden from Parent consent policy
  type: http
  seq: 985
}

get {
  url: {{baseUrl}}/v1/parent/consent-policy
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert teacher role refusal", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

