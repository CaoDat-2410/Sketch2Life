meta {
  name: 834 [DRAFT-V4D] [LOCAL / TEST ONLY] Reject Teacher offboarding with stale If-Match
  type: http
  seq: 834
}

delete {
  url: {{baseUrl}}/api/be1/v1/classes/seed-org-a-class-1/assignments/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "999999"
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("STALE_REVISION");
  });
}

