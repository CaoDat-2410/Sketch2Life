meta {
  name: 873 [DRAFT-V4E] [LOCAL / TEST ONLY] Init lesson presentation rejects invalid seed
  type: http
  seq: 873
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e1-invalid-seed-key
}

body:json {
  {
    "seed": "INVALID_SEED"
  }
}

tests {
  test("assert invalid seed validation error", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

