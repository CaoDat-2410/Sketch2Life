meta {
  name: 877 [DRAFT-V4E] [LOCAL / TEST ONLY] Assigned Teacher gets lesson presentation
  type: http
  seq: 877
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const etag = res.getHeader("ETag");
  if (etag) {
    bru.setVar("phase_de_e1_get_etag", etag);
  }
  const body = res.getBody();
  if (body && typeof body.revision === "number") {
    bru.setVar("phase_de_e1_etag", '"' + body.revision + '"');
  }
  if (body && body.head && typeof body.head.revision_no === "number") {
    bru.setVar("phase_de_e1_revision_no", String(body.head.revision_no));
  }
  if (body && body.head && Array.isArray(body.head.slides) && body.head.slides.length > 0 && body.head.slides[0].slide_id) {
    bru.setVar("phase_de_e1_slide_id", body.head.slides[0].slide_id);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.match(/^W\/"[0-9a-f]{12}"$/);
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    expect(res.getHeader("Vary")).to.include("Authorization");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonPresentationV1");
    expect(body.occurrence_id).to.equal(bru.getVar("phase_de_e1_occurrence_id"));
    expect(body.revision).to.be.a("number");
    expect(body.head_revision_no).to.be.a("number");
    expect(body.presentable).to.be.a("boolean");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: run after 870 using phase_de_e1_occurrence_id; saves weak validator in phase_de_e1_get_etag and refreshes strong phase_de_e1_etag, phase_de_e1_revision_no, phase_de_e1_slide_id
  Expected: 200 / LessonPresentationV1 (weak ETag W/"...", Cache-Control: private, no-cache, Vary: Authorization)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_presentations.py
}
