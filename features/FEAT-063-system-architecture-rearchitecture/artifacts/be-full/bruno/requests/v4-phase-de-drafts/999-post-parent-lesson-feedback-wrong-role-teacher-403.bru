meta {
  name: 999 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher gets 403 ACCOUNT_SCOPE_UNAVAILABLE posting Parent feedback
  type: http
  seq: 999
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/any-lesson-id/feedback
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: e6-fb-wrong-role-key
}

body:json {
  {
    "feedback_text": "Synthetic wrong role check."
  }
}

tests {
  test("assert non-parent scope refusal", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACCOUNT_SCOPE_UNAVAILABLE");
  });
}

