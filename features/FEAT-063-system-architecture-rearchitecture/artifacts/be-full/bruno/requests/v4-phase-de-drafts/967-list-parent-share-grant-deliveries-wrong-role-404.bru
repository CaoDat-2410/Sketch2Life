meta {
  name: 967 [DRAFT-V4E] [LOCAL / TEST ONLY] Teacher gets 404 listing Parent share deliveries
  type: http
  seq: 967
}

get {
  url: {{baseUrl}}/v1/parent/share-grants/{{phase_de_e3_share_grant_id}}/deliveries
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert non-parent role refusal", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

