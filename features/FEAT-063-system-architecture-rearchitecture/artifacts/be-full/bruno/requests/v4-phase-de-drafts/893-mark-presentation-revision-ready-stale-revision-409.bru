meta {
  name: 893 [DRAFT-V4E] [LOCAL / TEST ONLY] Mark presentation revision ready rejects stale ETag
  type: http
  seq: 893
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{phase_de_e1_occurrence_id}}/presentation/revisions/{{phase_de_e1_revision_no}}/ready
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "999999"
  Idempotency-Key: {{phase_de_e1_ready_stale_key}}
}

script:pre-request {
  bru.setVar("phase_de_e1_ready_stale_key", "e1-ready-stale-" + Date.now());
}

tests {
  test("assert stale revision refusal", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.match(/^"[1-9][0-9]*"$/);
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.be.a("number");
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Phase E code at 98aa9837 (PHASE_E_FINAL_ROUTE_LIST_20261125.md / 784134fc); not yet run against a live backend.
