meta {
  name: 860 [DRAFT-V4D2] [LOCAL / TEST ONLY] Parent selects activity from AI suggestion set (Hybrid B)
  type: http
  seq: 860
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{phase_de_t2eb_run_id}}/activity-selection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_de_t2eb_select_key}}
}

body:json {
  {
    "suggestion_set_id": "{{phase_de_t2eb_suggestion_set_id}}",
    "expected_understanding_revision": {{phase_de_t2eb_understanding_rev}},
    "activity_index": {{phase_de_t2eb_activity_index}}
  }
}

script:pre-request {
  bru.setVar("phase_de_t2eb_select_key", "t2eb-select-" + Date.now());
  if (!bru.getVar("phase_de_t2eb_understanding_rev")) {
    bru.setVar("phase_de_t2eb_understanding_rev", "1");
  }
  if (!bru.getVar("phase_de_t2eb_activity_index")) {
    bru.setVar("phase_de_t2eb_activity_index", "0");
  }
}

tests {
  test("assert Hybrid B activity selection receipt contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("ParentActivitySelectionReceiptV1");
    expect(body.story_run_id).to.equal(bru.getVar("phase_de_t2eb_run_id"));
    expect(body.suggestion_set_id).to.equal(bru.getVar("phase_de_t2eb_suggestion_set_id"));
    expect(body.activity_selection_id).to.be.a("string");
    expect(body.selection_revision).to.be.at.least(1);
  });
}

docs {
  DRAFT after Phase D/E: checked against committed Hybrid B code at 68c0fdf3; not yet run against a live backend.
  Role: Owning Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: run after 845 using phase_de_t2eb_run_id, phase_de_t2eb_suggestion_set_id, phase_de_t2eb_understanding_rev, and phase_de_t2eb_activity_index; saves phase_de_t2eb_select_key
  Expected: 200 / ParentActivitySelectionReceiptV1
  Source: backend/src/sketch2life/interfaces/http/routers/parent_ai.py, backend/src/sketch2life/contracts/schemas/parent_activity_selection.py
  The response receipt includes persisted_at as an ISO 8601 timestamp parsed from the stored JSON receipt.
}
