meta {
  name: 024 [POST/ACTION - LOCAL TEST ONLY] Upload Session Artifact
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/sessions/{{session_id}}/artifacts
  body: multipart-form
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

body:multipart-form {
  file: @file(./fixtures/REPLACE_WITH_SYNTHETIC_FILE) @contentType(application/octet-stream)
}
