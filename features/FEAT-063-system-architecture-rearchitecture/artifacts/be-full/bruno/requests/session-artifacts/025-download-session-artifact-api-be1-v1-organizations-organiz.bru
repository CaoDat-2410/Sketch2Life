meta {
  name: 025 [READ ONLY] Download Session Artifact
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/sessions/{{session_id}}/artifacts/{{asset_ref}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}
