meta {
  name: 231 [LOCAL / TEST ONLY] Reuse abort key with changed If-Match
  type: http
  seq: 231
}

delete {
  url: {{baseUrl}}/v1/upload-sessions/{{abort_upload_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: {{abort_etag_final}}
  Idempotency-Key: {{upload_abort_key}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}
