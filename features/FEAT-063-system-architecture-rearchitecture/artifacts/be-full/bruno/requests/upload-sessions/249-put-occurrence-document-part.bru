meta {
  name: 249 [LOCAL / TEST ONLY] Upload occurrence document part
  type: http
  seq: 249
}

put {
  url: {{baseUrl}}/v1/upload-sessions/{{occurrence_doc_upload_id}}/parts/1
  body: file
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/octet-stream
  X-Part-SHA256: 6cfaace76ba33bc57672888a60a9b7626b73b3366e2a40e1e727deb3f04d8539
}

body:file {
  file: @file(D:/GitHub/Sketch2Life/tmp/bruno-fixtures/lesson-document-minimal.pdf)
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
  });
}
