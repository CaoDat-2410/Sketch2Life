meta {
  name: 222 [LOCAL / TEST ONLY] Complete Parent artwork upload
  type: http
  seq: 222
}

post {
  url: {{baseUrl}}/v1/upload-sessions/{{generic_upload_id}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{upload_complete_key}}
}

body:json {
  {
    "expected_size_bytes": 69,
    "expected_sha256": "d3c936ebdd73f46e6422d5946044c99d524554082272019ab738800318b04892"
  }
}

script:post-response {
  bru.setVar("generic_upload_etag", res.getHeader("ETag"));
  bru.setVar("generic_asset_ref", res.getBody().asset_ref);
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().state).to.equal("COMPLETED");
    expect(res.getBody().asset_ref).to.match(/^upl_/);
  });
}
