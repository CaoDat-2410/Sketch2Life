meta {
  name: 224 [LOCAL / TEST ONLY] Create upload session for abort flow
  type: http
  seq: 224
}

post {
  url: {{baseUrl}}/v1/upload-sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "purpose": "RUN_ARTWORK",
    "target_ref": "{{parent_story_run_id}}",
    "media_type": "image/png",
    "expected_size_bytes": 69,
    "expected_sha256": "d3c936ebdd73f46e6422d5946044c99d524554082272019ab738800318b04892",
    "file_name": "lesson-artwork-abort.png"
  }
}

script:post-response {
  bru.setVar("abort_upload_id", res.getBody().upload_id);
  bru.setVar("abort_etag_initial", res.getHeader("ETag"));
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
  });
}
