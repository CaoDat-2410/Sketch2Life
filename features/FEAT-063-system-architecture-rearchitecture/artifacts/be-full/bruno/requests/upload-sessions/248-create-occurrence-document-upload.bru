meta {
  name: 248 [LOCAL / TEST ONLY] Create occurrence document upload
  type: http
  seq: 248
}

post {
  url: {{baseUrl}}/v1/upload-sessions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "purpose": "OCCURRENCE_DOCUMENT",
    "target_ref": "{{occurrence_id}}",
    "media_type": "application/pdf",
    "expected_size_bytes": 48,
    "expected_sha256": "6cfaace76ba33bc57672888a60a9b7626b73b3366e2a40e1e727deb3f04d8539",
    "file_name": "lesson-document-minimal.pdf"
  }
}

script:post-response {
  bru.setVar("occurrence_doc_upload_id", res.getBody().upload_id);
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
  });
}
