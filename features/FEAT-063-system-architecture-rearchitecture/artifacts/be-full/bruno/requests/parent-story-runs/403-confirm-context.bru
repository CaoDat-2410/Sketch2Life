meta {
  name: 403 [LOCAL / TEST ONLY] Confirm StoryRun context
  type: http
  seq: 403
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": {{story_context_revision}},
    "context_snapshot_sha256": "{{story_context_hash}}",
    "confirmed": true
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().story_run.context_confirmed).to.equal(true);
  });
}
