meta {
  name: 400 [LOCAL / TEST ONLY] Create Parent StoryRun
  type: http
  seq: 400
}

post {
  url: {{baseUrl}}/v1/story-runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "parent_profile_id": "{{parent_profile_id}}",
    "topic": "A paper kite",
    "adult_confirmed_idea": "A child draws a bright kite",
    "lesson_version": null
  }
}

script:post-response {
  const story = res.getBody().story_run;
  bru.setVar("parent_story_run_id", story.run_id);
  bru.setVar("story_context_revision", String(story.context_revision));
  bru.setVar("story_context_hash", story.context_snapshot_sha256);
  if (story.understanding_revision !== null) bru.setVar("story_understanding_revision", String(story.understanding_revision));
  if (story.story_revision_no !== null) bru.setVar("story_revision_no", String(story.story_revision_no));
  if (story.story_sha256 !== null) bru.setVar("story_sha256", story.story_sha256);
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody().story_run;
    expect(body.run_id).to.be.a("string");
    expect(body.parent_profile_id).to.equal(bru.getVar("parent_profile_id"));
  });
}

docs {
  For the optional lesson_version pin, a currently shared lesson can be resolved through this active Parent subject/account alias.
}
