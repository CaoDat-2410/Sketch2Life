meta {
  name: 281 [LOCAL / TEST ONLY] Read current active Parent StoryRun
  type: http
  seq: 281
}

get {
  url: {{baseUrl}}/v1/story-runs/active/current
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody()).to.have.property("story_run");
  });
}

