meta {
  name: 283 [LOCAL / TEST ONLY] Cancel Parent StoryRun with revision and key
  type: http
  seq: 283
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/cancel
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{phase_b_story_run_revision}}
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().lifecycle).to.be.an("object");
  });
}

