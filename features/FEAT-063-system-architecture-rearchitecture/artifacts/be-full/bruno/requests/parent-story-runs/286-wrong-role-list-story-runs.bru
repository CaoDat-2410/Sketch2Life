meta {
  name: 286 [LOCAL / TEST ONLY] Teacher gets uniform StoryRun not-found on history
  type: http
  seq: 286
}

get {
  url: {{baseUrl}}/v1/story-runs?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

