meta {
  name: 284 [LOCAL / TEST ONLY] Delete completed Parent StoryRun
  type: http
  seq: 284
}

delete {
  url: {{baseUrl}}/v1/story-runs/{{completed_story_run_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().lifecycle).to.be.an("object");
  });
}

