meta {
  name: 285 [LOCAL / TEST ONLY] Teacher gets uniform StoryRun not-found on create
  type: http
  seq: 285
}

post {
  url: {{baseUrl}}/v1/story-runs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_b_wrong_role_story_key}}
}

body:json {
  {
    "parent_profile_id": "{{parent_profile_id}}",
    "topic": "A paper kite",
    "adult_confirmed_idea": "A child draws a bright kite",
    "lesson_version": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

