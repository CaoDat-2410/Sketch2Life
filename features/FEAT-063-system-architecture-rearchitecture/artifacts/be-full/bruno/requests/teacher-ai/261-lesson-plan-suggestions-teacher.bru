meta {
  name: 261 [LOCAL / TEST ONLY] Teacher lesson-plan suggestion route control
  type: http
  seq: 261
}

post {
  url: {{baseUrl}}/api/teacher/v1/organizations/{{organization_id}}/ai/lesson-plan-suggestions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "topic": "Butterflies",
    "target_age_months": 60,
    "objectives": ["Notice butterfly wings"],
    "drawing_subject": "A butterfly on a flower",
    "activity_count": 1,
    "activity_kind": "indoor",
    "script_following_allowed": false,
    "script_direction": null
  }
}

tests {
  test("assert response contract", function () {
    expect([200, 503]).to.include(res.getStatus());
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    if (res.getStatus() === 503) expect(res.getBody().code).to.equal("MODAL_AI_NOT_ENABLED");
    if (res.getStatus() === 200) expect(res.getBody().status).to.equal("DRAFT");
  });
}

