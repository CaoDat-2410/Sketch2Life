meta {
  name: 264 [LOCAL / TEST ONLY] Parent account is outside Teacher AI scope
  type: http
  seq: 264
}

post {
  url: {{baseUrl}}/api/teacher/v1/organizations/{{organization_id}}/ai/lesson-plan-suggestions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "topic": "Butterflies",
    "target_age_months": 60,
    "objectives": ["Notice butterfly wings"],
    "drawing_subject": "A butterfly on a flower",
    "activity_count": 1,
    "activity_kind": "indoor",
    "script_following_allowed": false,
    "script_direction": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

