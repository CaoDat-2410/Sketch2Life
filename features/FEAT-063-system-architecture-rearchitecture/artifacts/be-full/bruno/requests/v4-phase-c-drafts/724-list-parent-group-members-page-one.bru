meta {
  name: 724 [DRAFT-V4C] [LOCAL / TEST ONLY] Manager lists parent-group members page one with counts
  type: http
  seq: 724
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/seed-pg-a-1/members?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (typeof body.next_cursor === "string") {
    bru.setVar("phase_c_group_members_cursor", body.next_cursor);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentGroupMemberPageV1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.equal(1);
    const item = body.items[0];
    expect(item.membership_id).to.be.a("string");
    expect(item.parent_group_id).to.equal("seed-pg-a-1");
    expect(["INVITED", "ACCEPTED", "DECLINED", "REVOKED", "EXPIRED"]).to.include(item.state);
    expect(item.invited_at).to.be.a("string");
    expect(item.revision).to.be.at.least(1);
    expect(item).to.not.have.property("contract");
    expect(item).to.not.have.property("revision_source");
    expect(item).to.not.have.property("parent_principal_ref");
    expect(item).to.not.have.property("email");
    expect(item).to.not.have.property("phone");
    expect(item).to.not.have.property("child_id");
    expect(item).to.not.have.property("child_name");
    const counts = body.counts;
    expect(counts.invited).to.be.a("number");
    expect(counts.accepted).to.be.at.least(1);
    expect(counts.declined).to.be.a("number");
    expect(counts.revoked).to.be.at.least(1);
    expect(counts.expired).to.be.a("number");
    expect(counts.total).to.equal(
      counts.invited + counts.accepted + counts.declined + counts.revoked + counts.expired
    );
    expect(body.next_cursor).to.be.a("string");
  });
}

docs {
  DRAFT: written from the Phase C code at f031fc70; not yet run against a live backend.
  Role: Assigned School Manager - set bearerToken to seed-mgr-a token
  Needs: organization_id=seed-org-a, seeded seed-pg-a-1 (has seed-pgm-1-p1 active and seed-pgm-1-p2 revoked); saves phase_c_group_members_cursor for 725, 728
  Expected: 200 / ParentGroupMemberPageV1 (Cache-Control: private, no-store; counts across all states; no identity fields)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:878-903, backend/src/sketch2life/infrastructure/lesson_library/service.py:2289-2391, backend/tools/seed/data.py:428-447
}
