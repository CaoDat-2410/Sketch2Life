meta {
  name: 691 [DRAFT-V4C] [LOCAL / TEST ONLY] Teacher searches PUBLIC lessons with filters page one
  type: http
  seq: 691
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/public-lessons?q={{phase_c_public_q}}&topic={{phase_c_public_topic}}&target_age_band_ref={{phase_c_public_age_ref}}&target_age_band_version={{phase_c_public_age_version}}&limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (typeof body.next_cursor === "string") {
    bru.setVar("phase_c_public_search_cursor", body.next_cursor);
  }
  if (Array.isArray(body.items) && body.items.length > 0) {
    bru.setVar("phase_c_public_lesson_id", body.items[0].lesson_id);
    bru.setVar("phase_c_public_version_id", body.items[0].version_id);
    bru.setVar("phase_c_public_content_hash", body.items[0].structured_content_hash);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("PublicLessonPageV1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.equal(1);
    const item = body.items[0];
    expect(item.contract).to.equal("PublicLessonSummaryV1");
    expect(item.lesson_id).to.be.a("string");
    expect(item.version_id).to.be.a("string");
    expect(item.structured_content_hash).to.match(/^[0-9a-f]{64}$/);
    expect(item.title).to.be.a("string");
    expect(item.topic).to.be.a("string");
    expect(item.target_age_band_ref).to.equal(bru.getVar("phase_c_public_age_ref"));
    expect(item.target_age_band_version).to.equal(Number(bru.getVar("phase_c_public_age_version")));
    expect(item.activity_count).to.be.at.least(1);
    expect(item.updated_at).to.be.a("string");
    expect(item).to.not.have.property("organization_id");
    expect(item).to.not.have.property("created_by");
  });
}

docs {
  DRAFT: written from the Phase C code at f031fc70; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: at least 2 approved ACTIVE VISIBLE PUBLIC lessons matching phase_c_public_q, phase_c_public_topic, phase_c_public_age_ref, phase_c_public_age_version (seed/data.py has only PENDING_REVIEW PUBLIC grant seed-gr-4); saves phase_c_public_search_cursor and first item fields for 692, 696
  Expected: 200 / PublicLessonPageV1 (Cache-Control: private, no-store; no organization_id or created_by)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:598-640, backend/src/sketch2life/infrastructure/lesson_library/service.py:3260-3317, backend/src/sketch2life/contracts/schemas/lesson_library.py:379-395
}
