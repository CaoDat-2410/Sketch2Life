meta {
  name: 702 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Parent lessons list containing NUL byte in topic
  type: http
  seq: 702
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons?topic=a%00b
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "topic", code: "INVALID_FORMAT" });
  });
}

docs {
