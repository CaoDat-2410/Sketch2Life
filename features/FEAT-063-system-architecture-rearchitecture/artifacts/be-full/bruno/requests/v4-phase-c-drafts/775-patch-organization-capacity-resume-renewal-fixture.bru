meta {
  name: 775 [DRAFT-V4C] [LOCAL / TEST ONLY] Manager resumes subscription renewal with Billing sandbox fixture
  type: http
  seq: 775
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_org_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_c_capacity_revision}}"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "resume_renewal"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && typeof body.revision === "number") {
    bru.setVar("phase_c_capacity_revision", String(body.revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1OrganizationCapacityV1");
    expect(body.subscription_state).to.equal("ACTIVE");
    expect(res.getHeader("ETag")).to.equal('"' + String(body.revision) + '"');
  });
}

docs {
  DRAFT after Phase C: checked against the code at 0f6e7683; not yet run against a live backend.
  owner: Billing/Capacity
  Role: Assigned School Manager - set bearerToken to Manager token of phase_c_capacity_org_id
  Needs: needs-fixture: SKETCH2LIFE_BILLING_SANDBOX_ENABLED=true and run after 772 (uses updated phase_c_capacity_revision)
  Expected: 200 / Be1OrganizationCapacityV1 (subscription_state ACTIVE, new ETag)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:825-934, backend/tests/integration/test_be1_capacity_postgres.py:633-640
}
