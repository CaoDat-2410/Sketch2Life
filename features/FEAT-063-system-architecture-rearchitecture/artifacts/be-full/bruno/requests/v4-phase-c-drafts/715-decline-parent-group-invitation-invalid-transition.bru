meta {
  name: 715 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Parent decline with fresh key on already active membership
  type: http
  seq: 715
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/parent-group-invitations/seed-pgm-1-p1/decline
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

