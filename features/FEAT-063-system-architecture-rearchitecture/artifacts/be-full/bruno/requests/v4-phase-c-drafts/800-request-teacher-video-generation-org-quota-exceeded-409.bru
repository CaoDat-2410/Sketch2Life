meta {
  name: 800 [DRAFT-V4C] [LOCAL / TEST ONLY] Refuse Teacher video generation with 409 VIDEO_QUOTA_EXCEEDED via Billing adapter
  type: http
  seq: 800
}

post {
  url: {{baseUrl}}/v1/story-runs/{{phase_c_qc_teacher_run_id}}/video-generations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{phase_c_qc_teacher_run_revision}},
    "story_sha256": "{{phase_c_qc_teacher_story_sha256}}",
    "quality_reason_code": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("VIDEO_QUOTA_EXCEEDED");
    expect(body.retryable).to.equal(false);
  });
}

docs {
  DRAFT after Phase C: checked against the code at 0f6e7683; not yet run against a live backend.
  Role: Responsible Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: SKETCH2LIFE_STORY_VIDEO_ADAPTERS=billing, SKETCH2LIFE_VIDEO_QUOTA_INCLUDED_UNITS_ORGANIZATION=0, 0 available Organization quota units, and confirmed Teacher StoryRun in SCRIPT_REVIEW (phase_c_qc_teacher_run_id, phase_c_qc_teacher_run_revision, phase_c_qc_teacher_story_sha256; Story quota scope is ORGANIZATION because it carries no teacher ref)
  Expected: 409 / VIDEO_QUOTA_EXCEEDED (retryable false)
  Source: backend/src/sketch2life/interfaces/http/routers/story_run_video.py:161-200, backend/src/sketch2life/infrastructure/story_video/billing_quota_admission.py:21-72, backend/tests/unit/test_story_video_billing_admission.py:30-34
}
