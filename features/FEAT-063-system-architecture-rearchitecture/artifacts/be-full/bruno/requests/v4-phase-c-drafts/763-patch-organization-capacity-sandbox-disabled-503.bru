meta {
  name: 763 [DRAFT-V4C] [LOCAL / TEST ONLY] Capacity PATCH fails closed with 503 when Billing sandbox is disabled
  type: http
  seq: 763
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "cancel_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(503);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("PROVIDER_UNAVAILABLE");
    expect(body.retryable).to.equal(true);
  });
}

docs {
  DRAFT after Phase C: checked against the code at 0f6e7683; not yet run against a live backend.
  owner: Billing/Capacity
  Role: Assigned School Manager - set bearerToken to seed-mgr-a token
  Needs: organization_id=seed-org-a with default billing_sandbox_enabled=false (_raise_capacity_admin_error maps BILLING_SANDBOX_DISABLED to 503 DEPENDENCY_UNAVAILABLE, normalized by CONV-1 error_envelope to PROVIDER_UNAVAILABLE)
  Expected: 503 / PROVIDER_UNAVAILABLE (retryable true)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:664-670,853-860, backend/src/sketch2life/interfaces/http/error_envelope.py:71, backend/tests/integration/test_be1_capacity_postgres.py:442-463
}
