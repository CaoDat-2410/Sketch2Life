meta {
  name: 776 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity PATCH with stale If-Match revision
  type: http
  seq: 776
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_org_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "cancel_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.be.at.least(2);
    expect(res.getHeader("ETag")).to.equal('"' + String(body.current_version) + '"');
  });
}

docs {
