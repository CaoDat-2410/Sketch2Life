meta {
  name: 771 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject anonymous request to capacity PATCH
  type: http
  seq: 771
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/capacity
  body: json
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "cancel_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

