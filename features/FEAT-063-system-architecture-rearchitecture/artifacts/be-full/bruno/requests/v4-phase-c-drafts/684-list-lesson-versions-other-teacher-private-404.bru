meta {
  name: 684 [DRAFT-V4C] [LOCAL / TEST ONLY] Hide other Teacher PRIVATE lesson versions with 404
  type: http
  seq: 684
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/seed-org-a/lessons/seed-lesson-l2/versions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

