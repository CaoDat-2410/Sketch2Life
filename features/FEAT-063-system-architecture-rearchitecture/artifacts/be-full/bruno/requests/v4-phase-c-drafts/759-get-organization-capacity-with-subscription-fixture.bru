meta {
  name: 759 [DRAFT-V4C] [LOCAL / TEST ONLY] Manager reads subscribed organization capacity with fixture
  type: http
  seq: 759
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_org_id}}/capacity
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (body && typeof body.revision === "number") {
    bru.setVar("phase_c_capacity_revision", String(body.revision));
  }
  if (body && body.subscription_id) {
    bru.setVar("phase_c_capacity_subscription_id", String(body.subscription_id));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1OrganizationCapacityV1");
    expect(body.organization_id).to.equal(bru.getVar("phase_c_capacity_org_id"));
    expect(body.subscription_id).to.be.a("string");
    expect(body.capacity).to.be.at.least(10);
    expect(body.active_class_count).to.be.at.least(0);
    expect(body.available_slots).to.equal(Math.max(0, body.capacity - body.active_class_count));
    expect(body.revision).to.be.at.least(1);
    expect(res.getHeader("ETag")).to.equal('"' + String(body.revision) + '"');
    expect(body).to.not.have.property("price_id");
  });
}

docs {
  DRAFT after Phase C: checked against the code at 0f6e7683; not yet run against a live backend.
  owner: Billing/Capacity
  Role: Assigned School Manager - set bearerToken to Manager token of phase_c_capacity_org_id
  Needs: needs-fixture: organization phase_c_capacity_org_id with an active Billing subscription (revision >= 1); saves phase_c_capacity_revision and phase_c_capacity_subscription_id for 772, 775, 777
  Expected: 200 / Be1OrganizationCapacityV1 with ETag "<revision>" and Cache-Control: private, no-store
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:702-727,771-822, backend/tests/integration/test_be1_capacity_postgres.py:255-283
}
