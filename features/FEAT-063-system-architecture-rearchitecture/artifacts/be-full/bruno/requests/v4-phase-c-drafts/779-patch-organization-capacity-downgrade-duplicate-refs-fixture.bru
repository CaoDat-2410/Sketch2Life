meta {
  name: 779 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity downgrade with duplicate suspend_class_refs
  type: http
  seq: 779
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_org_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_c_capacity_revision}}"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "downgrade",
    "addon_slots": 0,
    "suspend_class_refs": [
      "{{phase_c_capacity_downgrade_class_id}}",
      "{{phase_c_capacity_downgrade_class_id}}"
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_CAPACITY_DOWNGRADE");
  });
}

