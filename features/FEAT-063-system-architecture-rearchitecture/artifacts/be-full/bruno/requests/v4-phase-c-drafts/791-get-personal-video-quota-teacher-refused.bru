meta {
  name: 791 [DRAFT-V4C] [LOCAL / TEST ONLY] Refuse Teacher on personal billing video quota endpoint with 403
  type: http
  seq: 791
}

get {
  url: {{baseUrl}}/api/be1/v1/billing/video-quota
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("BILLING_PURCHASE_NOT_ALLOWED");
  });
}

