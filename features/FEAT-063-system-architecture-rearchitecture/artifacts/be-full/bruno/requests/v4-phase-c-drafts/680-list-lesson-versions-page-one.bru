meta {
  name: 680 [DRAFT-V4C] [LOCAL / TEST ONLY] Teacher lists lesson versions page one
  type: http
  seq: 680
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/lessons/seed-lesson-l1/versions?limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (typeof body.next_cursor === "string") {
    bru.setVar("phase_c_versions_cursor", body.next_cursor);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonVersionPageV1");
    expect(body.lesson_id).to.equal("seed-lesson-l1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.equal(1);
    const item = body.items[0];
    expect(item.contract).to.equal("LessonVersionSummaryV1");
    expect(item.version_id).to.equal("seed-lv-l1-2");
    expect(item.version_no).to.equal(2);
    expect(item.review_state).to.equal("APPROVED");
    expect(item.structured_content_hash).to.match(/^[0-9a-f]{64}$/);
    expect(item.authored_principal_ref).to.equal("seed-tch-a1");
    expect(item.created_at).to.be.a("string");
    expect(item).to.not.have.property("content");
    expect(body.next_cursor).to.be.a("string");
  });
}

docs {
  DRAFT: written from the Phase C code at f031fc70; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: organization_id=seed-org-a, seeded seed-lesson-l1 (2 versions); saves phase_c_versions_cursor for 681, 683
  Expected: 200 / LessonVersionPageV1 (limit=1, version_no=2 first, Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:501-525, backend/src/sketch2life/infrastructure/lesson_library/service.py:764-820, backend/tools/seed/data.py:647-805
}
