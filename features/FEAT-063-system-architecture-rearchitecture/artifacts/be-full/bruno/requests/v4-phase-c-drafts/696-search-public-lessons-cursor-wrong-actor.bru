meta {
  name: 696 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject PUBLIC search cursor replayed by another Teacher
  type: http
  seq: 696
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/public-lessons?q={{phase_c_public_q}}&topic={{phase_c_public_topic}}&target_age_band_ref={{phase_c_public_age_ref}}&target_age_band_version={{phase_c_public_age_version}}&limit=1&cursor={{phase_c_public_search_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "cursor", code: "INVALID_FORMAT" });
  });
}

