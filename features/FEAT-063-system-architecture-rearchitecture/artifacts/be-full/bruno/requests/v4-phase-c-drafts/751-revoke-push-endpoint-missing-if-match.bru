meta {
  name: 751 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject push endpoint revoke without If-Match header
  type: http
  seq: 751
}

delete {
  url: {{baseUrl}}/v1/notifications/push-endpoints/00000000-0000-4000-8000-000000000000
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "If-Match", code: "REQUIRED" });
  });
}

