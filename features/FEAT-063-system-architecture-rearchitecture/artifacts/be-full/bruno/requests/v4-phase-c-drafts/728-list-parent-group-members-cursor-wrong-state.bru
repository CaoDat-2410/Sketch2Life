meta {
  name: 728 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Manager members cursor replayed with different state filter
  type: http
  seq: 728
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/seed-pg-a-1/members?state=ACCEPTED&limit=1&cursor={{phase_c_group_members_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "cursor", code: "INVALID_FORMAT" });
  });
}

