meta {
  name: 697 [DRAFT-V4C] [LOCAL / TEST ONLY] Hide PUBLIC search from cross-tenant Teacher with 404
  type: http
  seq: 697
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/seed-org-a/public-lessons
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

