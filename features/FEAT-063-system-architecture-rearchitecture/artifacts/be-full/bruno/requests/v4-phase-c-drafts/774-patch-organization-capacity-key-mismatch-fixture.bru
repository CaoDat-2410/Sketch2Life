meta {
  name: 774 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity PATCH when Idempotency-Key payload differs
  type: http
  seq: 774
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_org_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_c_capacity_expected_rev}}"
  Idempotency-Key: {{phase_c_capacity_patch_key}}
}

body:json {
  {
    "action": "resume_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

docs {
