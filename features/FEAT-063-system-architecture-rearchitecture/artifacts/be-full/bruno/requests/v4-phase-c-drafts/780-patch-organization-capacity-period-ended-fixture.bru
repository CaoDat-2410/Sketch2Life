meta {
  name: 780 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity PATCH after subscription period ends
  type: http
  seq: 780
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_expired_org_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_c_capacity_expired_revision}}"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "cancel_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("SUBSCRIPTION_PERIOD_ENDED");
  });
}

