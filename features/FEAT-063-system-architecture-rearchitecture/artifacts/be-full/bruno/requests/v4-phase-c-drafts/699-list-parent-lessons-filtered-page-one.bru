meta {
  name: 699 [DRAFT-V4C] [LOCAL / TEST ONLY] Parent lists lessons with query, topic, age band, and source filters
  type: http
  seq: 699
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons?source=ALL&q={{phase_c_parent_q}}&topic={{phase_c_parent_topic}}&target_age_band_ref={{phase_c_parent_age_ref}}&target_age_band_version={{phase_c_parent_age_version}}&limit=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (typeof body.next_cursor === "string") {
    bru.setVar("phase_c_parent_lessons_cursor", body.next_cursor);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentLessonPageV1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.equal(1);
    const item = body.items[0];
    expect(item.contract).to.equal("ParentLessonSummaryV1");
    expect(item.lesson_id).to.be.a("string");
    expect(item.version_id).to.be.a("string");
    expect(item.title).to.be.a("string");
    expect(item.topic).to.be.a("string");
    expect(item.target_age_band_ref).to.equal(bru.getVar("phase_c_parent_age_ref"));
    expect(item.target_age_band_version).to.equal(Number(bru.getVar("phase_c_parent_age_version")));
    expect(item.activity_count).to.be.at.least(1);
    expect(["PUBLIC", "SHARED"]).to.include(item.access_source);
  });
}

docs {
  DRAFT: written from the Phase C code at f031fc70; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: at least 2 active PUBLIC or accepted SHARED lessons visible to seed-parent-p1 matching phase_c_parent_* filters (seed/data.py has no active Parent grant for p1); saves phase_c_parent_lessons_cursor for 700
  Expected: 200 / ParentLessonPageV1 (Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:998-1032, backend/src/sketch2life/infrastructure/lesson_library/service.py:3201-3258
}
