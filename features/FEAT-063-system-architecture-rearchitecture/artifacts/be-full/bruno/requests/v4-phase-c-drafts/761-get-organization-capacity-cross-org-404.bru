meta {
  name: 761 [DRAFT-V4C] [LOCAL / TEST ONLY] Hide foreign organization capacity from cross-org Manager with 404
  type: http
  seq: 761
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/seed-org-a/capacity
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

