meta {
  name: 754 [DRAFT-V4C] [LOCAL / TEST ONLY] Replay push endpoint revoke with same Idempotency-Key
  type: http
  seq: 754
}

delete {
  url: {{baseUrl}}/v1/notifications/push-endpoints/{{phase_c_push_endpoint_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "{{phase_c_push_revoke_expected_version}}"
  Idempotency-Key: {{phase_c_push_revoke_key}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("no-store");
    expect(res.getBody() || "").to.equal("");
  });
}

