meta {
  name: 698 [DRAFT-V4C] [LOCAL / TEST ONLY] Refuse School Manager on PUBLIC lesson search
  type: http
  seq: 698
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/public-lessons
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

