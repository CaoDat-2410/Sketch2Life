meta {
  name: 682 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject lesson versions list when limit exceeds 100
  type: http
  seq: 682
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/lessons/seed-lesson-l1/versions?limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "limit", code: "OUT_OF_RANGE" });
  });
}

