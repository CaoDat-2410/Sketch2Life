meta {
  name: 683 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject lesson versions cursor replayed on another lesson
  type: http
  seq: 683
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/lessons/seed-lesson-l2/versions?limit=1&cursor={{phase_c_versions_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "cursor", code: "INVALID_FORMAT" });
  });
}

