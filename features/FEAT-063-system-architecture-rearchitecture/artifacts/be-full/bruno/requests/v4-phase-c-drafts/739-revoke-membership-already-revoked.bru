meta {
  name: 739 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject parent-group revoke with fresh key on already revoked membership
  type: http
  seq: 739
}

delete {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/seed-pg-a-1/members/seed-pgm-1-p2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "2"
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

