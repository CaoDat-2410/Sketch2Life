meta {
  name: 725 [DRAFT-V4C] [LOCAL / TEST ONLY] Manager lists parent-group members page two with cursor
  type: http
  seq: 725
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/seed-pg-a-1/members?limit=1&cursor={{phase_c_group_members_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentGroupMemberPageV1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.equal(1);
    expect(body.counts.total).to.be.at.least(2);
  });
}

