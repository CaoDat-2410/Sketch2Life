meta {
  name: 717 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Parent decline without Idempotency-Key
  type: http
  seq: 717
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/parent-group-invitations/seed-pgm-1-p1/decline
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "Idempotency-Key", code: "REQUIRED" });
  });
}

