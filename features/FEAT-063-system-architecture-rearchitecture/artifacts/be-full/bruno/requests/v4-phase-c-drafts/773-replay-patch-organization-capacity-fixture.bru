meta {
  name: 773 [DRAFT-V4C] [LOCAL / TEST ONLY] Replay capacity PATCH with same Idempotency-Key and payload
  type: http
  seq: 773
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{phase_c_capacity_org_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "{{phase_c_capacity_expected_rev}}"
  Idempotency-Key: {{phase_c_capacity_patch_key}}
}

body:json {
  {
    "action": "cancel_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1OrganizationCapacityV1");
    expect(body.subscription_state).to.equal("CANCEL_AT_PERIOD_END");
    const expectedNext = Number(bru.getVar("phase_c_capacity_expected_rev")) + 1;
    expect(body.revision).to.equal(expectedNext);
    expect(res.getHeader("ETag")).to.equal('"' + String(expectedNext) + '"');
  });
}

