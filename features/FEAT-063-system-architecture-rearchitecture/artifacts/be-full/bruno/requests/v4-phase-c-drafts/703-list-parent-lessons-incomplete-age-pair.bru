meta {
  name: 703 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Parent lessons list with incomplete age band pair
  type: http
  seq: 703
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons?target_age_band_version=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "target_age_band_ref", code: "REQUIRED" });
  });
}

docs {
