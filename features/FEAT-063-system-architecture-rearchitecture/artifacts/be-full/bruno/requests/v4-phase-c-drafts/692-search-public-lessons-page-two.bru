meta {
  name: 692 [DRAFT-V4C] [LOCAL / TEST ONLY] Teacher searches PUBLIC lessons page two with cursor
  type: http
  seq: 692
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/public-lessons?q={{phase_c_public_q}}&topic={{phase_c_public_topic}}&target_age_band_ref={{phase_c_public_age_ref}}&target_age_band_version={{phase_c_public_age_version}}&limit=1&cursor={{phase_c_public_search_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("PublicLessonPageV1");
    expect(body.items).to.be.an("array");
    if (body.items.length > 0) {
      expect(body.items[0].lesson_id).to.not.equal(bru.getVar("phase_c_public_lesson_id"));
    }
  });
}

