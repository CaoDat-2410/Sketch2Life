meta {
  name: 700 [DRAFT-V4C] [LOCAL / TEST ONLY] Parent lists filtered lessons page two with cursor
  type: http
  seq: 700
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons?source=ALL&q={{phase_c_parent_q}}&topic={{phase_c_parent_topic}}&target_age_band_ref={{phase_c_parent_age_ref}}&target_age_band_version={{phase_c_parent_age_version}}&limit=1&cursor={{phase_c_parent_lessons_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentLessonPageV1");
    expect(body.items).to.be.an("array");
  });
}

