meta {
  name: 784 [DRAFT-V4C] [LOCAL / TEST ONLY] Parent reads RUN_WAIT_REMINDER item in notification inbox
  type: http
  seq: 784
}

get {
  url: {{baseUrl}}/v1/notifications?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    const body = res.getBody();
    expect(body.contract).to.equal("NotificationPageV1");
    const reminder = body.items.find(function (item) {
      return item.notification_type === "RUN_WAIT_REMINDER";
    });
    expect(reminder).to.be.an("object");
    expect(reminder.contract).to.equal("NotificationV1");
    expect(reminder.template_version).to.equal(1);
    expect(reminder.safe_parameters).to.deep.equal({});
    expect(reminder.expires_at).to.equal(null);
    expect(reminder).to.not.have.property("recipient_account_id");
    expect(reminder).to.not.have.property("run_id");
    expect(reminder).to.not.have.property("trigger_id");
  });
}

docs {
