meta {
  name: 705 [DRAFT-V4C] [LOCAL / TEST ONLY] Teacher remixes an exact PUBLIC REUSE lesson version
  type: http
  seq: 705
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/lessons/{{phase_c_remix_source_lesson_id}}/remixes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_c_remix_key}}
}

body:json {
  {
    "contract": "RemixLessonRequestV1",
    "source_version_id": "{{phase_c_remix_source_version_id}}",
    "source_content_sha256": "{{phase_c_remix_source_sha256}}"
  }
}

script:pre-request {
  const key = "remix-" + Date.now();
  bru.setVar("phase_c_remix_key", key);
}

script:post-response {
  const body = res.getBody();
  if (body && body.lesson && body.lesson.lesson_id) {
    bru.setVar("phase_c_remixed_lesson_id", body.lesson.lesson_id);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.equal('"1"');
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("RemixLessonResponseV1");
    expect(body.lesson.contract).to.equal("LessonDetailV1");
    expect(body.lesson.organization_id).to.equal(bru.getVar("organization_id"));
    expect(body.lesson.visibility).to.equal("PRIVATE");
    expect(body.lesson.state).to.equal("ACTIVE");
    expect(body.lesson.revision).to.equal(1);
    expect(body.lesson.current_version.version_no).to.equal(1);
    expect(body.lesson.current_version.review_state).to.equal("DRAFT");
    expect(body.lesson.current_version.source_document_revision_id).to.equal(null);
    expect(body.lesson.current_version.content).to.be.an("object");
    expect(body.source.lesson_id).to.equal(bru.getVar("phase_c_remix_source_lesson_id"));
    expect(body.source.version_id).to.equal(bru.getVar("phase_c_remix_source_version_id"));
    expect(body.source.content_sha256).to.equal(bru.getVar("phase_c_remix_source_sha256"));
  });
}

docs {
  DRAFT: written from the Phase C code at f031fc70; not yet run against a live backend.
  Role: Assigned Teacher in destination org - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: organization_id=seed-org-a; an approved ACTIVE VISIBLE PUBLIC lesson version with capability REUSE in phase_c_remix_source_lesson_id, phase_c_remix_source_version_id, phase_c_remix_source_sha256; saves phase_c_remix_key and phase_c_remixed_lesson_id for 706, 707
  Expected: 201 / RemixLessonResponseV1 with ETag "1" and Cache-Control: private, no-store
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:552-595, backend/src/sketch2life/infrastructure/lesson_library/service.py:836-966, backend/src/sketch2life/contracts/schemas/lesson_library.py:79-85,188-191
}
