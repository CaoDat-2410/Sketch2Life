meta {
  name: 707 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Teacher remix when Idempotency-Key is reused with another valid source
  type: http
  seq: 707
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/lessons/{{phase_c_remix_source_2_lesson_id}}/remixes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_c_remix_key}}
}

body:json {
  {
    "contract": "RemixLessonRequestV1",
    "source_version_id": "{{phase_c_remix_source_2_version_id}}",
    "source_content_sha256": "{{phase_c_remix_source_2_sha256}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

docs {
