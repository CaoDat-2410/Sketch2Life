meta {
  name: 742 [DRAFT-V4C] [LOCAL / TEST ONLY] Parent ANDROID_PUSH registration returns 422 PUSH_PLATFORM_UNSUPPORTED
  type: http
  seq: 742
}

post {
  url: {{baseUrl}}/v1/notifications/push-endpoints
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "contract": "PushEndpointRegistrationV1",
    "platform_kind": "ANDROID",
    "provider_kind": "ANDROID_PUSH",
    "encrypted_registration_proof": "synthetic:android-unsupported-probe",
    "app_version": "1.0.0"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("PUSH_PLATFORM_UNSUPPORTED");
  });
}

