meta {
  name: 738 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject parent-group revoke with stale If-Match on fresh key
  type: http
  seq: 738
}

delete {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/seed-pg-a-1/members/seed-pgm-1-p2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(2);
    expect(res.getHeader("ETag")).to.equal('"2"');
  });
}

docs {
