meta {
  name: 764 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity PATCH without Idempotency-Key
  type: http
  seq: 764
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
}

body:json {
  {
    "action": "cancel_renewal"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "Idempotency-Key", code: "REQUIRED" });
  });
}

docs {
