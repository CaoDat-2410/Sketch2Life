meta {
  name: 793 [DRAFT-V4C] [LOCAL / TEST ONLY] School Manager reads organization video quota summary
  type: http
  seq: 793
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/video-quota
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.owner_kind).to.equal("ORGANIZATION");
    expect(body.available_units).to.be.at.least(0);
    expect(body.granted_units).to.be.at.least(0);
    expect(body.used_units).to.be.at.least(0);
    expect(body.grants).to.be.an("array");
    expect(body.allocation).to.be.an("object");
    expect(body.allocation.allocated_unused_units).to.be.at.least(0);
    expect(body.allocation.available_school_units).to.be.at.least(0);
    expect(body.allocation.teachers).to.be.an("array");
  });
}

