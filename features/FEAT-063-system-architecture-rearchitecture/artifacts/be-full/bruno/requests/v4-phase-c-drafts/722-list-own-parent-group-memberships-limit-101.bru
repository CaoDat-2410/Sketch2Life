meta {
  name: 722 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Parent own memberships list when limit exceeds 100
  type: http
  seq: 722
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/parent-group-memberships?limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "limit", code: "OUT_OF_RANGE" });
  });
}

