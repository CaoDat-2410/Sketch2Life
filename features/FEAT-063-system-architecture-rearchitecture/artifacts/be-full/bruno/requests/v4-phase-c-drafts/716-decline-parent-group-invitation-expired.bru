meta {
  name: 716 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Parent decline of expired invitation
  type: http
  seq: 716
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/me/parent-group-invitations/{{phase_c_expired_membership_id}}/decline
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVITATION_EXPIRED");
  });
}

