meta {
  name: 712 [DRAFT-V4C] [LOCAL / TEST ONLY] Refuse School Manager on Teacher remix
  type: http
  seq: 712
}

post {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/lessons/seed-lesson-l1/remixes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "contract": "RemixLessonRequestV1",
    "source_version_id": "seed-lv-l1-1",
    "source_content_sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

