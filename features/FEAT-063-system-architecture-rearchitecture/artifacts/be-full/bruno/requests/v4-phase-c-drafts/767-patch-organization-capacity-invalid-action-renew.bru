meta {
  name: 767 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity PATCH with unsupported renew action
  type: http
  seq: 767
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "renew"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

docs {
  DRAFT after Phase C: checked against the code at 0f6e7683; not yet run against a live backend.
  owner: Billing/Capacity
  Role: Assigned School Manager - set bearerToken to seed-mgr-a token
  Needs: organization_id=seed-org-a (Be1CapacityConfigureRequest allows only cancel_renewal|resume_renewal|downgrade; no renew action exists)
  Expected: 400 / INVALID_REQUEST
  Source: backend/src/sketch2life/contracts/schemas/be1_capacity.py:13-17, backend/tests/unit/test_be1_capacity.py:88-90
}
