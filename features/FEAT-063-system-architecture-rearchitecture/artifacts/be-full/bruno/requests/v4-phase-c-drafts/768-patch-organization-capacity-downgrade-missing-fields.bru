meta {
  name: 768 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject capacity downgrade missing suspend_class_refs
  type: http
  seq: 768
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/capacity
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  If-Match: "1"
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "action": "downgrade",
    "addon_slots": 0
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

docs {
