meta {
  name: 748 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject WEB_PUSH registration when Idempotency-Key payload differs
  type: http
  seq: 748
}

post {
  url: {{baseUrl}}/v1/notifications/push-endpoints
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_c_push_register_key}}
}

body:json {
  {
    "contract": "PushEndpointRegistrationV1",
    "platform_kind": "WEB",
    "provider_kind": "WEB_PUSH",
    "encrypted_registration_proof": "{{phase_c_push_proof}}",
    "app_version": "1.0.1"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

