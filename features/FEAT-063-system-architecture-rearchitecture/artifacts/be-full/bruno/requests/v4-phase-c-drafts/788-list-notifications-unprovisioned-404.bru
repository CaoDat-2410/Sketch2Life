meta {
  name: 788 [DRAFT-V4C] [LOCAL / TEST ONLY] Hide notification inbox from unprovisioned identity with 404
  type: http
  seq: 788
}

get {
  url: {{baseUrl}}/v1/notifications
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

