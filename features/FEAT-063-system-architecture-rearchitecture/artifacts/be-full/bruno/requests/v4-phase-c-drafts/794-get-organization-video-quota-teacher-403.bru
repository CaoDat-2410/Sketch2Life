meta {
  name: 794 [DRAFT-V4C] [LOCAL / TEST ONLY] Refuse same-org Teacher on organization video quota endpoint with 403
  type: http
  seq: 794
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/video-quota
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

