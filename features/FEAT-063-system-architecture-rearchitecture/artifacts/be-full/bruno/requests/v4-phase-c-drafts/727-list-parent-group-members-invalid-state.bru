meta {
  name: 727 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject Manager members read with invalid state filter
  type: http
  seq: 727
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/seed-pg-a-1/members?state=ACTIVE
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.be.an("array");
    expect(body.field_errors[0].field).to.equal("state");
  });
}

docs {
  DRAFT: written from the Phase C code at f031fc70; not yet run against a live backend.
  Role: Assigned School Manager - set bearerToken to seed-mgr-a token
  Needs: organization_id=seed-org-a, seed-pg-a-1 (valid values are INVITED, ACCEPTED, DECLINED, REVOKED, EXPIRED; ACTIVE is rejected)
  Expected: 400 / INVALID_REQUEST (field_errors for state)
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_library.py:886, backend/tests/contract/test_parent_group_membership_routes.py:324-336
