meta {
  name: 732 [DRAFT-V4C] [LOCAL / TEST ONLY] Replay Manager revoke parent-group membership with same key and If-Match
  type: http
  seq: 732
}

delete {
  url: {{baseUrl}}/api/lesson-library/v1/organizations/{{organization_id}}/parent-groups/{{phase_c_revoke_group_id}}/members/{{phase_c_revoke_membership_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  If-Match: "{{phase_c_revoke_expected_rev}}"
  Idempotency-Key: {{phase_c_revoke_key}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("ParentGroupMembershipV1");
    expect(body.membership_id).to.equal(bru.getVar("phase_c_revoke_membership_id"));
    expect(body.state).to.equal("REVOKED");
    const expectedNext = Number(bru.getVar("phase_c_revoke_expected_rev")) + 1;
    expect(body.revision).to.equal(expectedNext);
    expect(res.getHeader("ETag")).to.equal('"' + String(expectedNext) + '"');
  });
}

