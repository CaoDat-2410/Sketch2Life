meta {
  name: 796 [DRAFT-V4C] [LOCAL / TEST ONLY] Reject anonymous request to organization video quota
  type: http
  seq: 796
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/video-quota
  body: none
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("AUTH_REQUIRED");
  });
}

