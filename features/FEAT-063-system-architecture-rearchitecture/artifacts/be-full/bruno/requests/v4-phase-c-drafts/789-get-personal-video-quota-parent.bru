meta {
  name: 789 [DRAFT-V4C] [LOCAL / TEST ONLY] Parent reads personal video quota summary
  type: http
  seq: 789
}

get {
  url: {{baseUrl}}/api/be1/v1/billing/video-quota
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.owner_kind).to.equal("PARENT_ACCOUNT");
    expect(body.available_units).to.be.at.least(0);
    expect(body.granted_units).to.be.at.least(0);
    expect(body.used_units).to.be.at.least(0);
    expect(body.grants).to.be.an("array");
    expect(body.allocation).to.equal(null);
  });
}

