  Idempotency-Key: swagger-qa-image-001
  X-Actor-Ref: demo:local
  X-Synthetic-Non-Child-Confirmed: true
}

body:multipart-form {
  image: @file(./fixtures/REPLACE_WITH_SYNTHETIC_FILE) @contentType(application/octet-stream)
}
