meta {
  name: 105 [POST/ACTION - LOCAL TEST ONLY] Upload and admit one synthetic non-child image
  type: http
  seq: 105
}

post {
  url: {{baseUrl}}/v1/sessions/{{session_id}}/media/image
  body: multipart-form
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: swagger-qa-image-001
