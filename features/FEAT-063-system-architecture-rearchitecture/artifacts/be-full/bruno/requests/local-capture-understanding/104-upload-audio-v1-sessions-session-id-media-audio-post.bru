meta {
  name: 104 [POST/ACTION - LOCAL TEST ONLY] Upload optional session-local narration audio
  type: http
  seq: 104
}

post {
  url: {{baseUrl}}/v1/sessions/{{session_id}}/media/audio
  body: multipart-form
  auth: none
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
  X-Expected-Session-Version: 0
  Idempotency-Key: REPLACE_WITH_SYNTHETIC_VALUE
  X-Actor-Ref: REPLACE_WITH_SYNTHETIC_VALUE
}

body:multipart-form {
  audio: @file(./fixtures/REPLACE_WITH_SYNTHETIC_FILE) @contentType(application/octet-stream)
}
