meta {
  name: 035 [STATE CHANGE - DISPOSABLE DATA ONLY] Assign Member To Group
  type: http
  seq: 35
}

put {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/sessions/{{session_id}}/groups/{{group_id}}/members/{{child_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

body:json {
  {
    "child_id": "REPLACE_ME",
    "expected_revision": 1
  }
}
