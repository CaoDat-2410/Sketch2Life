meta {
  name: 566 [DRAFT-V4A] [LOCAL / TEST ONLY] Request Parent video regeneration after re-confirm
  type: http
  seq: 566
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/video-generations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{parent_story_run_revision}},
    "story_sha256": "{{story_sha256}}",
    "quality_reason_code": "QUALITY_LOW"
  }
}

script:post-response {
  const vg = res.getBody().video_generation;
  if (vg) {
    bru.setVar("parent_generation_id", vg.generation_id);
    bru.setVar("parent_story_run_revision", String(vg.run_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const vg = res.getBody().video_generation;
    expect(["ACCEPTED", "ADMISSION_PENDING"]).to.include(vg.state);
    expect(vg.kind).to.equal("QUALITY_REGEN");
    expect(String(res.getHeader("Content-Location"))).to.equal("/v1/story-runs/" + bru.getVar("parent_story_run_id"));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_story_run_id after a spent video was re-confirmed via 588, current parent_story_run_revision and story_sha256
  Expected: 202
  Source: backend/src/sketch2life/interfaces/http/routers/story_run_video.py:248-315, backend/tests/integration/story_video/test_story_reconfirm_postgres.py:124-135
}
