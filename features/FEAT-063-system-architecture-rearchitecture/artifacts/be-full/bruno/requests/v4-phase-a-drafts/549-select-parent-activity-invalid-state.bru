meta {
  name: 549 [DRAFT-V4A] [LOCAL / TEST ONLY] Select Parent main activity in wrong run state
  type: http
  seq: 549
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/activity-selection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{parent_story_run_revision}},
    "activity": {
      "lesson_id": "{{activity_lesson_id}}",
      "version_id": "{{activity_version_id}}",
      "content_sha256": "{{activity_content_sha256}}",
      "activity_index": {{activity_index}}
    }
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_story_run_id that has already left PREPARATION_REVIEW (e.g. after 551 moves it to SCRIPT_GENERATING or SCRIPT_REVIEW)
  Expected: 409 / INVALID_STATE_TRANSITION
  Source: backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:2530-2645, backend/tests/contract/test_parent_activities_contract.py:303-320
}
