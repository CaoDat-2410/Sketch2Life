meta {
  name: 588 [DRAFT-V4A] [LOCAL / TEST ONLY] Re-confirm Parent script after spent video
  type: http
  seq: 588
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/script-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_a_reconfirm_script_key}}
}

body:json {
  {
    "expected_revision": {{story_revision_no}},
    "story_sha256": "{{story_sha256}}"
  }
}

script:pre-request {
  bru.setVar("phase_a_reconfirm_script_key", "v4a-reconfirm-script-" + Date.now());
}

script:post-response {
  const story = res.getBody().story_run;
  if (story) {
    bru.setVar("parent_story_run_revision", String(story.run_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const story = res.getBody().story_run;
    expect(story.run_id).to.equal(bru.getVar("parent_story_run_id"));
    expect(story.story_status).to.equal("CONFIRMED");
    expect(story.story_confirmation_required).to.equal(false);
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_story_run_id back at SCRIPT_REVIEW after a spent video (video-unsuitable, deadline failure, or safety block) with story_confirmation_required=true, story_revision_no, story_sha256
  Expected: 200
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_runs.py:734-760, backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:3485-3623, backend/tests/integration/story_video/test_story_reconfirm_postgres.py:113-122
}
