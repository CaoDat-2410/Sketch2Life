meta {
  name: 557 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm StoryRun subject with stale revision
  type: http
  seq: 557
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/subject-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": 999999,
    "confirmed_subject": "dragon"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(Number(bru.getVar("teacher_understanding_revision")));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token (also works for Parent with parent_story_run_id)
  Needs: teacher_run_id in SUBJECT_REVIEW (with teacher_understanding_revision captured by 560) before 556 moves it out of SUBJECT_REVIEW
  Expected: 409 / STALE_REVISION (current_version = latest understanding revision_no)
  Source: backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:2144-2150, backend/tests/contract/test_parent_story_rewrites_route.py:622-630
}
