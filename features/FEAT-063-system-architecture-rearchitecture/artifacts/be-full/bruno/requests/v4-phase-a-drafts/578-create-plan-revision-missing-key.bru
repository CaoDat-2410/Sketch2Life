meta {
  name: 578 [DRAFT-V4A] [LOCAL / TEST ONLY] Create occurrence plan revision without key
  type: http
  seq: 578
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/plan-revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "expected_head_revision_no": {{plan_head_revision_no}},
    "objectives": [
      "Nhận biết hình tròn"
    ],
    "teacher_direction": "Câu chuyện về chú mèo",
    "safety_notes": null,
    "activities": [
      {
        "kind": "LESSON",
        "lesson_activity_id": "{{lesson_activity_id}}"
      }
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: occurrence_id, plan_head_revision_no, lesson_activity_id
  Expected: 400 / INVALID_REQUEST
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_occurrences.py:477-508, backend/tests/contract/test_lesson_plan_routes.py:610-630
}
