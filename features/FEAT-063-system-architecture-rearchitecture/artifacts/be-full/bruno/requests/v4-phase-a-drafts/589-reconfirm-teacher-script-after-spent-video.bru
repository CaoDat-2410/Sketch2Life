meta {
  name: 589 [DRAFT-V4A] [LOCAL / TEST ONLY] Re-confirm Teacher script after spent video
  type: http
  seq: 589
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/script-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{teacher_story_revision_no}},
    "story_sha256": "{{teacher_story_sha256}}"
  }
}

script:post-response {
  const story = res.getBody().story_run;
  if (story) {
    bru.setVar("teacher_run_revision", String(story.run_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const story = res.getBody().story_run;
    expect(story.run_id).to.equal(bru.getVar("teacher_run_id"));
    expect(story.story_status).to.equal("CONFIRMED");
    expect(story.story_confirmation_required).to.equal(false);
    expect(story.activity).to.be.an("object");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: teacher_run_id back at SCRIPT_REVIEW after 525 (video-unsuitable), deadline failure, or safety block with story_confirmation_required=true, teacher_story_revision_no, teacher_story_sha256
  Expected: 200
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_runs.py:734-760, backend/tests/integration/story_teacher/test_teacher_reconfirm_postgres.py:60-89
}
