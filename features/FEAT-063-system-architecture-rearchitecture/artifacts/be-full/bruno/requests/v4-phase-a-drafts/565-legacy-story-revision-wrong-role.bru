meta {
  name: 565 [DRAFT-V4A] [LOCAL / TEST ONLY] Legacy story revision as Teacher
  type: http
  seq: 565
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{parent_story_run_id}}/story-revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": 1,
    "rewrite_instruction": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

