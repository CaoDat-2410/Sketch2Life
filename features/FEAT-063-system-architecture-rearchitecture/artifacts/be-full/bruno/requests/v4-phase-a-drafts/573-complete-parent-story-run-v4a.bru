meta {
  name: 573 [DRAFT-V4A] [LOCAL / TEST ONLY] Complete Parent StoryRun with post-video activities and playback available
  type: http
  seq: 573
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{parent_story_run_revision}}
  }
}

script:post-response {
  const story = res.getBody().story_run;
  if (story) {
    bru.setVar("parent_story_run_revision", String(story.run_revision));
    bru.setVar("completed_story_run_id", story.run_id);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const story = res.getBody().story_run;
    expect(story.run_id).to.equal(bru.getVar("parent_story_run_id"));
    expect(story.run_state).to.equal("COMPLETED");
    expect(story.main_activity).to.be.an("object");
    expect(story.post_video_activities === null || Array.isArray(story.post_video_activities)).to.equal(true);
    if (story.video) {
      expect(story.video.playback.state).to.equal("AVAILABLE");
    }
    expect(String(res.getHeader("Content-Location"))).to.equal("/v1/story-runs/" + bru.getVar("parent_story_run_id"));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_story_run_id at VIDEO_READY, current parent_story_run_revision (Complete keeps video.playback.state AVAILABLE and returns post_video_activities)
  Expected: 200
  Source: backend/src/sketch2life/interfaces/http/routers/story_run_video.py:246-269,305-333, backend/tests/integration/test_parent_activity_selection_postgres.py:1116-1158
}
