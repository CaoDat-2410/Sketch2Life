meta {
  name: 595 [DRAFT-V4A] [LOCAL / TEST ONLY] Stream completed Parent playback range
  type: http
  seq: 595
}

get {
  url: {{baseUrl}}/v1/story-runs/{{completed_story_run_id}}/playback
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  X-Playback-Token: {{parent_playback_token}}
  Range: bytes=0-3
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(206);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(String(res.getHeader("content-range")).startsWith("bytes 0-3/")).to.equal(true);
    expect(String(res.getHeader("Cache-Control"))).to.include("no-store");
  });
}

docs {
