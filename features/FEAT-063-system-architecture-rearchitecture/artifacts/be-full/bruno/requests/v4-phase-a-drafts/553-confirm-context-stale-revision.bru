meta {
  name: 553 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm StoryRun context with stale revision
  type: http
  seq: 553
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": 999999,
    "context_snapshot_sha256": "{{teacher_context_hash}}",
    "confirmed": true
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(Number(bru.getVar("teacher_context_revision")));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token (also works for Parent with parent_story_run_id)
  Needs: teacher_run_id, teacher_context_revision, and teacher_context_hash from 560
  Expected: 409 / STALE_REVISION (with current_version)
  Source: backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:1300-1340
}
