meta {
  name: 593 [DRAFT-V4A] [LOCAL / TEST ONLY] Create playback token for completed Parent run
  type: http
  seq: 593
}

post {
  url: {{baseUrl}}/v1/story-runs/{{completed_story_run_id}}/playback-token
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const playback = res.getBody().playback;
  if (playback && playback.token) {
    bru.setVar("parent_playback_token", playback.token);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("no-store");
    const playback = res.getBody().playback;
    expect(playback.stream_path).to.equal("/v1/story-runs/" + bru.getVar("completed_story_run_id") + "/playback");
    expect(playback.media_type).to.equal("video/mp4");
    expect(String(playback.asset_ref).startsWith("vid_")).to.equal(true);
    expect(playback.token).to.be.a("string");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: completed_story_run_id (Parent run at COMPLETED after 573 with a safety-passed READY video)
  Expected: 200 (Cache-Control: no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/story_run_video.py:360-403, backend/src/sketch2life/infrastructure/story_video/repository.py:1154-1237, backend/tests/integration/story_video/test_playback_and_detail_postgres.py:336-343
}
