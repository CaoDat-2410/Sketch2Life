meta {
  name: 563 [DRAFT-V4A] [LOCAL / TEST ONLY] Generate legacy dev story revision
  type: http
  seq: 563
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{dev_story_run_id}}/story-revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": {{story_understanding_revision}},
    "rewrite_instruction": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.request_id).to.be.a("string");
    expect(body.review_required).to.equal(true);
    expect(body.story_run.run_id).to.equal(bru.getVar("dev_story_run_id"));
    expect(body.story_sha256).to.be.a("string");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent (dev) - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture - dev_story_run_id in PREPARATION_REVIEW with activity selected and no story started yet, plus modal_dev enabled on the local server (returns 503 if modal_dev is off)
  Expected: 200
  Source: backend/src/sketch2life/interfaces/http/routers/parent_ai.py:175-218, backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:2160-2220
}
