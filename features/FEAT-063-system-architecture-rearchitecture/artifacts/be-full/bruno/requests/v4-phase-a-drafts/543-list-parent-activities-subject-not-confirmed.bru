meta {
  name: 543 [DRAFT-V4A] [LOCAL / TEST ONLY] List Parent activities before subject confirmed
  type: http
  seq: 543
}

get {
  url: {{baseUrl}}/v1/activities?story_run_id={{unconfirmed_subject_run_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("SUBJECT_NOT_CONFIRMED");
  });
}

docs {
