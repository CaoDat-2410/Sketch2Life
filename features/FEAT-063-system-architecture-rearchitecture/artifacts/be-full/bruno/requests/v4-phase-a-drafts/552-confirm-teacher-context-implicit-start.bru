meta {
  name: 552 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm Teacher StoryRun context
  type: http
  seq: 552
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": {{teacher_context_revision}},
    "context_snapshot_sha256": "{{teacher_context_hash}}",
    "confirmed": true
  }
}

script:post-response {
  const story = res.getBody().story_run;
  bru.setVar("teacher_run_revision", String(story.run_revision));
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const story = res.getBody().story_run;
    expect(story.context_confirmed).to.equal(true);
    expect(story.occurrence_id).to.equal(bru.getVar("occurrence_id"));
    expect(story.plan).to.be.an("object");
    expect(story.activity).to.be.an("object");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: teacher_run_id from 508 (in INPUT_PROCESSING, SUBJECT_REVIEW, or PREPARATION_REVIEW), teacher_context_revision and teacher_context_hash from 560; if subject is already confirmed this triggers the implicit first story
  Expected: 200
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_runs.py:667-704, backend/tests/integration/story_teacher/test_teacher_first_story_postgres.py:98-140
}
