meta {
  name: 574 [DRAFT-V4A] [LOCAL / TEST ONLY] Complete StoryRun with stale revision
  type: http
  seq: 574
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": 1
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(Number(bru.getVar("teacher_run_revision")));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: teacher_run_id at VIDEO_READY with run_revision > 1 (captured in teacher_run_revision, run before 572 completes the run)
  Expected: 409 / STALE_REVISION (current_version = run_revision)
  Source: backend/src/sketch2life/infrastructure/story_video/repository.py:1049-1057
}
