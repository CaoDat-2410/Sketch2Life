meta {
  name: 605 [DRAFT-V4A] [LOCAL / TEST ONLY] Refuse streaming with pre-Complete projection token after Complete
  type: http
  seq: 605
}

get {
  url: {{baseUrl}}/v1/story-runs/{{pre_complete_projected_run_id}}/playback
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  X-Playback-Token: {{pre_complete_projection_token}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

docs {
