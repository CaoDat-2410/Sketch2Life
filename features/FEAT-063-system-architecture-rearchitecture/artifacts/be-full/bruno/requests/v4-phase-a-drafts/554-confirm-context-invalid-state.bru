meta {
  name: 554 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm StoryRun context in wrong run state
  type: http
  seq: 554
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": {{story_context_revision}},
    "context_snapshot_sha256": "{{story_context_hash}}",
    "confirmed": true
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_story_run_id after 551 has moved it out of PREPARATION_REVIEW (e.g. SCRIPT_GENERATING or SCRIPT_REVIEW), story_context_revision, story_context_hash
  Expected: 409 / INVALID_STATE_TRANSITION
  Source: backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:1290-1315
}
