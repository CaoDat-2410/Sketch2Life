meta {
  name: 581 [DRAFT-V4A] [LOCAL / TEST ONLY] List occurrence plan revisions with invalid limit
  type: http
  seq: 581
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/plan-revisions?limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

