meta {
  name: 576 [DRAFT-V4A] [LOCAL / TEST ONLY] Create occurrence plan revision returning plan_activity_id
  type: http
  seq: 576
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/plan-revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_head_revision_no": {{plan_head_revision_no}},
    "objectives": [
      "Nhận biết hình tròn"
    ],
    "teacher_direction": "Câu chuyện về chú mèo",
    "safety_notes": null,
    "activities": [
      {
        "kind": "LESSON",
        "lesson_activity_id": "{{lesson_activity_id}}"
      }
    ]
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("plan_revision_no", String(body.revision_no));
  bru.setVar("plan_head_revision_no", String(body.revision_no));
  bru.setVar("plan_hash", body.content_hash);
  bru.setVar("plan_etag", res.getHeader("ETag"));
  if (Array.isArray(body.activities) && body.activities.length > 0 && body.activities[0].plan_activity_id) {
    bru.setVar("plan_activity_id", body.activities[0].plan_activity_id);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("ETag")).to.be.a("string");
    expect(res.getHeader("Cache-Control")).to.equal("private, no-cache");
    const body = res.getBody();
    expect(body.contract).to.equal("LessonPlanRevisionV1");
    expect(body.state).to.equal("DRAFT");
    expect(body.activities).to.be.an("array");
    expect(body.activities.length).to.equal(1);
    body.activities.forEach(function (activity) {
      expect(activity.plan_activity_id).to.be.a("string");
      expect(activity.plan_activity_id.length >= 1).to.equal(true);
      expect(activity.plan_activity_id.length <= 36).to.equal(true);
    });
    expect(String(res.getHeader("Location"))).to.equal("/v1/lesson-occurrences/" + bru.getVar("occurrence_id") + "/plan-revisions/" + body.revision_no);
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: occurrence_id (created with a pinned lesson_version_ref), lesson_activity_id from that pinned lesson, plan_head_revision_no (from 580, or 0 if no plan revision exists yet)
  Expected: 201
  Source: backend/src/sketch2life/interfaces/http/routers/lesson_occurrences.py:477-508, backend/src/sketch2life/contracts/schemas/lesson_occurrences.py:364-385, backend/tests/contract/test_lesson_plan_routes.py:778-791
}
