meta {
  name: 567 [DRAFT-V4A] [LOCAL / TEST ONLY] Request Teacher video generation on current plan
  type: http
  seq: 567
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/video-generations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{teacher_run_revision}},
    "story_sha256": "{{teacher_story_sha256}}",
    "quality_reason_code": "QUALITY_LOW"
  }
}

script:post-response {
  const vg = res.getBody().video_generation;
  if (vg) {
    bru.setVar("teacher_generation_id", vg.generation_id);
    if (vg.job_id) bru.setVar("teacher_job_id", vg.job_id);
    bru.setVar("teacher_run_revision", String(vg.run_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const vg = res.getBody().video_generation;
    expect(["ACCEPTED", "ADMISSION_PENDING"]).to.include(vg.state);
    expect(String(res.getHeader("Content-Location"))).to.equal("/v1/story-runs/" + bru.getVar("teacher_run_id"));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: teacher_run_id after a spent video was re-confirmed via 589 (run pinned to the current approved plan; use quality_reason_code null if this is the first video request on the run)
  Expected: 202
  Source: backend/src/sketch2life/interfaces/http/routers/story_run_video.py:248-315, backend/tests/integration/story_teacher/test_teacher_reconfirm_postgres.py:90-125
}
