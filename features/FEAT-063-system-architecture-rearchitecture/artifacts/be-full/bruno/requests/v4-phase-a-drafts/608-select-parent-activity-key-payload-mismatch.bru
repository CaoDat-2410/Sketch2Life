meta {
  name: 608 [DRAFT-V4A] [LOCAL / TEST ONLY] Reject Parent main-activity selection when Idempotency-Key payload differs
  type: http
  seq: 608
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/activity-selection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_a_select_activity_key}}
}

body:json {
  {
    "expected_revision": {{phase_a_select_expected_revision}},
    "activity": {
      "lesson_id": "{{activity_lesson_id}}",
      "version_id": "{{activity_version_id}}",
      "content_sha256": "{{activity_content_sha256}}",
      "activity_index": 99
    }
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: run after 545 (reuses phase_a_select_activity_key with a different activity_index)
  Expected: 400 / INVALID_IDEMPOTENCY_KEY
