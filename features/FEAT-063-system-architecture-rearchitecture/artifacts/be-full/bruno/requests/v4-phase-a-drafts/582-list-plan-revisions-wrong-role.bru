meta {
  name: 582 [DRAFT-V4A] [LOCAL / TEST ONLY] List occurrence plan revisions as Parent
  type: http
  seq: 582
}

get {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/plan-revisions?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

