meta {
  name: 575 [DRAFT-V4A] [LOCAL / TEST ONLY] Complete StoryRun not at VIDEO_READY
  type: http
  seq: 575
}

post {
  url: {{baseUrl}}/v1/story-runs/{{completed_run_id}}/complete
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{teacher_run_revision}}
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

