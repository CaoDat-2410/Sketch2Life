meta {
  name: 579 [DRAFT-V4A] [LOCAL / TEST ONLY] Create occurrence plan revision as School Manager
  type: http
  seq: 579
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/plan-revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_head_revision_no": 0,
    "objectives": [
      "Nhận biết hình tròn"
    ],
    "teacher_direction": "Câu chuyện về chú mèo",
    "safety_notes": null,
    "activities": [
      {
        "kind": "LESSON",
        "lesson_activity_id": "{{lesson_activity_id}}"
      }
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(403);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("ACTION_NOT_ALLOWED");
  });
}

docs {
