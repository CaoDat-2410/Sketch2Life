meta {
  name: 602 [DRAFT-V4A] [LOCAL / TEST ONLY] Create class projection playback token after post-Complete claim
  type: http
  seq: 602
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/projection-playback-token
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const playback = res.getBody().playback;
  if (playback && playback.token) {
    bru.setVar("projection_token", playback.token);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("no-store");
    const playback = res.getBody().playback;
    expect(playback.contract).to.equal("ClassProjectionPlaybackGrantV1");
    expect(playback.occurrence_id).to.equal(bru.getVar("occurrence_id"));
    expect(playback.story_run_id).to.equal(bru.getVar("completed_run_id"));
    expect(playback.video_generation_id).to.equal(bru.getVar("completed_generation_id"));
    expect(playback.stream_path).to.equal("/v1/story-runs/" + bru.getVar("completed_run_id") + "/playback");
    expect(playback.media_type).to.equal("video/mp4");
    expect(playback.token).to.be.a("string");
  });
}

docs {
