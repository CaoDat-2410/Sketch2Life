meta {
  name: 541 [DRAFT-V4A] [LOCAL / TEST ONLY] List Parent activities with invalid story_run_id
  type: http
  seq: 541
}

get {
  url: {{baseUrl}}/v1/activities?story_run_id=not-a-uuid
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

