meta {
  name: 564 [DRAFT-V4A] [LOCAL / TEST ONLY] Legacy story revision requires activity selection
  type: http
  seq: 564
}

post {
  url: {{baseUrl}}/api/parent/v1/ai/story-runs/{{unselected_parent_run_id}}/story-revisions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": 1,
    "rewrite_instruction": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("PARENT_ACTIVITY_SELECTION_REQUIRED");
  });
}

docs {
