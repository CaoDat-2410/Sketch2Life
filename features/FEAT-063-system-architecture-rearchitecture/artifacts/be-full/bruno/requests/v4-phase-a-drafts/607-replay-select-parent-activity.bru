meta {
  name: 607 [DRAFT-V4A] [LOCAL / TEST ONLY] Replay Parent main-activity selection with same Idempotency-Key
  type: http
  seq: 607
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/activity-selection
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_a_select_activity_key}}
}

body:json {
  {
    "expected_revision": {{phase_a_select_expected_revision}},
    "activity": {
      "lesson_id": "{{activity_lesson_id}}",
      "version_id": "{{activity_version_id}}",
      "content_sha256": "{{activity_content_sha256}}",
      "activity_index": {{activity_index}}
    }
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.story_run_id).to.equal(bru.getVar("parent_story_run_id"));
    expect(body.main_activity).to.be.an("object");
    expect(body.main_activity.lesson_id).to.equal(bru.getVar("activity_lesson_id"));
    expect(body.main_activity.version_id).to.equal(bru.getVar("activity_version_id"));
    expect(body.main_activity.content_sha256).to.equal(bru.getVar("activity_content_sha256"));
    expect(body.main_activity.activity_index).to.equal(Number(bru.getVar("activity_index")));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: run after 545 (uses phase_a_select_activity_key and phase_a_select_expected_revision saved by 545)
  Expected: 200 (idempotent replay returns the stored ParentActivitySelectionResponseV1)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_activities.py:87-122, backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:2530-2645, backend/tests/contract/test_parent_activities_contract.py:210-228
}
