meta {
  name: 555 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm Parent StoryRun subject
  type: http
  seq: 555
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/subject-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": {{story_understanding_revision}},
    "confirmed_subject": "paper kite"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.run_revision !== undefined) {
    bru.setVar("parent_story_run_revision", String(body.run_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.story_run_id).to.equal(bru.getVar("parent_story_run_id"));
    expect(["CONFIRMED", "RERUN_REQUESTED"]).to.include(body.decision);
    expect(typeof body.understanding_revision).to.equal("number");
    expect(typeof body.run_revision).to.equal("number");
    expect(String(res.getHeader("Content-Location"))).to.equal("/v1/story-runs/" + bru.getVar("parent_story_run_id"));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_story_run_id in SUBJECT_REVIEW, story_understanding_revision (moves run to PREPARATION_REVIEW so 540/545 can run; does not start the first story until activity is chosen)
  Expected: 202
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_runs.py:707-731, backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:1395-1465
}
