meta {
  name: 617 [DRAFT-V4A] [LOCAL / TEST ONLY] Refuse playback token for completed Parent run after child profile deleted
  type: http
  seq: 617
}

post {
  url: {{baseUrl}}/v1/story-runs/{{deleted_profile_completed_run_id}}/playback-token
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

