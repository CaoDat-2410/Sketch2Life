meta {
  name: 596 [DRAFT-V4A] [LOCAL / TEST ONLY] Stream Parent playback with invalid token
  type: http
  seq: 596
}

get {
  url: {{baseUrl}}/v1/story-runs/{{completed_story_run_id}}/playback
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  X-Playback-Token: invalid-playback-token
}

tests {
  test("assert response contract", function () {
    expect([401, 503]).to.include(res.getStatus());
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    if (res.getStatus() === 401) {
      expect(res.getBody().code).to.equal("INVALID_TOKEN");
    }
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: completed_story_run_id (returns 401 INVALID_TOKEN when playback token signing secret is configured, or 503 PROVIDER_UNAVAILABLE if not configured)
  Expected: 401 / INVALID_TOKEN (or 503 / PROVIDER_UNAVAILABLE)
  Source: backend/src/sketch2life/application/services/story_run_playback.py:138-185, backend/src/sketch2life/interfaces/http/routers/story_run_video.py:432-535
}
