meta {
  name: 610 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm Teacher context as last gate triggering implicit first story
  type: http
  seq: 610
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_subject_confirmed_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": {{teacher_subject_confirmed_context_revision}},
    "context_snapshot_sha256": "{{teacher_subject_confirmed_context_hash}}",
    "confirmed": true
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const story = res.getBody().story_run;
    expect(story.run_id).to.equal(bru.getVar("teacher_subject_confirmed_run_id"));
    expect(story.context_confirmed).to.equal(true);
    expect(story.run_state).to.equal("SCRIPT_GENERATING");
    expect(story.job_state).to.equal("QUEUED");
    expect(story.story_revision_no).to.equal(1);
    expect(story.story_status).to.equal("GENERATING");
    expect(story.plan).to.be.an("object");
    expect(story.activity).to.be.an("object");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture - teacher_subject_confirmed_run_id, teacher_subject_confirmed_context_revision, teacher_subject_confirmed_context_hash (Teacher StoryRun in PREPARATION_REVIEW with subject already confirmed before context-confirmation)
  Expected: 200 (context-confirmation closes the last gate and implicitly starts story revision 1 in SCRIPT_GENERATING)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_runs.py:667-704, backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:1340-1390, backend/tests/integration/story_teacher/test_teacher_first_story_postgres.py:98-140
}
