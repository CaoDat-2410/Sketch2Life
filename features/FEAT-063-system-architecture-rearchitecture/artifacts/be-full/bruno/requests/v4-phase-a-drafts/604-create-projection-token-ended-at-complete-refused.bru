meta {
  name: 604 [DRAFT-V4A] [LOCAL / TEST ONLY] Refuse projection playback token after Complete for pre-Complete confirmation
  type: http
  seq: 604
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{pre_complete_projected_occurrence_id}}/projection-playback-token
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

