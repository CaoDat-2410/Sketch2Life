meta {
  name: 542 [DRAFT-V4A] [LOCAL / TEST ONLY] List Parent activities as Teacher
  type: http
  seq: 542
}

get {
  url: {{baseUrl}}/v1/activities?story_run_id={{parent_story_run_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

