meta {
  name: 556 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm Teacher subject triggering implicit first story
  type: http
  seq: 556
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/subject-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_understanding_revision": {{teacher_understanding_revision}},
    "confirmed_subject": "dragon"
  }
}

script:post-response {
  const body = res.getBody();
  if (body.run_revision !== undefined) {
    bru.setVar("teacher_run_revision", String(body.run_revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(202);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.story_run_id).to.equal(bru.getVar("teacher_run_id"));
    expect(["CONFIRMED", "RERUN_REQUESTED"]).to.include(body.decision);
    expect(typeof body.understanding_revision).to.equal("number");
    expect(typeof body.run_revision).to.equal("number");
    expect(String(res.getHeader("Content-Location"))).to.equal("/v1/story-runs/" + bru.getVar("teacher_run_id"));
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: teacher_run_id in SUBJECT_REVIEW (with context already confirmed via 552 so subject-confirmation is the last gate for the implicit first story), teacher_understanding_revision (normally 1)
  Expected: 202
  Source: backend/src/sketch2life/interfaces/http/routers/parent_story_runs.py:707-731, backend/tests/integration/story_teacher/test_teacher_first_story_postgres.py:52-95
}
