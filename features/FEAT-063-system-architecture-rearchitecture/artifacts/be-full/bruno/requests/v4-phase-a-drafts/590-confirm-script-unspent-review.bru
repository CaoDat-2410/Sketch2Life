meta {
  name: 590 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm script when latest review is unspent
  type: http
  seq: 590
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_story_run_id}}/script-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{story_revision_no}},
    "story_sha256": "{{story_sha256}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token (also applies to Teacher)
  Needs: parent_story_run_id right after 588 (story is CONFIRMED with an unspent review, before requesting another video)
  Expected: 409 / INVALID_STATE_TRANSITION
  Source: backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:3463-3483,3514-3520, backend/tests/integration/story_video/test_story_reconfirm_postgres.py:136-152
}
