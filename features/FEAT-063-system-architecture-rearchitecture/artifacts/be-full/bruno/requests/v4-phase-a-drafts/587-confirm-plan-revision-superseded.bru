meta {
  name: 587 [DRAFT-V4A] [LOCAL / TEST ONLY] Confirm superseded plan revision
  type: http
  seq: 587
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/plan-revisions/{{superseded_plan_revision_no}}/confirm
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_plan_hash": "{{plan_hash}}",
    "checklist": []
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
  DRAFT: checked against the final Phase A code at 930da61e; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture - occurrence_id and superseded_plan_revision_no (an older plan revision whose state is SUPERSEDED)
  Expected: 409 / INVALID_STATE_TRANSITION
  Source: backend/src/sketch2life/infrastructure/lesson_occurrences/plans.py:212-235, backend/tests/contract/test_lesson_plan_routes.py:685-705
