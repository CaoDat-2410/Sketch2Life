meta {
  name: 413 [LOCAL / TEST ONLY] Replay class create receipt
  type: http
  seq: 413
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{idempotency_key_128}}
}

body:json {
  {
    "display_name": "[TEST] Bruno v3 receipt class"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().class_id).to.equal(bru.getVar("created_class_id"));
  });
}
