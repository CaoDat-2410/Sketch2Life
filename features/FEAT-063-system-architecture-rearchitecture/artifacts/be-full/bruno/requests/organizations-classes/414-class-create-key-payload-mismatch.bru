meta {
  name: 414 [LOCAL / TEST ONLY] Reuse class key with a different body
  type: http
  seq: 414
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{idempotency_key_128}}
}

body:json {
  {
    "display_name": "[TEST] different display name"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}
