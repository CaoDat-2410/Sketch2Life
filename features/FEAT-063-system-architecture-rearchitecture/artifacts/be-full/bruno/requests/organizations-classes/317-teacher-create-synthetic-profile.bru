meta {
  name: 317 [LOCAL / TEST ONLY] Create synthetic profile with class revision
  type: http
  seq: 317
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{created_class_id}}/profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_created_class_revision_etag}}
}

body:json {
  {
    "display_name": "Synthetic Phase B child",
    "age_months": 60
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("phase_b_child_id", body.child_id);
  bru.setVar("phase_b_created_class_revision", String(body.class_revision));
  bru.setVar("phase_b_created_class_revision_etag", '"' + String(body.class_revision) + '"');
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().contract).to.equal("Be1ManagedProfileV1");
    expect(res.getBody().class_id).to.equal(bru.getVar("created_class_id"));
    expect(res.getBody().data_origin).to.be.a("string");
    expect(res.getHeader("ETag")).to.be.a("string");
  });
}

