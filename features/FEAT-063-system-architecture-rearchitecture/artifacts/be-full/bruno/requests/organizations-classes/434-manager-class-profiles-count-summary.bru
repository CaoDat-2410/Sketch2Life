meta {
  name: 434 [LOCAL / TEST ONLY] School Manager reads class profiles count summary
  type: http
  seq: 434
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().contract).to.equal("Be1ClassRosterSummaryV1");
    expect(res.getBody().active_profile_count).to.be.a("number");
    expect(res.getBody()).to.not.have.property("child_id");
  });
}

docs {
  Request 296 is the same current contract; this row only updates the historical 204 case.
}
