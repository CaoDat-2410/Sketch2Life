meta {
  name: 435 [LOCAL / TEST ONLY] Teacher class profiles control
  type: http
  seq: 435
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ManagedProfileListV1");
    expect(body.items).to.be.an("array");
    expect(body).to.have.property("next_cursor");
    expect(body.next_cursor === null || typeof body.next_cursor === "string").to.equal(true);
    expect(body.active_profile_count).to.be.a("number");
    expect(body.active_profile_count).to.be.at.least(body.items.length);
    if (body.items.length > 0) {
      expect(body.items[0].child_id).to.be.a("string");
      expect(body.items[0].class_id).to.equal(bru.getVar("class_id"));
      expect(body.items[0].display_name).to.be.a("string");
      expect(body.items[0].age_months).to.be.a("number");
    }
  });
}

docs {
