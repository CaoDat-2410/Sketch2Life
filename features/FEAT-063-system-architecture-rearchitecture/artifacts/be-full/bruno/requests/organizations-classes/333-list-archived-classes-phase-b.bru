meta {
  name: 333 [LOCAL / TEST ONLY] A07 Manager can list archived classes
  type: http
  seq: 333
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes?state=archived&limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().items.some(item => item.class_id === bru.getVar("phase_b_lifecycle_class_id"))).to.equal(true);
  });
}

