meta {
  name: 351 [LOCAL / TEST ONLY] Archive source class after successful move
  type: http
  seq: 351
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{created_class_id}}/archive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_move_source_revision_etag}}
}

script:post-response {
  const body = res.getBody();
  bru.setVar("phase_b_archived_source_etag", res.getHeader("ETag"));
  bru.setVar("phase_b_archived_source_revision", String(body.class_revision));
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().state).to.equal("archived");
  });
}

