meta {
  name: 326 [LOCAL / TEST ONLY] Synthetic create stays unavailable when pilot gate is off
  type: http
  seq: 326
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{synthetic_gate_off_class_id}}/profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{synthetic_gate_off_class_revision_etag}}
}

body:json {
  {
    "display_name": "Synthetic Phase B child",
    "age_months": 60
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("SYNTHETIC_PROFILE_CREATION_UNAVAILABLE");
  });
}

