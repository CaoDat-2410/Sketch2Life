meta {
  name: 308 [LOCAL / TEST ONLY] Create disposable class for state transitions
  type: http
  seq: 308
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "display_name": "[TEST] Phase B lifecycle class"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("phase_b_lifecycle_class_id", body.class_id);
  bru.setVar("phase_b_lifecycle_assignment_etag", '"' + String(body.assignment_revision) + '"');
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().state).to.equal("active");
  });
}

