meta {
  name: 296 [LOCAL / TEST ONLY] Manager A09 receives count-only roster summary
  type: http
  seq: 296
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{created_class_id}}/profiles
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().contract).to.equal("Be1ClassRosterSummaryV1");
    expect(res.getBody().active_profile_count).to.be.a("number");
    expect(res.getBody()).to.not.have.property("items");
    expect(res.getBody()).to.not.have.property("child_id");
  });
}

