meta {
  name: 412 [LOCAL / TEST ONLY] Create class with 128-character key
  type: http
  seq: 412
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{idempotency_key_128}}
}

body:json {
  {
    "display_name": "[TEST] Bruno v3 receipt class"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("created_class_id", body.class_id);
  bru.setVar("created_class_etag", '"' + String(body.assignment_revision) + '"' );
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.state).to.equal("active");
    expect(body.assignment_revision).to.be.a("number");
  });
}
