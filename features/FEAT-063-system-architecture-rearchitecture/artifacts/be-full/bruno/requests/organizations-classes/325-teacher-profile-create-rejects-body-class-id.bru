meta {
  name: 325 [LOCAL / TEST ONLY] Teacher profile create rejects body class_id
  type: http
  seq: 325
}

post {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{created_class_id}}/profiles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_created_class_revision_etag}}
}

body:json {
  {
    "class_id": "{{created_class_id}}",
    "display_name": "Synthetic Phase B child",
    "age_months": 60
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_REQUEST");
  });
}

