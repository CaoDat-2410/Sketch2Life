meta {
  name: 338 [LOCAL / TEST ONLY] Assign the same Teacher to target class
  type: http
  seq: 338
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_b_move_target_class_id}}/assignments
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_move_target_assignment_etag}}
}

body:json {
  {
    "candidate_ref": "{{candidate_ref}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().assignment_revision).to.be.a("number");
  });
}

