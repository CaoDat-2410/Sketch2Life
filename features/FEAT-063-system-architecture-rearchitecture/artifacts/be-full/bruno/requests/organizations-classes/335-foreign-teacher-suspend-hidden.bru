meta {
  name: 335 [LOCAL / TEST ONLY] Out-of-scope Teacher receives uniform class-state not-found
  type: http
  seq: 335
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_b_lifecycle_class_id}}/suspend
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_lifecycle_archived_etag}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

