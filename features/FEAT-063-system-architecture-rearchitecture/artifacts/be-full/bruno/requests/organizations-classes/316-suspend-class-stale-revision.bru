meta {
  name: 316 [LOCAL / TEST ONLY] Suspend command rejects stale class revision
  type: http
  seq: 316
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_b_lifecycle_class_id}}/suspend
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Idempotency-Key: {{$guid}}
  If-Match: "1"
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("STALE_REVISION");
  });
}

