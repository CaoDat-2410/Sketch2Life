meta {
  name: 347 [LOCAL / TEST ONLY] School Manager moves the enrollment back
  type: http
  seq: 347
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{phase_b_move_target_class_id}}/profiles/{{phase_b_child_id}}/move
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_move_target_revision_etag}}
}

body:json {
  {
    "target_class_id": "{{created_class_id}}",
    "target_class_revision": {{phase_b_move_source_revision}}
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().contract).to.equal("Be1ProfileMoveV1");
    expect(res.getBody().to_class_id).to.equal(bru.getVar("created_class_id"));
    expect(res.getBody()).to.not.have.property("display_name");
    expect(res.getBody()).to.not.have.property("age_months");
  });
}
