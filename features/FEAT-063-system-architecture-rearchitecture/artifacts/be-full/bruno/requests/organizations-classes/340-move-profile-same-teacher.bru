meta {
  name: 340 [LOCAL / TEST ONLY] Move active enrollment between same-Teacher classes
  type: http
  seq: 340
}

post {
  url: {{baseUrl}}/api/be1/v1/classes/{{created_class_id}}/profiles/{{phase_b_child_id}}/move
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{phase_b_created_class_revision_etag}}
}

body:json {
  {
    "target_class_id": "{{phase_b_move_target_class_id}}",
    "target_class_revision": {{phase_b_move_target_revision}}
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("phase_b_move_source_revision", String(body.from_class_revision));
  bru.setVar("phase_b_move_source_revision_etag", '"' + String(body.from_class_revision) + '"');
  bru.setVar("phase_b_move_target_revision", String(body.to_class_revision));
  bru.setVar("phase_b_move_target_revision_etag", '"' + String(body.to_class_revision) + '"');
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().contract).to.equal("Be1ProfileMoveV1");
    expect(res.getBody().child_id).to.equal(bru.getVar("phase_b_child_id"));
    expect(res.getBody().from_class_id).to.equal(bru.getVar("created_class_id"));
    expect(res.getBody().to_class_id).to.equal(bru.getVar("phase_b_move_target_class_id"));
    expect(res.getHeader("ETag")).to.equal(undefined);
    expect(res.getBody()).to.not.have.property("display_name");
    expect(res.getBody()).to.not.have.property("age_months");
  });
}

