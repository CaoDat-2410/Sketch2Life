meta {
  name: 065 [READ ONLY] Download Parent Lesson
  type: http
  seq: 65
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{lesson_id}}/download
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
}

docs {
  A private lesson download uses the same current subject/account-alias visibility check as lesson detail.
}
