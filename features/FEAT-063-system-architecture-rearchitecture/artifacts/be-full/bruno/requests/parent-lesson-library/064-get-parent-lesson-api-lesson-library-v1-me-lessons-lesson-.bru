meta {
  name: 064 [READ ONLY] Get Parent Lesson
  type: http
  seq: 64
}

get {
  url: {{baseUrl}}/api/lesson-library/v1/me/lessons/{{lesson_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
}

docs {
  A private lesson is readable when its direct or group share is currently visible to this active Parent subject/account alias.
}
