meta {
  name: 621 [DRAFT-V4B] [LOCAL / TEST ONLY] Teacher lists class roster page two using cursor
  type: http
  seq: 621
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles?limit=2&cursor={{phase_b_roster_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ManagedProfileListV1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.be.at.most(2);
    expect(body).to.have.property("next_cursor");
    expect(body.next_cursor === null || typeof body.next_cursor === "string").to.equal(true);
    expect(body.active_profile_count).to.be.a("number");
  });
}

