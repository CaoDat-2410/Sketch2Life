meta {
  name: 669 [DRAFT-V4B] [LOCAL / TEST ONLY] Parent GET support needs with test key source
  type: http
  seq: 669
}

get {
  url: {{baseUrl}}/v1/parent/profiles/{{parent_profile_id}}/support-needs
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (typeof body.revision === "number") {
    bru.setVar("phase_b_parent_sn_revision", String(body.revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentSupportNeedsV1");
    expect(body.profile_id).to.equal(bru.getVar("parent_profile_id"));
    expect(body.revision).to.be.a("number");
    expect(body.revision).to.be.at.least(0);
    expect(body).to.have.property("category");
    expect(body).to.have.property("note");
    if (body.revision === 0) {
      expect(body.category).to.equal(null);
      expect(body.note).to.equal(null);
    }
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: test SupportNeedsRuntime.crypto configured on backend (no key source exists in production default); saves phase_b_parent_sn_revision for 670
  Expected: 200 / ParentSupportNeedsV1 (Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_profiles.py:545-573, backend/src/sketch2life/contracts/schemas/parent_profiles.py:140-147
}
