meta {
  name: 676 [DRAFT-V4B] [LOCAL / TEST ONLY] Teacher PUT support needs with guard and key fixture
  type: http
  seq: 676
}

put {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/seed-ch-a-1-1/support-needs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{phase_b_be1_sn_expected_revision}},
    "category": "pacing",
    "note": "Synthetic non-clinical preference"
  }
}

script:pre-request {
  const rev = Number(bru.getVar("phase_b_be1_sn_revision") || "0");
  bru.setVar("phase_b_be1_sn_expected_revision", String(rev));
}

script:post-response {
  const body = res.getBody();
  if (typeof body.revision === "number") {
    bru.setVar("phase_b_be1_sn_revision", String(body.revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("Be1SupportNeedsWriteV1");
    expect(body.child_id).to.equal("seed-ch-a-1-1");
    expect(body.revision).to.equal(Number(bru.getVar("phase_b_be1_sn_expected_revision")) + 1);
    expect(body).to.not.have.property("category");
    expect(body).to.not.have.property("note");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: needs-fixture: test SupportNeedsRuntime configured with crypto and teacher_guard granting permission and effective consent for seed-ch-a-1-1 (run 675 first to read phase_b_be1_sn_revision)
  Expected: 200 / Be1SupportNeedsWriteV1 (revision only, no values echoed, Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:2522-2648, backend/src/sketch2life/contracts/schemas/be1_runtime.py:555-601
}
