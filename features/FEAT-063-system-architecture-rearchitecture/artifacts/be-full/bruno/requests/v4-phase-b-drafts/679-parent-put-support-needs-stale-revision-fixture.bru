meta {
  name: 679 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject Parent support needs PUT with stale expected_revision
  type: http
  seq: 679
}

put {
  url: {{baseUrl}}/v1/parent/profiles/{{parent_profile_id}}/support-needs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": 0,
    "category": "pacing",
    "note": "Synthetic non-clinical preference"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(Number(bru.getVar("phase_b_parent_sn_revision")));
    expect(JSON.stringify(body)).to.not.include("Synthetic non-clinical preference");
  });
}

docs {
