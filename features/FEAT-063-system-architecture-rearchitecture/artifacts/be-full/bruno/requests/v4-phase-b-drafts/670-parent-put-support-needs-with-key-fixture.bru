meta {
  name: 670 [DRAFT-V4B] [LOCAL / TEST ONLY] Parent PUT support needs with test key source
  type: http
  seq: 670
}

put {
  url: {{baseUrl}}/v1/parent/profiles/{{parent_profile_id}}/support-needs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": {{phase_b_parent_sn_expected_revision}},
    "category": "pacing",
    "note": "Synthetic non-clinical preference"
  }
}

script:pre-request {
  const rev = Number(bru.getVar("phase_b_parent_sn_revision") || "0");
  bru.setVar("phase_b_parent_sn_expected_revision", String(rev));
}

script:post-response {
  const body = res.getBody();
  if (typeof body.revision === "number") {
    bru.setVar("phase_b_parent_sn_revision", String(body.revision));
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getHeader("Cache-Control")).to.equal("private, no-store");
    const body = res.getBody();
    expect(body.contract).to.equal("ParentSupportNeedsWriteV1");
    expect(body.profile_id).to.equal(bru.getVar("parent_profile_id"));
    expect(body.revision).to.equal(Number(bru.getVar("phase_b_parent_sn_expected_revision")) + 1);
    expect(body).to.not.have.property("category");
    expect(body).to.not.have.property("note");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: test SupportNeedsRuntime.crypto configured on backend (run 669 first to read phase_b_parent_sn_revision)
  Expected: 200 / ParentSupportNeedsWriteV1 (revision only, no values echoed, Cache-Control: private, no-store)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_profiles.py:576-630, backend/src/sketch2life/contracts/schemas/parent_profiles.py:113-155
}
