meta {
  name: 643 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject selected_context_entry_ids on Teacher StoryRun
  type: http
  seq: 643
}

post {
  url: {{baseUrl}}/v1/story-runs/{{teacher_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": {{teacher_context_revision}},
    "context_snapshot_sha256": "{{teacher_context_hash}}",
    "confirmed": true,
    "selected_context_entry_ids": [
      "{{phase_b_context_entry_id}}"
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.be.an("array");
    expect(body.field_errors[0].field).to.equal("selected_context_entry_ids");
    expect(body.field_errors[0].code).to.equal("NOT_ALLOWED");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Teacher - set bearerToken to seed-tch-a1 token
  Needs: teacher_run_id from 508, teacher_context_revision and teacher_context_hash from 560, phase_b_context_entry_id from 628
  Expected: 400 / INVALID_REQUEST (selected_context_entry_ids NOT_ALLOWED for Teacher run)
  Source: backend/src/sketch2life/infrastructure/persistence/parent_story_repository.py:1172-1183, backend/src/sketch2life/interfaces/http/app.py:210-239
}
