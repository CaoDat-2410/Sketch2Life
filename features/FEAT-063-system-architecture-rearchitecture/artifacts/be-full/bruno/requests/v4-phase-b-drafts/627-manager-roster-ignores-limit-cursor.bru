meta {
  name: 627 [DRAFT-V4B] [LOCAL / TEST ONLY] Manager roster ignores limit and Teacher cursor
  type: http
  seq: 627
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles?limit=1&cursor={{phase_b_roster_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ClassRosterSummaryV1");
    expect(body.class_id).to.equal(bru.getVar("class_id"));
    expect(body.active_profile_count).to.be.a("number");
    expect(body).to.not.have.property("items");
    expect(body).to.not.have.property("next_cursor");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: School Manager - set bearerToken to seed-mgr-a token
  Needs: organization_id=seed-org-a, class_id=seed-org-a-class-1, phase_b_roster_cursor from 620 (valid cursor is accepted and ignored by Manager)
  Expected: 200 / Be1ClassRosterSummaryV1 (count only)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:959-970
}
