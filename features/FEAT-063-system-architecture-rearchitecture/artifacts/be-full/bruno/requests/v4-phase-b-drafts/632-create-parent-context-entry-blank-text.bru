meta {
  name: 632 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject Parent context entry with blank short_text
  type: http
  seq: 632
}

post {
  url: {{baseUrl}}/v1/parent/profiles/{{parent_profile_id}}/context-entries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "entry_kind": "OBSERVATION",
    "short_text": "   ",
    "source_kind": "PARENT_NOTE"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "short_text", code: "EMPTY" });
  });
}

