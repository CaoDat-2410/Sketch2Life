meta {
  name: 636 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject Parent context entry list limit above 100
  type: http
  seq: 636
}

get {
  url: {{baseUrl}}/v1/parent/profiles/{{parent_profile_id}}/context-entries?limit=101
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "limit", code: "OUT_OF_RANGE" });
  });
}

docs {
