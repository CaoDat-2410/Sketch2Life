meta {
  name: 631 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject Parent context entry create without Idempotency-Key
  type: http
  seq: 631
}

post {
  url: {{baseUrl}}/v1/parent/profiles/{{parent_profile_id}}/context-entries
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "entry_kind": "OBSERVATION",
    "short_text": "Likes drawing dinosaurs and stars",
    "source_kind": "PARENT_NOTE"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "Idempotency-Key", code: "REQUIRED" });
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: parent_profile_id (owned ACTIVE profile)
  Expected: 400 / INVALID_REQUEST (Idempotency-Key REQUIRED)
  Source: backend/src/sketch2life/interfaces/http/routers/parent_profiles.py:126-137,503-507
}
