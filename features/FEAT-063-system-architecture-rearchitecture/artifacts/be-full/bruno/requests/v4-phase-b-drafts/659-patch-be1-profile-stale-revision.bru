meta {
  name: 659 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject BE1 profile edit with stale expected_revision
  type: http
  seq: 659
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{created_class_id}}/profiles/{{phase_b_child_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": 1,
    "age_months": 64
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(Number(bru.getVar("phase_b_child_revision_no")));
    expect(res.getHeader("ETag")).to.equal('"' + String(body.current_version) + '"');
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a3 token
  Needs: run after 655 advances phase_b_child_revision_no to >= 2 (sends stale expected_revision 1)
  Expected: 409 / STALE_REVISION (with current_version and ETag)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:2249-2252
}
