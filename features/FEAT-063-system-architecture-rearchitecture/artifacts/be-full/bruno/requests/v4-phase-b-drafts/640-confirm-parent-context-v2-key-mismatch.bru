meta {
  name: 640 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject V2 context confirmation when Idempotency-Key selection differs
  type: http
  seq: 640
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_v2_context_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_b_confirm_context_key}}
}

body:json {
  {
    "expected_context_revision": {{phase_b_confirm_context_expected_revision}},
    "context_snapshot_sha256": "{{phase_b_confirm_context_expected_hash}}",
    "confirmed": true,
    "selected_context_entry_ids": []
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

docs {
