meta {
  name: 678 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject Teacher support needs PUT with stale expected_revision
  type: http
  seq: 678
}

put {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/seed-ch-a-1-1/support-needs
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": 0,
    "category": "pacing",
    "note": "Synthetic non-clinical preference"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("STALE_REVISION");
    expect(body.current_version).to.equal(Number(bru.getVar("phase_b_be1_sn_revision")));
    expect(JSON.stringify(body)).to.not.include("Synthetic non-clinical preference");
  });
}

docs {
