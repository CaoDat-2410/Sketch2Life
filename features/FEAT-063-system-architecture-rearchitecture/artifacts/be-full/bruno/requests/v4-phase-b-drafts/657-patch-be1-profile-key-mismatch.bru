meta {
  name: 657 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject BE1 profile edit when Idempotency-Key body differs
  type: http
  seq: 657
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{created_class_id}}/profiles/{{phase_b_child_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_b_be1_edit_key}}
}

body:json {
  {
    "expected_revision": {{phase_b_be1_edit_expected_revision}},
    "display_name": "Synthetic Phase B different",
    "age_months": 62,
    "structured_interests": [
      "drawing",
      "dinosaurs"
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}

