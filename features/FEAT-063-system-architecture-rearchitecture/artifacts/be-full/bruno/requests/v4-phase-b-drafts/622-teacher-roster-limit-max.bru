meta {
  name: 622 [DRAFT-V4B] [LOCAL / TEST ONLY] Teacher lists class roster with max limit 100
  type: http
  seq: 622
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles?limit=100
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ManagedProfileListV1");
    expect(body.items).to.be.an("array");
    expect(body.next_cursor).to.equal(null);
    expect(body.active_profile_count).to.be.a("number");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: organization_id=seed-org-a, class_id=seed-org-a-class-1 (5 seeded profiles fit on one page, so next_cursor is null)
  Expected: 200 / Be1ManagedProfileListV1 (limit=100, next_cursor null)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:947-1010, backend/src/sketch2life/interfaces/http/api_conventions.py:59-61
}
