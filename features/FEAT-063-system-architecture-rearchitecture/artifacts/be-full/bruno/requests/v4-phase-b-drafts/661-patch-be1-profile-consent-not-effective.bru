meta {
  name: 661 [DRAFT-V4B] [LOCAL / TEST ONLY] Refuse BE1 profile edit when consent is not effective
  type: http
  seq: 661
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/{{unconsented_child_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_revision": 1,
    "age_months": 62
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("CONSENT_NOT_EFFECTIVE");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
