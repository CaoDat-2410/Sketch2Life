meta {
  name: 650 [DRAFT-V4B] [LOCAL / TEST ONLY] Hide BE1 profile revisions from unassigned Teacher
  type: http
  seq: 650
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/seed-ch-a-1-1/revisions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("RESOURCE_NOT_FOUND");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Unassigned Teacher - set bearerToken to seed-tch-a2 (assigned to class 2) or seed-tch-b (foreign org) token
  Needs: organization_id=seed-org-a, class_id=seed-org-a-class-1, seed-ch-a-1-1
  Expected: 404 / RESOURCE_NOT_FOUND
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:1909-1929,2047
}
