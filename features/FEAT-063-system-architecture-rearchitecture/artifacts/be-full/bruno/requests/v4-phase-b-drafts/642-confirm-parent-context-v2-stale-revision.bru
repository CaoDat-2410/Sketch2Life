meta {
  name: 642 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject V2 context confirmation with stale revision
  type: http
  seq: 642
}

post {
  url: {{baseUrl}}/v1/story-runs/{{parent_v2_context_run_id}}/context-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
}

body:json {
  {
    "expected_context_revision": 999999,
    "context_snapshot_sha256": "{{parent_v2_context_hash}}",
    "confirmed": true,
    "selected_context_entry_ids": [
      "{{phase_b_context_entry_id}}"
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("STALE_REVISION");
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Parent - set bearerToken to seed-parent-p1 token
  Needs: needs-fixture: unconfirmed parent_v2_context_run_id (run before 638) and phase_b_context_entry_id from 628
  Expected: 409 / STALE_REVISION (note confirm_context raises STALE_REVISION without current_version)
