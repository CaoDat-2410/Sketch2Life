meta {
  name: 625 [DRAFT-V4B] [LOCAL / TEST ONLY] Reject class roster cursor from another class scope
  type: http
  seq: 625
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/seed-org-a-class-3/profiles?cursor={{phase_b_roster_cursor}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.code).to.equal("INVALID_REQUEST");
    expect(body.field_errors).to.deep.include({ field: "cursor", code: "INVALID_FORMAT" });
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token (assigned to both seed-org-a-class-1 and seed-org-a-class-3)
  Needs: phase_b_roster_cursor captured from seed-org-a-class-1 in 620
  Expected: 400 / INVALID_REQUEST (cursor INVALID_FORMAT because _ROSTER_CURSOR_SCOPE binds organization_id and class_id)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:124,975-977, backend/src/sketch2life/interfaces/http/api_conventions.py:103-104
}
