meta {
  name: 656 [DRAFT-V4B] [LOCAL / TEST ONLY] Replay Teacher BE1 profile edit
  type: http
  seq: 656
}

patch {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{created_class_id}}/profiles/{{phase_b_child_id}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{phase_b_be1_edit_key}}
}

body:json {
  {
    "expected_revision": {{phase_b_be1_edit_expected_revision}},
    "display_name": "Synthetic Phase B edited",
    "age_months": 62,
    "structured_interests": [
      "drawing",
      "dinosaurs"
    ]
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ProfileEditResultV1");
    expect(body.revision_no).to.equal(Number(bru.getVar("phase_b_child_revision_no")));
    expect(res.getHeader("ETag")).to.equal('"' + String(body.revision_no) + '"');
  });
}

