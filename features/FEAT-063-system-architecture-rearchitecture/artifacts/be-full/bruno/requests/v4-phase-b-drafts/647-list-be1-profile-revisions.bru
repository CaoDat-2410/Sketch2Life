meta {
  name: 647 [DRAFT-V4B] [LOCAL / TEST ONLY] Teacher lists BE1 profile revisions
  type: http
  seq: 647
}

get {
  url: {{baseUrl}}/api/be1/v1/organizations/{{organization_id}}/classes/{{class_id}}/profiles/seed-ch-a-1-1/revisions?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

script:post-response {
  const body = res.getBody();
  if (Array.isArray(body.items) && body.items.length > 0) {
    bru.setVar("phase_b_profile_revision_id", body.items[0].profile_revision_id);
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.contract).to.equal("Be1ProfileRevisionPageV1");
    expect(body.items).to.be.an("array");
    expect(body.items.length).to.be.at.least(1);
    const head = body.items[0];
    expect(head.contract).to.equal("Be1ProfileRevisionV1");
    expect(head.child_id).to.equal("seed-ch-a-1-1");
    expect(head.profile_revision_id).to.be.a("string");
    expect(head.revision_no).to.be.at.least(1);
    expect(head.display_name).to.be.a("string");
    expect(head.age_months).to.be.a("number");
    expect(head.age_band.band_version).to.equal(1);
    expect(["AGE_36_71", "AGE_72_107", "AGE_108_120"]).to.include(head.age_band.band_code);
    expect(head.structured_interests).to.be.an("array");
    expect(head.revision_hash).to.match(/^[0-9a-f]{64}$/);
    expect(head.created_at).to.be.a("string");
    expect(head).to.not.have.property("authored_by");
    expect(body).to.have.property("next_cursor");
    expect(body.next_cursor === null || typeof body.next_cursor === "string").to.equal(true);
  });
}

docs {
  DRAFT: written from the Phase B code at 134561f4; not yet run against a live backend.
  Role: Assigned Teacher - set bearerToken to seed-tch-a1 token
  Needs: organization_id=seed-org-a, class_id=seed-org-a-class-1, seeded synthetic profile seed-ch-a-1-1; saves phase_b_profile_revision_id for 652 and 654
  Expected: 200 / Be1ProfileRevisionPageV1 (newest revision first, no authored_by)
  Source: backend/src/sketch2life/interfaces/http/routers/be1_registry.py:2029-2088, backend/src/sketch2life/contracts/schemas/be1_runtime.py:521-545
}
