meta {
  name: 530 [LOCAL / TEST ONLY] Confirm class projection for completed run
  type: http
  seq: 530
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/projection-confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: {{occurrence_etag}}
}

body:json {
  {
    "run_id": "{{completed_run_id}}",
    "generation_id": "{{completed_generation_id}}",
    "audience": "CLASS",
    "use": "CLASS_PROJECTION"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_STATE_TRANSITION");
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: occurrence_id, occurrence_etag (refreshed by a GET of the occurrence right before 530), completed_run_id and completed_generation_id from 526 (confirm before Complete; a completed run can no longer be projected)
  Expected: 409 / INVALID_STATE_TRANSITION
  Source: backend/tests/integration/lesson_occurrences/test_projection_postgres.py, backend/tests/contract/test_projection_routes.py
}
