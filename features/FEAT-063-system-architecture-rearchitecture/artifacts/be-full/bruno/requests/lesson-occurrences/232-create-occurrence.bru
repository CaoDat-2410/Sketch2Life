meta {
  name: 232 [LOCAL / TEST ONLY] Create lesson occurrence
  type: http
  seq: 232
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{occurrence_create_key}}
}

body:json {
  {
    "class_id": "seed-org-a-class-1",
    "title": "Lesson for the paper kite",
    "scheduled_date": "2026-11-21",
    "lesson_version_ref": null
  }
}

script:post-response {
  bru.setVar("occurrence_id", res.getBody().occurrence_id);
  bru.setVar("occurrence_etag", res.getHeader("ETag"));
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().contract).to.equal("LessonOccurrenceV1");
    expect(res.getBody().state).to.equal("DRAFT");
  });
}
