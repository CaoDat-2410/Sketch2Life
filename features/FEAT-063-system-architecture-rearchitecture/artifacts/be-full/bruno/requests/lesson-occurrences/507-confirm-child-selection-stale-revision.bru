meta {
  name: 507 [LOCAL / TEST ONLY] Confirm child selection with stale revision
  type: http
  seq: 507
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences/{{occurrence_id}}/child-selections/{{selection_id}}/confirmation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{$guid}}
  If-Match: "1"
}

body:json {
  {
    "expected_selection_sha256": "{{selection_sha256}}"
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("STALE_REVISION");
    expect(typeof res.getBody().current_version === "number").to.equal(true);
  });
}

docs {
  Role: Teacher - set bearerToken to that synthetic account's token
  Needs: occurrence_id, selection_id, selection_sha256; run after 506 (offer was read at revision 1 and is now confirmed at revision 2)
  Expected: 409 / STALE_REVISION
  Source: backend/tests/integration/lesson_occurrences/test_child_selection_postgres.py, backend/tests/contract/test_child_selection_routes.py
}
