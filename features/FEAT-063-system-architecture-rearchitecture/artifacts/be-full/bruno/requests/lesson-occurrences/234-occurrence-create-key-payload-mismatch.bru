meta {
  name: 234 [LOCAL / TEST ONLY] Reuse occurrence key with changed payload
  type: http
  seq: 234
}

post {
  url: {{baseUrl}}/v1/lesson-occurrences
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
  Idempotency-Key: {{occurrence_create_key}}
}

body:json {
  {
    "class_id": "seed-org-a-class-1",
    "title": "Changed title",
    "scheduled_date": "2026-11-21",
    "lesson_version_ref": null
  }
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    expect(res.getBody().code).to.equal("INVALID_IDEMPOTENCY_KEY");
  });
}
