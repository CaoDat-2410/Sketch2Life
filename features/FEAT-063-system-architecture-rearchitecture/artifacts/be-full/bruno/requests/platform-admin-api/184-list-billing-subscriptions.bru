meta {
  name: 184 [PLATFORM ADMIN - READ ONLY] [SANDBOX MAY BE DISABLED] List Billing Subscriptions
  type: http
  seq: 184
}

get {
  url: {{baseUrl}}/api/platform-admin/v1/billing/sandbox/subscriptions?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

docs {
  Expected success status: 200
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 403 BILLING_SANDBOX_DISABLED.
  If-Match required: no.
  Idempotency-Key required: no.
}
