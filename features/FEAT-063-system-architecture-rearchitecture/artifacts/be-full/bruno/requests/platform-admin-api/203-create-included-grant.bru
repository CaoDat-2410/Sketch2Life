meta {
  name: 203 [PLATFORM ADMIN - STATE CHANGE - SYNTHETIC ONLY] Create Included Grant
  type: http
  seq: 203
}

post {
  url: {{baseUrl}}/api/platform-admin/v1/billing/sandbox/included-grants
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
  Idempotency-Key: REPLACE_WITH_SYNTHETIC_VALUE
}

body:json {
  {
    "owner_kind": "ORGANIZATION",
    "owner_ref": "{{organization_id}}",
    "units": 10
  }
}

docs {
  Expected success status: 201
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 403 BILLING_SANDBOX_DISABLED; 404 RESOURCE_NOT_FOUND; 400 INVALID_REQUEST.
  If-Match required: no.
  Idempotency-Key required: yes.
}
