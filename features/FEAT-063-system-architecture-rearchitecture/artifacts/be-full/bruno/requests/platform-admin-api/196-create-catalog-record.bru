meta {
  name: 196 [PLATFORM ADMIN - STATE CHANGE - SYNTHETIC ONLY] Create Catalog Record
  type: http
  seq: 196
}

post {
  url: {{baseUrl}}/api/platform-admin/v1/catalog
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
  Idempotency-Key: REPLACE_WITH_SYNTHETIC_VALUE
}

body:json {
  {
    "activity": {
      "title": "Synthetic catalog activity",
      "objective": "Notice the shape.",
      "instructions_text": "Observe the drawing.",
      "activity_kind": "indoor"
    },
    "age_band": "36-71",
    "age_band_version": 1
  }
}

docs {
  Expected success status: 201
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 400 INVALID_REQUEST; 400 INVALID_IDEMPOTENCY_KEY.
  If-Match required: no.
  Idempotency-Key required: yes.
}
