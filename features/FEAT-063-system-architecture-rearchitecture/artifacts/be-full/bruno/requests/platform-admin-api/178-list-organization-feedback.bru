meta {
  name: 178 [PLATFORM ADMIN - READ ONLY] List Organization Feedback
  type: http
  seq: 178
}

get {
  url: {{baseUrl}}/api/platform-admin/v1/organizations/{{platform_organization_id}}/feedback?limit=25
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

docs {
  Expected success status: 200
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 404 RESOURCE_NOT_FOUND.
  If-Match required: no.
  Idempotency-Key required: no.
}
