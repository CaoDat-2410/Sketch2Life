meta {
  name: 183 [PLATFORM ADMIN - READ ONLY] [SANDBOX MAY BE DISABLED] Get Billing Quota
  type: http
  seq: 183
}

get {
  url: {{baseUrl}}/api/platform-admin/v1/billing/sandbox/quota?owner_kind=ORGANIZATION&owner_ref={{organization_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

docs {
  Expected success status: 200
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 403 BILLING_SANDBOX_DISABLED; 404 RESOURCE_NOT_FOUND.
  If-Match required: no.
  Idempotency-Key required: no.
}
