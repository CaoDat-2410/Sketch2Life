meta {
  name: 206 [PLATFORM ADMIN - STATE CHANGE - SYNTHETIC ONLY] Quote New Subscription
  type: http
  seq: 206
}

post {
  url: {{baseUrl}}/api/platform-admin/v1/billing/sandbox/subscriptions/quote
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
  Idempotency-Key: REPLACE_WITH_SYNTHETIC_VALUE
}

body:json {
  {
    "mode": "START",
    "organization_ref": "{{organization_id}}",
    "price_id": "REPLACE_WITH_SYNTHETIC_PRICE_ID",
    "addon_slots": 0
  }
}

docs {
  Expected success status: 201
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 403 BILLING_SANDBOX_DISABLED; 404 RESOURCE_NOT_FOUND; 400 INVALID_REQUEST.
  If-Match required: no.
  Idempotency-Key required: yes.
}
