meta {
  name: 163 [PLATFORM ADMIN - READ ONLY] Get Account Permissions
  type: http
  seq: 163
}

get {
  url: {{baseUrl}}/api/platform-admin/v1/accounts/{{platform_account_id}}/permissions
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

docs {
  Expected success status: 200
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 404 RESOURCE_NOT_FOUND.
  If-Match required: no.
  Idempotency-Key required: no.
}
