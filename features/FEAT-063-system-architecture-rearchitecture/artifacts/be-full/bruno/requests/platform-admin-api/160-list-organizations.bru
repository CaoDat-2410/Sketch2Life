meta {
  name: 160 [PLATFORM ADMIN - READ ONLY] List Organizations
  type: http
  seq: 160
}

get {
  url: {{baseUrl}}/api/platform-admin/v1/organizations?limit=25&cursor={{cursor}}&search=Synthetic%20example&state=active
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
}

docs {
  Expected success status: 200
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 400 INVALID_REQUEST; 422 INVALID_CURSOR.
  If-Match required: no.
  Idempotency-Key required: no.
}
