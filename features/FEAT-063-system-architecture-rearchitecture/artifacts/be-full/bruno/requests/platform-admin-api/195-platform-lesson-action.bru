meta {
  name: 195 [PLATFORM ADMIN - STATE CHANGE - SYNTHETIC ONLY] Platform Lesson Action
  type: http
  seq: 195
}

post {
  url: {{baseUrl}}/api/platform-admin/v1/lessons/{{platform_lesson_id}}/actions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  Content-Type: application/json
  X-Request-ID: REPLACE_WITH_SYNTHETIC_VALUE
  If-Match: "REPLACE_WITH_REVISION"
  Idempotency-Key: REPLACE_WITH_SYNTHETIC_VALUE
}

body:json {
  {
    "action": "submit",
    "version_id": "{{version_id}}",
    "content_hash": "{{content_hash}}"
  }
}

docs {
  Expected success status: 200
  Main error cases: 401 AUTH_REQUIRED; 403 ACTION_NOT_ALLOWED; 400 INVALID_REQUEST; 404 RESOURCE_NOT_FOUND; 409 STALE_REVISION; 422 INVALID_REVISION; 428 PRECONDITION_REQUIRED; 409 CONTENT_HASH_MISMATCH; 403 CONTENT_PERMISSION_REQUIRED.
  If-Match required: yes.
  Idempotency-Key required: yes.
}
