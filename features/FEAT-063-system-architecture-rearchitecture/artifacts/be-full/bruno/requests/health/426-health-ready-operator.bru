meta {
  name: 426 [LOCAL / TEST ONLY] Readiness probe with operator credential
  type: http
  seq: 426
}

get {
  url: {{baseUrl}}/health/ready
  body: none
  auth: bearer
}

auth:bearer {
  token: {{opsProbeToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect([200, 503]).to.include(res.getStatus());
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    if (res.getStatus() === 200) expect(res.getBody().checks.database).to.equal("up");
    if (res.getStatus() === 503) expect(res.getBody()).to.deep.equal({status: "not_ready", checks: {database: "down"}});
  });
}
