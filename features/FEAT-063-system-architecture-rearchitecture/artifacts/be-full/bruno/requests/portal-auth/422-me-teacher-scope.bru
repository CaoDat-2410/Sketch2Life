meta {
  name: 422 [LOCAL / TEST ONLY] Current Teacher scope
  type: http
  seq: 422
}

get {
  url: {{baseUrl}}/api/auth/v1/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
}

tests {
  test("assert response contract", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("X-Request-ID")).to.equal(bru.getVar("request_id"));
    const body = res.getBody();
    expect(body.role).to.equal("teacher");
    expect(body.state).to.equal("active");
    expect(body.scope.accounts.managed).to.equal("NONE");
    expect(body.scope.permissions).to.deep.equal([]);
    expect(body.scope.truncated).to.equal(false);
    expect(body.scope.organizations.some(item => item.organization_id === "seed-org-a")).to.equal(true);
    expect(body.scope.classes.some(item => item.class_id === "seed-org-a-class-1" && item.role === "teacher")).to.equal(true);
  });
}
