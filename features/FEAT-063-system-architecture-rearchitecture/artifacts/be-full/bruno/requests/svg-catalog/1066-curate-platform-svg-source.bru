meta {
  name: 1066 Curate platform SVG source
  type: http
  seq: 1066
}

post {
  url: {{baseUrl}}/api/svg-catalog/v1/platform/assets/{{catalog_entry_id}}/curation
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "contract": "SvgCurationRequestV1",
    "source_sha256": "{{svg_source_sha256}}",
    "decision": "APPROVE",
    "grouping_allowed": false
  }
}

docs {
  Role: platform_admin, not the source author.
  Needs: catalog_entry_id and current source_sha256 from a platform asset.
  Expected: 200 OK / SvgReviewReceiptV1.
  Source: backend/src/sketch2life/interfaces/http/routers/svg_catalog.py, backend/src/sketch2life/contracts/schemas/svg_engine.py
}