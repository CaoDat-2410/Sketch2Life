meta {
  name: 1064 Review organization SVG guide
  type: http
  seq: 1064
}

post {
  url: {{baseUrl}}/api/svg-catalog/v1/organizations/{{organization_id}}/assets/{{catalog_entry_id}}/guide-revisions/{{guide_revision_id}}/educator-reviews
  body: json
  auth: bearer
}

auth:bearer {
  token: {{bearerToken}}
}

headers {
  Accept: application/json
  X-Request-ID: {{request_id}}
  Content-Type: application/json
}

body:json {
  {
    "contract": "SvgGuideReviewRequestV1",
    "source_sha256": "{{svg_source_sha256}}",
    "guide_sha256": "{{svg_guide_sha256}}",
    "decision": "APPROVE"
  }
}

docs {
  Role: Teacher assigned to organization_id, not the guide author.
  Needs: catalog_entry_id, guide_revision_id, and current source_sha256/guide_sha256.
  Expected: 200 OK / SvgReviewReceiptV1.
  Source: backend/src/sketch2life/interfaces/http/routers/svg_catalog.py, backend/src/sketch2life/contracts/schemas/svg_engine.py
}