    "check:security": "python tools/validate_repository_security.py",
    "check:team": "python tools/validate_team_allocation.py",
    "check:montessori": "python tools/validate_montessori_domain.py",
    "check:montessori-golden": "python tools/validate_montessori_golden.py",
    "check:montessori-console": "python tools/validate_montessori_console.py",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
