{
  "name": "sketch2life-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:harness": "python tools/validate_harness.py",
    "check:skeleton": "python tools/validate_skeleton.py",
