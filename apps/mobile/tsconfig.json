{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@bridge/*": ["src/bridge/*"],
      "@features/*": ["src/features/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@shared/*": ["src/shared/*"]
    },
    "strict": true
  },
  "include": ["index.js", "src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.ts"]
}
