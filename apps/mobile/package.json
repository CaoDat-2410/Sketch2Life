{
  "name": "@sketch2life/mobile",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:clean": "node scripts/run-gradle.mjs clean",
    "android:apk:debug": "node scripts/run-gradle.mjs assembleDebug",
    "android:apk:release": "node scripts/run-gradle.mjs assembleRelease",
    "android:aab:release": "node scripts/run-gradle.mjs bundleRelease",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint .",
    "android:dev": "expo run:android",
    "start:clear": "expo start --dev-client --clear"
  },
  "dependencies": {
    "@sketch2life/art-renderer": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.18",
    "react": "^19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/runtime": "^7.25.0",
    "@react-native/codegen": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/gradle-plugin": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "prettier": "^3.0.0",
    "typescript": "^6.0.3"
  },
  "main": "index.js"
}
